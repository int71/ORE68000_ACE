//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//
//		user
//

UINT16					ui16iX=0;
UINT16					ui16iY=48;
UINT16					ui16iPattern0=0;
UINT16					ui16iPattern1=0;

VOID					USER_stNew(VOID)noexcept{
	static constexpr UINT16	stcui16csource[]={
		0x80c0,0x80c0,0x80c0,0x80c0,0x90c1,0x90c1,0x90c1,0x90c1,0x80c2,0x80c2,0x80c2,0x80c2,0x90c3,0x90c3,0x90c3,0x90c3,
		0x80c4,0x80c5,0x80c5,0x80c5,0x80c5,0x80c5,0x80c5,0x80c6,0x90c4,0x90c5,0x90c5,0x90c5,0x90c5,0x90c5,0x90c5,0x90c6
	};

	FAMILYBASIC::stNew();
	FAMILYBASIC::stSetPalette(0,0x3f,0x36,0x16,0x02);
	FAMILYBASIC::stSetPalette(1,0x3f,0x27,0x30,0x19);
	FAMILYBASIC::stSetPalette(2,0x3f,0x35,0x25,0x17);
	FAMILYBASIC::stSetPalette(3,0x3f,0x30,0x27,0x16);
	FAMILYBASIC::stSetPalette(8,0x3f,0x30,0x21,0x02);
	FAMILYBASIC::stSetPalette(9,0x3f,0x30,0x27,0x18);
	FAMILYBASIC::stWriteBG0({0,8},stcui16csource,UINT16(SIZEOF(stcui16csource)));
	VIDEO_DRIVER::VRAM_TEXT_stWrite(0,0,"グラフィック画面でのテキスト表示",1);
	DEBUG::stWriteLine("仮想シリアル出力");
	return;
}

VOID					USER_stDelete(VOID)noexcept{
	FAMILYBASIC::stDelete();
	return;
}

VOID					USER_stMain(VOID)noexcept{
	FAMILYBASIC::stWriteSprite(0,((ui16iX>>1)+ 0)&0xff,ui16iY+ 0,0x2000|((ui16iPattern0>>1)+0x1c),0x5100);
	FAMILYBASIC::stWriteSprite(1,((ui16iX>>1)+32)&0xff,ui16iY+ 0,0x3000|((ui16iPattern1>>1)+0x70),0x5100);
	--ui16iX;
	++ui16iPattern0;
	if(ui16iPattern0==0x18)ui16iPattern0=0;
	ui16iPattern1+=2;
	if(ui16iPattern1==0x10)ui16iPattern1=0;
	return;
}
