	CUINT16					acui16ccolor[]={
		stacui16ccolornes[cui8inescolor0],
		stacui16ccolornes[cui8inescolor1],
		stacui16ccolornes[cui8inescolor2],
		stacui16ccolornes[cui8inescolor3]
