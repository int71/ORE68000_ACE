VOID					USER_stDelete(VOID)noexcept{
	return;
}

VOID					USER_stMain(VOID)noexcept{
	using					IDREGISTERW=VIDEO_DRIVER::IDREGISTERW;
	using					IDKEY=m68k::hid::KEYBOARD::IDKEY;

	USER_stSetSprite(0,128,ui16iY+ 0,0x0000|((ui16iPattern0>>1)+0x00),0x5100);
	USER_stSetSprite(1,160,ui16iY+ 0,0x2000|((ui16iPattern0>>1)+0x1c),0x5100);
	if(OS::DEVICE_KEYBOARD_stui16Read(IDKEY::Space>>4)&(1<<(IDKEY::Space&0xf)))++ui16iX;
	else --ui16iX;
	++ui16iPattern0;
	if(ui16iPattern0==0x18)ui16iPattern0=0;
	ui16iPattern1+=2;
	if(ui16iPattern1==0x10)ui16iPattern1=0;
	VIDEO_DRIVER::stWrite(
		IDREGISTERW::BG1OffsetX,
		0x2000+(ui16iX&0xff)
	);
	return;
}

constexpr UINT16		USER_stui16cGetColor(
	CDWORD					cdwvalue
)noexcept{
	return common::ui16cGetColor(cdwvalue);
}

