		USER_stui16cGetColor(0xffffff),USER_stui16cGetColor(0x65aaff),USER_stui16cGetColor(0x8c96ff),USER_stui16cGetColor(0xb983ff),USER_stui16cGetColor(0xdd6fff),USER_stui16cGetColor(0xea6fbd),USER_stui16cGetColor(0xeb8466),USER_stui16cGetColor(0xdca21f),USER_stui16cGetColor(0xbab403),USER_stui16cGetColor(0x7ecb07),USER_stui16cGetColor(0x54d33e),USER_stui16cGetColor(0x3cd284),USER_stui16cGetColor(0x3ec7cc),USER_stui16cGetColor(0x4b4b4b),USER_stui16cGetColor(0x000000),USER_stui16cGetColor(0x000000),
		USER_stui16cGetColor(0xffffff),USER_stui16cGetColor(0xbde2ff),USER_stui16cGetColor(0xcecfff),USER_stui16cGetColor(0xe6c2ff),USER_stui16cGetColor(0xf6bcff),USER_stui16cGetColor(0xf9c2ed),USER_stui16cGetColor(0xfacfc6),USER_stui16cGetColor(0xf8deac),USER_stui16cGetColor(0xeee9a1),USER_stui16cGetColor(0xd0f59f),USER_stui16cGetColor(0xbbf5af),USER_stui16cGetColor(0xb3f5cd),USER_stui16cGetColor(0xb9edf0),USER_stui16cGetColor(0xb9b9b9),USER_stui16cGetColor(0x000000),USER_stui16cGetColor(0x000000)
