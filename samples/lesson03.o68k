static constexpr UINT8	stacui8cSE00[]=__O68K_MAKESEQUENCE(R"(
[
	"#CHANNEL=PCM3",
	#=============	   0
	"#SPEED=4",
	" 5B ,PG=1,PN=0,PM=0,VL=255,VM=255",
	"  G         ",
	"#SPEED=1",
	"-           ",
];
)");

UINT16					ui16iX=0;
UINT16					ui16iY=48;
UINT16					ui16iPattern=0;
OFWBOOL					eKeyDownPrevious=FALSE;

VOID					USER_New(VOID)noexcept{
	FAMILYBASIC::stNew();

	FAMILYBASIC::PALETTE_stWriteSet(0,1);
	FAMILYBASIC::BG0_stPrint({0,0},"LESSON 03:SOUND(1)",0);
	FAMILYBASIC::BG1_stFill({0,8},{128,4},0xc3,1);
	FAMILYBASIC::BG1_stFill({0,0},{1,8},0xd2,1);
	FAMILYBASIC::BGM_stPlay(stacui8cBGM00);
	return;
}

VOID					USER_Delete(VOID)noexcept{
	FAMILYBASIC::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	using					IDREGISTERW=VIDEO_DRIVER::IDREGISTERW;
	CAUTO					cekeydown=FAMILYBASIC::KEY_steIsDown(FAMILYBASIC::IDKEY::Space);

	FAMILYBASIC::SPRITE_stWrite16(0,VECTOR2(128,ui16iY+ 0),(ui16iPattern>>1)+0x00,0);
	--ui16iX;
	++ui16iPattern;
	if(ui16iPattern==0x18)ui16iPattern=0;
	VIDEO_DRIVER::stWrite(
		IDREGISTERW::BG1OffsetX,
		0x2000+(ui16iX&0xff)
	);
	if(cekeydown!=eKeyDownPrevious){
		eKeyDownPrevious=cekeydown;
		if(cekeydown){
			FAMILYBASIC::SE0_stPlay(stacui8cSE00);
			FAMILYBASIC::PALETTE_stWrite(0,0x30,0x36,0x16,0x02);
			return;
		}
	}
	FAMILYBASIC::PALETTE_stWrite(0,0x3f,0x36,0x16,0x02);
	return;
}
