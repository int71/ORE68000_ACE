//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//
//		user
//

VOID					USER_New(VOID)noexcept{
	FAMILYBASIC::stNew();
	FAMILYBASIC::PALETTE_stWriteSet(0,1);
	FAMILYBASIC::BG0_stPrint({0,0},"LESSON 04:INPUT(1)",0);
	FAMILYBASIC::BG0_stPrint({4,4},
		" U\n"
		"L R     B A\n"
		" D\n",
		0
	);
	return;
}

VOID					USER_Delete(VOID)noexcept{
	FAMILYBASIC::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	static constexpr USTR	stacustron[]="\xfe";
	static constexpr USTR	stacustroff[]="\xff";
	CAUTO					cui8ccurrent=FAMILYBASIC::CONTROLLER_stui8cRead(0);

	FAMILYBASIC::BG1_stPrint({5,4},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::Up))!=0)?stacustron:stacustroff,0);
	FAMILYBASIC::BG1_stPrint({4,5},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::Left))!=0)?stacustron:stacustroff,0);
	FAMILYBASIC::BG1_stPrint({6,5},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::Right))!=0)?stacustron:stacustroff,0);
	FAMILYBASIC::BG1_stPrint({12,5},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::B))!=0)?stacustron:stacustroff,0);
	FAMILYBASIC::BG1_stPrint({14,5},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::A))!=0)?stacustron:stacustroff,0);
	FAMILYBASIC::BG1_stPrint({5,6},((cui8ccurrent&(1<<FAMILYBASIC::IDBUTTON::Down))!=0)?stacustron:stacustroff,0);
	return;
}
