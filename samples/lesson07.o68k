//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//
//		class
//

//	GAME
class GAME;
using					CGAME=const GAME;
using					PGAME=GAME*;
using					PCGAME=CGAME*;

//
//		class:GAME
//

class GAME{
public:

	//
	//		const
	//

	//	enum class IDMODE
	//		ゲーム進行の「状態」を示す定数です。
	enum class IDMODE{
		Start,
		Normal,
		GameOver
	};
	//	enum class IDSHOT
	//		ショット(パワーアップ)「状態」を示す定数です。
	enum class IDSHOT{
		UpSingle,
		UpDual,
		UpLeftRight
	};
	//	UINT8					stcui8nDiscardBit
	//		16bit中、6bitを「小数点値」扱いにします。
	static constexpr UINT8	stcui8nDiscardBit=		6;
	//	VECTOR2					stcv2iiMinimum8
	//		8ドット四方のオブジェクトが存在できる座標の最小値です。
	static constexpr AUTO	stcv2iiMinimum8=		VECTOR2(  0-4,  0-4)<<stcui8nDiscardBit;
	//	VECTOR2					stcv2iiMaximum8
	//		8ドット四方のオブジェクトが存在できる座標の最大値です。
	static constexpr AUTO	stcv2iiMaximum8=		VECTOR2(256+4,212+4)<<stcui8nDiscardBit;
	//	VECTOR2					stcv2iiMinimum16
	//		16ドット四方のオブジェクトが存在できる座標の最小値です。
	static constexpr AUTO	stcv2iiMinimum16=		VECTOR2(  0-8,  0-8)<<stcui8nDiscardBit;
	//	VECTOR2					stcv2iiMaximum16
	//		16ドット四方のオブジェクトが存在できる座標の最大値です。
	static constexpr AUTO	stcv2iiMaximum16=		VECTOR2(256+8,212+8)<<stcui8nDiscardBit;
	//	UINT8					CONTROLLER_stcui8nRapid
	//		「コントローラ」ソフトウェア連射の間隔(フレーム数)です。
	static constexpr UINT8	CONTROLLER_stcui8nRapid=	2;
	//	VECTOR2					PLAYER_stcv2iiMinimum
	//		「自機」が移動できる座標の最小値です。
	static constexpr AUTO	PLAYER_stcv2iiMinimum=	VECTOR2(  0+8, 32+8)<<stcui8nDiscardBit;
	//	VECTOR2					PLAYER_stcv2iiMaximum
	//		「自機」が移動できる座標の最大値です。
	static constexpr AUTO	PLAYER_stcv2iiMaximum=	VECTOR2(256-8,212-8)<<stcui8nDiscardBit;
	//	VECTOR2					PLAYER_stcv2inHitHalf_Upper
	//		「自機」当たり判定の大きさの半分です。
	//		当たり判定は整数で行うため、この値は「固定小数点値」ではありません。
	//		その気持ちを「_Upper」に込めています。
	static constexpr AUTO	PLAYER_stcv2inHitHalf_Upper=VECTOR2(3,3);
	//	UINT8					SHOT_stcui8nInstanceMaximum
	//		「1方向当たり」の「ショット最大数」です。
	static constexpr UINT8	SHOT_stcui8nInstanceMaximum=	8;
	//	UINT8					ENEMY_stcui8nInstanceMaximum
	//		「敵最大数」です。
	static constexpr UINT8	ENEMY_stcui8nInstanceMaximum=	64;
	//	UINT16					ENEMYGROUP_stcui16nEntity
	//		1「敵集団」当たりの「敵」数です。
	static constexpr UINT16	ENEMYGROUP_stcui16nEntity=	12;
	//	UINT8					SE0_stacui8cShot
	//		「ショット」音です。
	static constexpr _ORDERED_("SE0-01") UINT8	SE0_stacui8cShot[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 6A ,PT=-4,$PCM_Sqr17L,PN=0,PM=0,VL=224,VM=255",
			"-F  ,PT=-4   ",
		];
	)");
	//	UINT8					SE0_stacui8cHit
	//		耐久力持ち敵に「ショット」を当てた時の音です。
	static constexpr _ORDERED_("SE0-00") UINT8	SE0_stacui8cHit[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 7C ,PT=+8,$PCM_Sqr11L,PN=0,PM=0,VL=240,VM=255",
			"-G# ,PT=+8   ",
		];
	)");
	//	UINT8					SE1_stacui8cCrush
	//		爆発音です。
	//		YM2151B FM音源部のノイズ機能を利用しています。
	static constexpr _ORDERED_("SE1-00") UINT8	SE1_stacui8cCrush[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=FM7",
			#=============	   0
			"#SPEED=1",
			" 3C ,$FM_Noise,PN=0,PM=0,VL=255,VM=255",
			"#SPEED=1",
			"-           ",
		];
	)");

	//
	//		class
	//

	//	SHOT
	class SHOT;
	using					CSHOT=const SHOT;
	using					PSHOT=SHOT*;
	using					PCSHOT=CSHOT*;
	//	ENEMY
	class ENEMY;
	using					CENEMY=const ENEMY;
	using					PENEMY=ENEMY*;
	using					PCENEMY=CENEMY*;

	//
	//		class:SHOT
	//

	class SHOT{
	public:
		//	enum class IDMODE
		//		「ショット種別」を示す定数です。
		//		「生きているかどうか」のフラグを兼ねます。
		enum class IDTYPE:UINT8{
			None,
			Up,
			Left,
			Right
		};
	private:
		//	IDTYPE					idType
		//		「ショット種別」を保持します。
		//		「生きているかどうか」のフラグを兼ねます。
		IDTYPE					idType;
		//	VECTOR2					v2iPosition
		//		「位置」です。
		//		この値は6bit小数点値の「固定小数点値」です。
		VECTOR2					v2iPosition;
		//	VECTOR2					v2iPosition_Upper
		//		整数状態での「位置」です。
		//		当たり判定は整数状態で取るので、キャッシュ的に保持しておきます。
		VECTOR2					v2iPosition_Upper;
		//	VECTOR2					v2dVelocity
		//		「移動速度」です。
		//		この値は6bit小数点値の「固定小数点値」です。
		VECTOR2					v2dVelocity;
	public:
		/*VOID*/				SHOT(VOID)noexcept{}
		/*VOID*/				~SHOT(VOID)noexcept{
			Delete();
		}
		//	VOID					New(VOID)
		//		初期化処理で、プログラム開始後一度だけの実行で十分──
		//		という建前なんですが、現状何もしてません。
		VOID					New(VOID)noexcept{
			return;
		}
		//	VOID					Delete(VOID)
		//		「終了処理」ですが、現状何もする事はありません。
		VOID					Delete(VOID)noexcept{
			return;
		}
		//	OFWBOOL					eIsActive(VOID)
		//		「idType」を生存フラグ解釈して、「生きて」いれば「TRUE」を返します。
		constexpr OFWBOOL		eIsActive(VOID)const noexcept{
			return (idType!=IDTYPE::None);
		}
		//	VOID					Start(const PGAME cpgameowner,const IDTYPE cidtype,CVECTOR2& cv2iposition)
		//		「ショット」出現処理です。
		//		「cpgameowner」が引数として渡っているのは、「自機の方向を調べる」等のサービスを提供するためですが、
		//		現状利用していません。
		VOID					Start(const PGAME cpgameowner,const IDTYPE cidtype,CVECTOR2& cv2iposition)noexcept{
			idType=cidtype;
			switch(idType){
			case IDTYPE::Up:
				v2iPosition=cv2iposition;
				v2dVelocity={
					INT16( 0)<<stcui8nDiscardBit,
					INT16(-8)<<stcui8nDiscardBit
				};
				break;
			case IDTYPE::Left:
				v2iPosition=cv2iposition;
				v2dVelocity={
					INT16(-4)<<stcui8nDiscardBit,
					INT16(-7)<<stcui8nDiscardBit
				};
				break;
			case IDTYPE::Right:
				v2iPosition=cv2iposition;
				v2dVelocity={
					INT16(+4)<<stcui8nDiscardBit,
					INT16(-7)<<stcui8nDiscardBit
				};
				break;
			default:
				break;
			}
			return;
		}
		//	UINT8					ui8nShow(CUINT8 cui8isprite)
		//		「ショット」表示処理です。
		//		スプライト番号「cui8isprite」以降で表示する事を求めています。
		//		「移動処理」と分けているのは、「表示を垂直帰線期間中に確実に完了させる」ためです。
		//		返り値はスプライト枚数の使用実績です。
		UINT8					ui8nShow(CUINT8 cui8isprite)const noexcept{
			switch(idType){
			case IDTYPE::Up:
				FALLTHROUGH;
			case IDTYPE::Left:
				FALLTHROUGH;
			case IDTYPE::Right:
				FAMILYBASIC::SPRITE_stWrite8(cui8isprite,(v2iPosition>>stcui8nDiscardBit)-VECTOR2(4,4),221,3);
				return 1;
			default:
				break;
			}
			return 0;
		}
		//	VOID					Move(const PGAME cpgameowner)
		//		「ショット」移動処理です。
		//		移動の他、画面外脱出判定もここで行います。
		//		「cpgameowner」が引数として渡っているのは、「自機の方向を調べる」等のサービスを提供するためですが、
		//		現状利用していません。
		VOID					Move(const PGAME cpgameowner)noexcept{
			switch(idType){
			case IDTYPE::Up:
				FALLTHROUGH;
			case IDTYPE::Left:
				FALLTHROUGH;
			case IDTYPE::Right:
				v2iPosition+=v2dVelocity;
				if(!steIsInScreen8(v2iPosition))idType=IDTYPE::None;
				else v2iPosition_Upper=v2iPosition>>stcui8nDiscardBit;
				break;
			default:
				break;
			}
			return;
		}
		//	OFWBOOL					eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)
		//		通常当たり判定です。
		//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
		//		当たっていれば「TRUE」を返します。
		OFWBOOL					eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)noexcept{
			switch(idType){
			case IDTYPE::Left:
				FALLTHROUGH;
			case IDTYPE::Right:
				FALLTHROUGH;
			case IDTYPE::Up:
				if(v2iPosition_Upper.eIsHit512(VECTOR2(2,4),cv2iposition_upper,cv2nhithalf_upper)){
					idType=IDTYPE::None;
					return TRUE;
				}
				break;
			default:
				break;
			}
			return FALSE;
		}
		//	OFWBOOL					eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)
		//		耐久力持ち当たり判定です。
		//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
		//		当たっていれば「ui8ndurability」を減算、
		//		さらに「0」に至っていれば「TRUE」を返します。
		OFWBOOL					eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)noexcept{
			if(ui8ndurability)switch(idType){
			case IDTYPE::Left:
				FALLTHROUGH;
			case IDTYPE::Right:
				FALLTHROUGH;
			case IDTYPE::Up:
				if(v2iPosition_Upper.eIsHit512(VECTOR2(2,4),cv2iposition_upper,cv2nhithalf_upper)){
					idType=IDTYPE::None;
					--ui8ndurability;
					if(ui8ndurability==0)return TRUE;
				}
				break;
			default:
				break;
			}
			return FALSE;
		}
	};

	//
	//		class:ENEMY
	//

	class ENEMY{
	public:

		//
		//		const
		//

		//	enum class IDMODE
		//		「敵種別」を示す定数です。
		//		「生きているかどうか」のフラグを兼ねます。
		enum class IDTYPE:UINT8{
			None,					//	「生きて」ません。
			Crushed,				//	当たり判定も何も無い、爆発パターンです。
			NormalWavy,				//	波状移動します。
			NormalStraight,			//	真下に一直線に移動する敵です。
			NormalStraightSide,		//	真下に一直線に移動して、縦座標一致で横移動する敵です。
			NormalBackAttacker,		//	下から出現する「ゾ○ー」的な敵です。
			NormalHighSpeed,		//	自分目掛けて高速移動する小さな敵です。
			NormalFollower,			//	ゆっくり移動する耐久持ちの敵です。
			Bullet					//	敵弾です。
		};

		//
		//		body:ENEMY
		//

	private:
		//	IDTYPE					idType
		//		「敵種別」を保持します。
		//		「生きているかどうか」のフラグを兼ねます。
		IDTYPE					idType;
		//	UINT8					ui8nDurability
		//		「耐久力」です。
		//		耐久力持ちの場合のみ使用します。
		UINT8					ui8nDurability;
		//	VECTOR2					v2iPosition
		//		「位置」です。
		//		この値は6bit小数点値の「固定小数点値」です。
		VECTOR2					v2iPosition;
		//	VECTOR2					v2iPosition_Upper
		//		整数状態での「位置」です。
		//		当たり判定は整数状態で取るので、キャッシュ的に保持しておきます。
		VECTOR2					v2iPosition_Upper;
		//	VECTOR2					v2dVelocity
		//		「移動速度」です。
		//		この値は6bit小数点値の「固定小数点値」です。
		VECTOR2					v2dVelocity;
		//	UINT16					ui16iPattern
		//		「アニメーションカウンター」です。
		UINT16					ui16iPattern;
		//	UINT16					ui16nAimRest
		//		「敵弾」発射タイミングカウンタです。
		//		間隔は「GAME::ENEMY_ui16nAim」になりますが、開始値は乱数で決めるので、
		//		体感的には「バラバラ」と飛んでくるイメージになります。
		UINT16					ui16nAimRest;
	public:
		/*VOID*/				ENEMY(VOID)noexcept{}
		/*VOID*/				~ENEMY(VOID)noexcept{
			Delete();
		}
		//	VOID					New(VOID)
		//		初期化処理で、プログラム開始後一度だけの実行で十分──
		//		という建前なんですが、現状何もしてません。
		VOID					New(VOID)noexcept{
			return;
		}
		//	VOID					Delete(VOID)
		//		「終了処理」ですが、現状何もする事はありません。
		VOID					Delete(VOID)noexcept{
			return;
		}
		//	OFWBOOL					eIsActive(VOID)
		//		「idType」を生存フラグ解釈して、「生きて」いれば「TRUE」を返します。
		constexpr OFWBOOL		eIsActive(VOID)const noexcept{
			return (idType!=IDTYPE::None);
		}
		//	VOID					Start(const PGAME cpgameowner,const IDTYPE cidtype,CVECTOR2& cv2iposition)
		//		「敵」出現処理です。
		//		メイン処理から呼び出される他、「撃ち落とされた際の爆発状態への移行」時にもクラス内から呼び出されます。
		//		「cpgameowner」が引数として渡っているのは、「自機の方向を調べる」等のサービスを提供するためです。
		VOID					Start(const PGAME cpgameowner,const IDTYPE cidtype,CVECTOR2& cv2iposition=VECTOR2::stv2ImmediateZero())noexcept{
			idType=cidtype;
			switch(idType){
			case IDTYPE::Crushed:
				SetPosition(cv2iposition);
				ui16iPattern=0;
				//	出現ついでに音鳴らすんですが、
				//	現状の演奏処理はノイズ使わない想定なので手動で「YM2151B」のレジスタを設定します。
				SOUND_DRIVER::DEVICE_FM_stWrite(SOUND_DRIVER::FM_IDREGISTERW::NoiseDivRatio5,0x80+16);
				FAMILYBASIC::SE1_stPlay(SE1_stacui8cCrush);
				break;
			case IDTYPE::NormalWavy:
				SetPosition(VECTOR2(128,0-8)<<stcui8nDiscardBit);
				v2dVelocity={
					INT16(-3)<<stcui8nDiscardBit,
					INT16(cpgameowner->ENEMY_ui16nSpeed>>1)
				};
				ui16iPattern=0;
				//	敵弾発射のための準備をします。
				AIM_Start(cpgameowner);
				break;
			case IDTYPE::NormalStraight:
				SetPosition(VECTOR2(FAMILYBASIC::stui16GetRandom()&0xff,0-8)<<stcui8nDiscardBit);
				v2dVelocity={
					INT16(0),
					INT16(cpgameowner->ENEMY_ui16nSpeed)
				};
				//	敵弾発射のための準備をします。
				AIM_Start(cpgameowner);
				break;
			case IDTYPE::NormalStraightSide:
				SetPosition(VECTOR2(FAMILYBASIC::stui16GetRandom()&0xff,0-8)<<stcui8nDiscardBit);
				v2dVelocity={
					INT16(0),
					INT16(cpgameowner->ENEMY_ui16nSpeed)
				};
				//	横追跡かどうかの「状態」と解釈します。
				ui16iPattern=0;
				//	敵弾発射のための準備をします。
				AIM_Start(cpgameowner);
				break;
			case IDTYPE::NormalBackAttacker:
				SetPosition(VECTOR2(FAMILYBASIC::stui16GetRandom()&0xff,212+8)<<stcui8nDiscardBit);
				//	基本は「追いかけ」なんですが、まずは上方向に移動させます。
				v2dVelocity={
					INT16(0),
					INT16(-(cpgameowner->ENEMY_ui16nSpeed>>1))
				};
				ui16iPattern=0;
				//	敵弾発射のための準備をします。
				AIM_Start(cpgameowner);
				break;
			case IDTYPE::NormalHighSpeed:
				SetPosition(VECTOR2(FAMILYBASIC::stui16GetRandom()&0xff,0-4)<<stcui8nDiscardBit);
				//	移動方向を「自機」に向けます。
				v2dVelocity=VECTOR2::stv2dGetDirection(cpgameowner->ENEMY_ui8iAim(v2iPosition_Upper),cpgameowner->ENEMY_ui16nSpeed<<1);
				ui16iPattern=0;
				break;
			case IDTYPE::NormalFollower:
				ui8nDurability=6;
				SetPosition(VECTOR2(FAMILYBASIC::stui16GetRandom()&0xff,0-8)<<stcui8nDiscardBit);
				//	基本は「追いかけ」なんですが、まずは下方向に移動させます。
				v2dVelocity={
					INT16(0),
					INT16(cpgameowner->ENEMY_ui16nSpeed>>1)
				};
				ui16iPattern=0;
				//	敵弾発射のための準備をします。
				AIM_Start(cpgameowner);
				break;
			case IDTYPE::Bullet:
				SetPosition(cv2iposition);
				//	移動方向を「自機」に向けます。
				v2dVelocity=VECTOR2::stv2dGetDirection(cpgameowner->ENEMY_ui8iAim(v2iPosition_Upper),cpgameowner->ENEMY_ui16nSpeed>>1);
				ui16iPattern=0;
				break;
			default:
				break;
			}
			return;
		}
		//	UINT8					ui8nShow(CUINT8 cui8isprite)
		//		「敵」表示処理です。
		//		スプライト番号「cui8isprite」以降で表示する事を求めています。
		//		「移動処理」と分けているのは、「表示を垂直帰線期間中に確実に完了させる」ためです。
		//		返り値はスプライト枚数の使用実績です。
		UINT8					ui8nShow(CUINT8 cui8isprite)const noexcept{
			switch(idType){
			case IDTYPE::Crushed:
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),(ui16iPattern&4)+176,3);
				return 1;
			case IDTYPE::NormalWavy:
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),(ui16iPattern&4)+144,1);
				return 1;
			case IDTYPE::NormalStraight:
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),160,1,FALSE,TRUE);
				return 1;
			case IDTYPE::NormalStraightSide:
				//	「ui16iPattern」は下記のように解釈
				//		0:下
				//		1:右
				//		2:左
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),(ui16iPattern==0)?160:152,2,(ui16iPattern==1),TRUE);
				return 1;
			case IDTYPE::NormalBackAttacker:
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),(ui16iPattern&4)+144,2);
				return 1;
			case IDTYPE::NormalHighSpeed:
				//	回転アニメーションさせるため泥臭く分岐。
				switch((ui16iPattern>>1)&3){
				case 0:
					//	－
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),210,1,FALSE,FALSE);
					break;
				case 1:
					//	＼
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),211,1,FALSE,FALSE);
					break;
				case 2:
					//	｜
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),214,1,FALSE,FALSE);
					break;
				case 3:
					//	／
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),211,1,TRUE,FALSE);
					break;
				}
				return 1;
			case IDTYPE::NormalFollower:
				FAMILYBASIC::SPRITE_stWrite16(cui8isprite,v2iPosition_Upper-VECTOR2(8,8),((ui16iPattern>>1)&4)+88,1);
				return 1;
			case IDTYPE::Bullet:
				//	回転アニメーションさせるため泥臭く分岐。
				switch((ui16iPattern>>2)&3){
				case 0:
					//	－
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),210,3,FALSE,FALSE,2);
					break;
				case 1:
					//	＼
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),211,3,FALSE,FALSE,2);
					break;
				case 2:
					//	｜
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),214,3,FALSE,FALSE,2);
					break;
				case 3:
					//	／
					FAMILYBASIC::SPRITE_stWrite8(cui8isprite,v2iPosition_Upper-VECTOR2(4,4),211,3,TRUE,FALSE,2);
					break;
				}
				return 1;
			default:
				break;
			}
			//	「生きて」ないのでスプライト消費はゼロ。
			return 0;
		}
		//	VOID					Move(const PGAME cpgameowner)
		//		「敵」移動処理です。
		//		移動の他、画面外脱出判定、当たり判定、「敵弾」発射等もここで行います。
		//		「cpgameowner」が引数として渡っているのは、新規「敵」生成や、
		//		「自機の方向を調べる」等のサービスを提供するためです。
		VOID					Move(const PGAME cpgameowner)noexcept{
			switch(idType){
			case IDTYPE::Crushed:
				SetPosition(v2iPosition+v2dVelocity);
				++ui16iPattern;
				//	気が済んだら「生きて」いない状態に変化
				if(ui16iPattern==16)Start(cpgameowner,IDTYPE::None);
				break;
			case IDTYPE::NormalWavy:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen16(v2iPosition)){
					//	画面内に収まっているので生存継続
					AIM_Move(cpgameowner);
					//	当たり判定は「敵」側から実施
					if(cpgameowner->eIsHitL(v2iPosition_Upper,VECTOR2(6,6))){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}else{
						//	撃ち落とされてないので移動を実施
						++ui16iPattern;
						v2dVelocity.i16iX()+=((INT16(128)<<stcui8nDiscardBit)-v2iPosition.i16iX())>>9;
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::NormalStraight:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen16(v2iPosition)){
					//	画面内に収まっているので生存継続
					AIM_Move(cpgameowner);
					//	当たり判定は「敵」側から実施
					if(cpgameowner->eIsHitL(v2iPosition_Upper,VECTOR2(6,6))){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::NormalStraightSide:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen16(v2iPosition)){
					//	画面内に収まっているので生存継続
					AIM_Move(cpgameowner);
					//	当たり判定は「敵」側から実施
					if(cpgameowner->eIsHitL(v2iPosition_Upper,VECTOR2(6,6))){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}else{
						//	撃ち落とされてないので移動を実施
						if(ui16iPattern==0){
							if(cpgameowner->PLAYER_v2iPosition.i16iY()<v2iPosition.i16iY()){
								//	「ui16iPattern」は下記のように解釈
								//		0:下
								//		1:右
								//		2:左
								if(v2iPosition.i16iX()<cpgameowner->PLAYER_v2iPosition.i16iX()){
									v2dVelocity={INT16(+v2dVelocity.i16iY()),0};
									ui16iPattern=1;
								}else{
									v2dVelocity={INT16(-v2dVelocity.i16iY()),0};
									ui16iPattern=2;
								}
							}
						}
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::NormalBackAttacker:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen16(v2iPosition)){
					//	画面内に収まっているので生存継続
					AIM_Move(cpgameowner);
					//	当たり判定は「敵」側から実施
					if(cpgameowner->eIsHitL(v2iPosition_Upper,VECTOR2(6,6))){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}else{
						//	撃ち落とされてないので移動を実施
						++ui16iPattern;
						if(ui16iPattern<0x0100){
							//	256フレーム経過していなければ「追いかけ」る
							if((ui16iPattern&0x001f)==0){
								//	32フレーム毎に「自機」に向かい直す
								v2dVelocity=VECTOR2::stv2dGetDirection(cpgameowner->ENEMY_ui8iAim(v2iPosition_Upper),cpgameowner->ENEMY_ui16nSpeed>>1);
							}
						}else{
							//	256フレーム経過したなら画面外に移動
							v2dVelocity={
								INT16(0),
								INT16(-(cpgameowner->ENEMY_ui16nSpeed>>1))
							};
						}
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::NormalHighSpeed:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen8(v2iPosition)){
					//	画面内に収まっているので生存継続
					if(cpgameowner->eIsHitL(v2iPosition_Upper,VECTOR2(2,2))){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}else{
						++ui16iPattern;
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::NormalFollower:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen16(v2iPosition)){
					//	画面内に収まっているので生存継続
					AIM_Move(cpgameowner);
					//	当たり判定は「敵」側から実施
					if(
						CAUTO					cui8ndurability_original=ui8nDurability;
						cpgameowner->eIsHitH(v2iPosition_Upper,VECTOR2(6,6),ui8nDurability)
					){
						//	撃ち落とされたので加点後「爆発パターン」に変化
						cpgameowner->AddScore(1);
						Start(cpgameowner,IDTYPE::Crushed,v2iPosition);
					}else{
						if(cui8ndurability_original!=ui8nDurability)FAMILYBASIC::SE0_stPlay(SE0_stacui8cHit);
						//	撃ち落とされてないので移動を実施
						++ui16iPattern;
						if(ui16iPattern<0x0200){
							//	512フレーム経過していなければ「追いかけ」る
							if(
								CAUTO					cui16cmasked=UINT16(ui16iPattern&0x001f);
								cui16cmasked==0x0000
							){
								//	16フレーム交互に「自機」に向かい直す
								v2dVelocity=VECTOR2::stv2dGetDirection(cpgameowner->ENEMY_ui8iAim(v2iPosition_Upper),cpgameowner->ENEMY_ui16nSpeed>>1);
							}else if(cui16cmasked==0x0010){
								//	16フレーム交互に停止する
								v2dVelocity=VECTOR2::stv2ImmediateZero();
							}
						}else{
							//	256フレーム経過したなら画面外に移動
							v2dVelocity={
								INT16(0),
								INT16(-(cpgameowner->ENEMY_ui16nSpeed>>1))
							};
						}
					}
				}else idType=IDTYPE::None;
				break;
			case IDTYPE::Bullet:
				SetPosition(v2iPosition+v2dVelocity);
				if(steIsInScreen8(v2iPosition)){
					//	画面内に収まっているので生存継続
					if(cpgameowner->PLAYER_eIsHitL(v2iPosition_Upper,VECTOR2(2,2))){
						//	まだ「バリア」的なフィーチャーが無いので、この分岐に入る事はありません
						Start(cpgameowner,IDTYPE::None);
					}else{
						++ui16iPattern;
					}
				}else idType=IDTYPE::None;
				break;
			default:
				break;
			}
			return;
		}
	private:
		//	VOID					SetPosition(CVECTOR2& cv2iposition)
		//		「cv2iposition」で「位置」を更新します。
		//		セット更新が必要となる「v2iPosition_Upper」があるので明示的に手続き化しています。
		constexpr VOID			SetPosition(CVECTOR2& cv2iposition)noexcept{
			v2iPosition=cv2iposition;
			v2iPosition_Upper=v2iPosition>>stcui8nDiscardBit;
			return;
		}
		//	VOID					AIM_Start(const PGAME cpgameowner)
		//		「敵弾」発射管理情報を初期化します。
		VOID					AIM_Start(const PGAME cpgameowner)noexcept{
			//	カウンタ初期値を乱数にしておく事で、「敵弾」に「バラまき感」が出ます
			ui16nAimRest=1+cpgameowner->ENEMY_ui16nAim-STD::stxGetMinimum(cpgameowner->ENEMY_ui16nAim,FAMILYBASIC::stui16GetRandom()&63);
			return;
		}
		//	VOID					AIM_Move(const PGAME cpgameowner)
		//		「敵弾」発射管理定常処理です。
		//		ここで間隔を見て「敵弾」を発射します。
		VOID					AIM_Move(const PGAME cpgameowner)noexcept{
			--ui16nAimRest;
			if(ui16nAimRest==0){
				ui16nAimRest=cpgameowner->ENEMY_ui16nAim;
				//	「敵」生成は「GAME」クラスの役割です。
				cpgameowner->ENEMY_Start(IDTYPE::Bullet,v2iPosition);
			}
			return;
		}
	};

	//
	//		body:GAME
	//

private:
	//	IDMODE					idMode
	//		ゲームの「状態」を保持します。
	//		今回は、プログラム中の「処理の場所」でなく、
	//		「入口一つで毎回枝分かれする」という方法を採っています。
	IDMODE					idMode;
	//	UINT16					ui16nScore
	//		点数です。「9999」まで表示できるようにしています。
	UINT16					ui16nScore;
	//	UINT16					ui16nShotDown
	//		「敵」撃墜点数です。
	UINT16					ui16nShotDown;
	//	UINT8					CONTROLLER_ui8cCurrent
	//		「コントローラ」入力値そのものです。
	//		押下で当該bitが1になります。
	UINT8					CONTROLLER_ui8cCurrent;
	//	UINT8					CONTROLLER_ui8cSingle
	//		「コントローラ」入力値ですが、
	//		「CONTROLLER_ui8cCurrent」と異なり、押下の「瞬間」でだけ、当該bitが1になります。
	UINT8					CONTROLLER_ui8cSingle;
	//	UINT8					CONTROLLER_aui8cRapid[]
	//		「コントローラ」ソフトウェア連射を実現するための履歴情報です。
	UINT8					CONTROLLER_aui8cRapid[CONTROLLER_stcui8nRapid];
	//	UINT8					CONTROLLER_ui8iRapid
	//		「コントローラ」ソフトウェア連射を実現するための履歴情報の「参照位置」です。
	UINT8					CONTROLLER_ui8iRapid;
	//	VECTOR2					PLAYER_v2iPosition
	//		「自機の位置」です。
	//		この値は6bit小数点値の「固定小数点値」です。
	VECTOR2					PLAYER_v2iPosition;
	//	VECTOR2					PLAYER_v2iPosition_Upper
	//		整数状態での「自機の位置」です。
	//		当たり判定は整数状態で取るので、キャッシュ的に保持しておきます。
	VECTOR2					PLAYER_v2iPosition_Upper;
	//	VECTOR2					PLAYER_av2nSpeed[]
	//		8方向+1(静止状態)に対応する「自機の速度(移動差分)」です。
	//		この値は6bit小数点値の「固定小数点値」です。
	VECTOR2					PLAYER_av2nSpeed[9];
	//	UINT16					PLAYER_ui16iPattern
	//		「自機」のアニメーションパターンという体ではありますが、
	//		「ミス」後の「爆発アニメーションパターン」として使っているので、
	//		事実上「ミス」フラグ扱いです。
	UINT16					PLAYER_ui16iPattern;
	//	UINT16					PLAYER_ui16iRank
	//		「自機」ランクです。
	//		上昇に応じてショットが変化します。
	UINT16					PLAYER_ui16iRank;
	//	IDSHOT					PLAYER_idShot
	//		「自機」ショット(パワーアップ)状態を保持します。
	IDSHOT					PLAYER_idShot;
	//	SHOT					SHOT_ashotThis0[]～SHOT_ashotThis1[]
	//		「ショット状態」を保持する構造体の配列です。
	SHOT					SHOT_ashotThis0[SHOT_stcui8nInstanceMaximum];
	SHOT					SHOT_ashotThis1[SHOT_stcui8nInstanceMaximum];
	SHOT					SHOT_ashotThis2[SHOT_stcui8nInstanceMaximum];
	//	ENEMY					ENEMY_aenmyThis[]
	//		「敵状態」を保持する構造体の配列です。
	ENEMY					ENEMY_aenmyThis[ENEMY_stcui8nInstanceMaximum];
	//	UINT16					ENEMY_ui16iRank
	//		「敵」ランク(難易度)です。
	//		「敵弾間隔だけ短くする」みたいな難易度コントロールしたいがため、
	//		難易度関連パラメータと別に「ランク値」として保持します。
	UINT16					ENEMY_ui16iRank;
	//	UINT16					ENEMY_ui16nCounter
	//		次の「敵」が出現するまでのカウンタ(フレーム)母数です。
	UINT16					ENEMY_ui16nCounter;
	//	UINT16					ENEMY_ui16nCounterRest
	//		次の「敵」が出現するまでのカウンタ(フレーム)現在値です。
	//		マイナス1され続け、「0」になると次の「敵」が出現します。
	UINT16					ENEMY_ui16nCounterRest;
	//	UINT16					ENEMY_ui16nSpeed
	//		「敵」基本スピードです。
	UINT16					ENEMY_ui16nSpeed;
	//	UINT16					ENEMY_ui16nAim
	//		「敵弾」発射間隔です。
	UINT16					ENEMY_ui16nAim;
	//	ENEMY::IDTYPE			ENEMYGROUP_idType
	//		「敵集団」の敵種別現在値です。
	ENEMY::IDTYPE			ENEMYGROUP_idType;
	//	UINT16					ENEMYGROUP_ui16nCounter
	//		次の「敵集団」が出現するまでのカウンタ(フレーム)母数です。
	UINT16					ENEMYGROUP_ui16nCounter;
	//	UINT16					ENEMYGROUP_ui16nCounterRest
	//		次の「敵集団」が出現するまでのカウンタ(フレーム)現在値です。
	//		マイナス1され続け、「0」になると次の「敵集団」が出現します。
	UINT16					ENEMYGROUP_ui16nCounterRest;
	//	UINT16					ENEMYGROUP_ui16nEntityRest
	//		現在「敵集団」の残り「敵」数です。
	//		「敵」出現都度マイナス1され続け、「0」になると次の「敵集団」が出現します。
	UINT16					ENEMYGROUP_ui16nEntityRest;
	//	UINT16					SCROLL_ui16iPosition
	//		「背景」スクロール位置です。
	UINT16					SCROLL_ui16iPosition;
public:
	//	OFWBOOL					steIsInScreen8(CVECTOR2& cv2iposition)
	//		「cv2iposition」にある8ドット四方のオブジェクトが画面内かどうかを判定します。
	//		画面内であれば「TRUE」を返します。
	static constexpr OFWBOOL	steIsInScreen8(CVECTOR2& cv2iposition)noexcept{
		return (
			(stcv2iiMinimum8.i16iX()<cv2iposition.i16iX())&&
			(cv2iposition.i16iX()<stcv2iiMaximum8.i16iX())&&
			(stcv2iiMinimum8.i16iY()<cv2iposition.i16iY())&&
			(cv2iposition.i16iY()<stcv2iiMaximum8.i16iY())
		);
	}
	//	OFWBOOL					steIsInScreen16(CVECTOR2& cv2iposition)
	//		「cv2iposition」にある16ドット四方のオブジェクトが画面内かどうかを判定します。
	//		画面内であれば「TRUE」を返します。
	static constexpr OFWBOOL	steIsInScreen16(CVECTOR2& cv2iposition)noexcept{
		return (
			(stcv2iiMinimum16.i16iX()<cv2iposition.i16iX())&&
			(cv2iposition.i16iX()<stcv2iiMaximum16.i16iX())&&
			(stcv2iiMinimum16.i16iY()<cv2iposition.i16iY())&&
			(cv2iposition.i16iY()<stcv2iiMaximum16.i16iY())
		);
	}
	/*VOID*/				GAME(VOID)noexcept{}
	/*VOID*/				~GAME(VOID)noexcept{
		Delete();
	}
	//	VOID					New(VOID)
	//		ゲームとしての初期化処理です。
	//		ゲームオーバーが挟まろうが、実行は一度きりです。
	VOID					New(VOID)noexcept{
		idMode=IDMODE::Start;
		CONTROLLER_ui8cCurrent=0;
		for(AUTO& ui8ccurrent:CONTROLLER_aui8cRapid)ui8ccurrent=0x00;
		for(AUTO& shotcurrent:SHOT_ashotThis0)shotcurrent.New();
		for(AUTO& shotcurrent:SHOT_ashotThis1)shotcurrent.New();
		for(AUTO& shotcurrent:SHOT_ashotThis2)shotcurrent.New();
		for(AUTO& enmycurrent:ENEMY_aenmyThis)enmycurrent.New();
		return;
	}
	//	VOID					Delete(VOID)
	//		ゲームとしての終了処理ですが、現状呼び出される事はありません。
	VOID					Delete(VOID)noexcept{
		for(AUTO& enmycurrent:ENEMY_aenmyThis)enmycurrent.Delete();
		for(AUTO& shotcurrent:SHOT_ashotThis0)shotcurrent.Delete();
		for(AUTO& shotcurrent:SHOT_ashotThis1)shotcurrent.Delete();
		for(AUTO& shotcurrent:SHOT_ashotThis2)shotcurrent.Delete();
		return;
	}
	//	VOID					Main(VOID)
	//		ゲームとしてのメイン処理です。
	//		1/60秒毎の垂直帰線期間突入都度、「USER_Main」から呼び出されます。
	_INLINE_ VOID			Main(VOID)noexcept{
		switch(idMode){
		case IDMODE::Start:
			Start();
			break;
		case IDMODE::Normal:
			Normal();
			break;
		case IDMODE::GameOver:
			GameOver();
			break;
		}
		return;
	}
	//	VOID					Start(VOID)
	//		ゲーム開始処理です。
	//		初期化処理の後の他、ゲームオーバーになった後にも実行されます。
	VOID					Start(VOID)noexcept{
		idMode=IDMODE::Normal;
		ui16nScore=0;
		ui16nShotDown=0;
		//	「自機」初期化
		PLAYER_v2iPosition={INT16(128)<<stcui8nDiscardBit,INT16(200)<<stcui8nDiscardBit};
		PLAYER_v2iPosition_Upper=PLAYER_v2iPosition>>stcui8nDiscardBit;
		//	「自機」移動速度初期化です。
		//	将来的「動的変更」に備え変数になっていますが、現状固定値です。
		{
			INT16					i16nspeed=INT16(2)<<stcui8nDiscardBit;

			PLAYER_av2nSpeed[0]={0,					0					};
			PLAYER_av2nSpeed[1]={0,					INT16(-i16nspeed)	};
			PLAYER_av2nSpeed[2]={INT16(+i16nspeed),	INT16(-i16nspeed)	};
			PLAYER_av2nSpeed[3]={INT16(+i16nspeed), 0					};
			PLAYER_av2nSpeed[4]={INT16(+i16nspeed),	INT16(+i16nspeed)	};
			PLAYER_av2nSpeed[5]={0,					INT16(+i16nspeed)	};
			PLAYER_av2nSpeed[6]={INT16(-i16nspeed),	INT16(+i16nspeed)	};
			PLAYER_av2nSpeed[7]={INT16(-i16nspeed),	0					};
			PLAYER_av2nSpeed[8]={INT16(-i16nspeed),	INT16(-i16nspeed)	};
		}
		PLAYER_ui16iPattern=0;
		PLAYER_ui16iRank=0;
		PLAYER_RankUp();
		//	「敵」初期化
		for(AUTO& enmycurrent:ENEMY_aenmyThis)enmycurrent.Start(this,ENEMY::IDTYPE::None,VECTOR2::stv2ImmediateZero());
		ENEMY_ui16iRank=0;
		ENEMY_RankUp();
		//	「背景」初期化
		SCROLL_ui16iPosition=0;
		//	点数系初期化
		FAMILYBASIC::BG0_stPrint({11,12},"          ",0);
		ShowScore();
		Normal();
		return;
	}
	//	VOID					Normal(VOID)
	//		ゲーム通常処理です。
	//		1/60毎の実行で丁度良くなるよう、
	//		「登場人物全てを満遍なくちょっとずつ動かす事」がポイントです。
	VOID					Normal(VOID)noexcept{
		CONTROLLER_Update();
		//	表示(垂直帰線期間中に完了できるよう冒頭に持ってくる)
		Show();
		//	「背景」移動
		SCROLL_ui16iPosition-=INT16(1)<<stcui8nDiscardBit;
		//	「自機」移動
		if(PLAYER_ui16iPattern==0){
			//	UINT8					stacui8idirection
			//		「コントローラ」入力と8方向+1(静止)の「方角」を関連付ける定数配列です。
			//		「方角」と数字の対応は下記の通りです。
			//
			//			8	1	2
			//				|
			//			7---0---3
			//				|
			//			6	5	4
			static constexpr UINT8	stacui8idirection[]={
						//	UDLR←「コントローラ」のbit状態(押下で「1」)
				0,		//	0000
				3,		//	0001
				7,		//	0010
				0,		//	0011
				5,		//	0100
				4,		//	0101
				6,		//	0110
				5,		//	0111
				1,		//	1000
				2,		//	1001
				8,		//	1010
				1,		//	1011
				0,		//	1100
				3,		//	1101
				7,		//	1110
				0		//	1111
			};

			PLAYER_v2iPosition+=PLAYER_av2nSpeed[stacui8idirection[CONTROLLER_ui8cCurrent&0xf]];
			PLAYER_v2iPosition=PLAYER_v2iPosition.v2GetMaximum(PLAYER_stcv2iiMinimum);
			PLAYER_v2iPosition=PLAYER_v2iPosition.v2GetMinimum(PLAYER_stcv2iiMaximum);
			PLAYER_v2iPosition_Upper=PLAYER_v2iPosition>>stcui8nDiscardBit;
			//	「ショット」発射操作はソフトウェア連射で
			if(CONTROLLER_ui8cGetRapid()&FAMILYBASIC::stcui8cMaskButtonB)switch(PLAYER_idShot){
			case IDSHOT::UpSingle:
				{
					CAUTO					ceshot0=SHOT_steStart(SHOT_ashotThis0,SHOT::IDTYPE::Up,PLAYER_v2iPosition);

					if(ceshot0)FAMILYBASIC::SE0_stPlay(SE0_stacui8cShot);
				}
				break;
			case IDSHOT::UpDual:
				{
					constexpr AUTO			cv2idoffset=VECTOR2(6,0)<<stcui8nDiscardBit;
					CAUTO					ceshot0=SHOT_steStart(SHOT_ashotThis0,SHOT::IDTYPE::Up,PLAYER_v2iPosition-cv2idoffset);
					CAUTO					ceshot1=SHOT_steStart(SHOT_ashotThis1,SHOT::IDTYPE::Up,PLAYER_v2iPosition+cv2idoffset);

					if(ceshot0||ceshot1)FAMILYBASIC::SE0_stPlay(SE0_stacui8cShot);
				}
				break;
			case IDSHOT::UpLeftRight:
				{
					constexpr AUTO			cv2idoffset=VECTOR2(6,0)<<stcui8nDiscardBit;
					CAUTO					ceshot0=SHOT_steStart(SHOT_ashotThis0,SHOT::IDTYPE::Up,PLAYER_v2iPosition);
					CAUTO					ceshot1=SHOT_steStart(SHOT_ashotThis1,SHOT::IDTYPE::Left,PLAYER_v2iPosition-cv2idoffset);
					CAUTO					ceshot2=SHOT_steStart(SHOT_ashotThis2,SHOT::IDTYPE::Right,PLAYER_v2iPosition+cv2idoffset);

					if(ceshot0||ceshot1||ceshot2)FAMILYBASIC::SE0_stPlay(SE0_stacui8cShot);
				}
				break;
			}
		}
		//	「ショット」移動
		for(AUTO& shotcurrent:SHOT_ashotThis0)shotcurrent.Move(this);
		for(AUTO& shotcurrent:SHOT_ashotThis1)shotcurrent.Move(this);
		for(AUTO& shotcurrent:SHOT_ashotThis2)shotcurrent.Move(this);
		//	「敵」出現
		if(ENEMYGROUP_ui16nEntityRest){
			//	「敵集団」出現継続中
			--ENEMY_ui16nCounterRest;
			if(ENEMY_ui16nCounterRest==0){
				ENEMY_ui16nCounterRest=ENEMY_ui16nCounter;
				ENEMY_Start(ENEMYGROUP_idType);
				--ENEMYGROUP_ui16nEntityRest;
			}
		}else{
			//	次「敵集団」準備
			--ENEMYGROUP_ui16nCounterRest;
			if(ENEMYGROUP_ui16nCounterRest==0){
				//	適当に発生に重みづけ
				static constexpr ENEMY::IDTYPE	stacidtype[]={
					ENEMY::IDTYPE::NormalWavy,
					ENEMY::IDTYPE::NormalWavy,
					ENEMY::IDTYPE::NormalWavy,
					ENEMY::IDTYPE::NormalWavy,
					ENEMY::IDTYPE::NormalWavy,
					ENEMY::IDTYPE::NormalStraight,
					ENEMY::IDTYPE::NormalStraight,
					ENEMY::IDTYPE::NormalStraight,
					ENEMY::IDTYPE::NormalStraight,
					ENEMY::IDTYPE::NormalStraightSide,
					ENEMY::IDTYPE::NormalStraightSide,
					ENEMY::IDTYPE::NormalBackAttacker,
					ENEMY::IDTYPE::NormalBackAttacker,
					ENEMY::IDTYPE::NormalHighSpeed,
					ENEMY::IDTYPE::NormalHighSpeed,
					ENEMY::IDTYPE::NormalFollower
				};

				//	新規「敵集団」開始
				ENEMYGROUP_idType=stacidtype[FAMILYBASIC::stui16GetRandom()&15];
				ENEMYGROUP_ui16nCounterRest=ENEMYGROUP_ui16nCounter;
				ENEMYGROUP_ui16nEntityRest=ENEMYGROUP_stcui16nEntity;
				ENEMY_ui16nCounterRest=ENEMY_ui16nCounter;
			}
		}
		//	「敵」移動
		{
			CAUTO					cui16nscore=ui16nScore;

			for(AUTO& enmycurrent:ENEMY_aenmyThis)enmycurrent.Move(this);
			//	点数に変動があった場合だけ表示
			if(cui16nscore!=ui16nScore)ShowScore();
		}
		//	ゲームオーバー判定
		if(PLAYER_ui16iPattern){
			++PLAYER_ui16iPattern;
			if(PLAYER_ui16iPattern==16){
				FAMILYBASIC::BG0_stPrint({11,12},"GAME  OVER",0);
				idMode=IDMODE::GameOver;
				FAMILYBASIC::BGM_stSetMasterVolumeFade(255,4);
			}
		}
		return;
	}
	//	VOID					GameOver(VOID)
	//		ゲームオーバー処理です。
	//		無くても構わないのですが、一応表示処理だけ実行しています。
	//		リスタート判定は「CONTROLLER_ui8cSingle」で行っているので、
	//		Aボタン押しっぱでゲームオーバーになったとしても、「即座に再開」とはなりません。
	VOID					GameOver(VOID)noexcept{
		CONTROLLER_Update();
		Show();
		//	リスタート判定
		if(CONTROLLER_ui8cSingle&(1<<FAMILYBASIC::IDBUTTON::A))idMode=IDMODE::Start;
		return;
	}
private:
	//	VOID					Show(VOID)
	//		表示処理です。
	//		通常進行中の表示の他、ゲームオーバー静止画像表示にも使います。
	VOID					Show(VOID)const noexcept{
		using					IDREGISTERW=VIDEO_DRIVER::IDREGISTERW;
		UINT8					ui8isprite=0;

		//	星
		VIDEO_DRIVER::stWrite(IDREGISTERW::BG1OffsetY,((SCROLL_ui16iPosition>>stcui8nDiscardBit)&0x0ff)|0x2000);
		VIDEO_DRIVER::stWrite(IDREGISTERW::BG2OffsetY,((SCROLL_ui16iPosition>>(stcui8nDiscardBit+1))&0x0ff)|0x2000);
		VIDEO_DRIVER::stWrite(IDREGISTERW::BG3OffsetY,((SCROLL_ui16iPosition>>(stcui8nDiscardBit+2))&0x0ff)|0x2000);
		//	自機
		if(PLAYER_ui16iPattern==0){
			FAMILYBASIC::SPRITE_stWrite16(ui8isprite,PLAYER_v2iPosition_Upper-VECTOR2(8,8),172,0);
		}else{
			FAMILYBASIC::SPRITE_stWrite16(ui8isprite,PLAYER_v2iPosition_Upper-VECTOR2(8,8),(PLAYER_ui16iPattern&4)+176,3);
		}
		++ui8isprite;
		//	ショット
		for(CAUTO& cshotcurrent:SHOT_ashotThis0)ui8isprite+=cshotcurrent.ui8nShow(ui8isprite);
		for(CAUTO& cshotcurrent:SHOT_ashotThis1)ui8isprite+=cshotcurrent.ui8nShow(ui8isprite);
		for(CAUTO& cshotcurrent:SHOT_ashotThis2)ui8isprite+=cshotcurrent.ui8nShow(ui8isprite);
		//	敵
		for(CAUTO& cenmycurrent:ENEMY_aenmyThis)ui8isprite+=cenmycurrent.ui8nShow(ui8isprite);
		//	残りは消去
		while(ui8isprite!=0){
			FAMILYBASIC::SPRITE_stErase(ui8isprite);
			++ui8isprite;
		}
		return;
	}
	//	VOID					ShowScore(VOID)
	//		点数表示処理です。最大「9999」まで表示できます。
	//		通常「ui16nScore%1000」等と書くところですが、
	//		割り算は遅いので引き算の繰り返しを行っています。
	VOID					ShowScore(VOID)const noexcept{
		USTR					austrscore[]="0000";
		AUTO					ui16nscore=ui16nScore;
		USTR					ustrzero=' ';
		USTR					ustrdigit;

		//	「千」の位
		for(ustrdigit='0';1000<=ui16nscore;++ustrdigit,ui16nscore-=1000);
		if(ustrdigit=='0'){
			austrscore[0]=ustrzero;
		}else{
			ustrzero='0';
			austrscore[0]=ustrdigit;
		}
		//	「百」の位
		for(ustrdigit='0';100<=ui16nscore;++ustrdigit,ui16nscore-=100);
		if(ustrdigit=='0'){
			austrscore[1]=ustrzero;
		}else{
			ustrzero='0';
			austrscore[1]=ustrdigit;
		}
		//	「十」の位
		for(ustrdigit='0';10<=ui16nscore;++ustrdigit,ui16nscore-=10);
		if(ustrdigit=='0'){
			austrscore[2]=ustrzero;
		}else{
			ustrzero='0';
			austrscore[2]=ustrdigit;
		}
		//	「一」の位は空白表示の場合が無いので単純変換
		austrscore[3]='0'+ui16nscore;
		FAMILYBASIC::BG0_stPrint({6,1},austrscore,0);
	}
	//	VOID					AddScore(CUINT16 cui16nscore)
	//		スコアを加算します。
	_INLINE_ VOID			AddScore(CUINT16 cui16nscore)noexcept{
		ui16nScore+=cui16nscore;
		if(9999<ui16nScore)ui16nScore=9999;
		return;
	}
	//	VOID					ShotDown(VOID)
	//		「敵」撃墜数を加算し、「自機」および「敵」ランクを制御します。
	VOID					ShotDown(VOID)noexcept{
		++ui16nShotDown;
		if((ui16nShotDown&15)==0){
			PLAYER_RankUp();
			ENEMY_RankUp();
		}
		return;
	}
	//	OFWBOOL					eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)
	//		通常当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「TRUE」を返します。
	_INLINE_ OFWBOOL		eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)noexcept{
		if(PLAYER_eIsHitL(cv2iposition_upper,cv2nhithalf_upper))return TRUE;
		if(SHOT_eIsHitL(SHOT_ashotThis0,cv2iposition_upper,cv2nhithalf_upper))return TRUE;
		if(SHOT_eIsHitL(SHOT_ashotThis1,cv2iposition_upper,cv2nhithalf_upper))return TRUE;
		if(SHOT_eIsHitL(SHOT_ashotThis2,cv2iposition_upper,cv2nhithalf_upper))return TRUE;
		return FALSE;
	}
	//	OFWBOOL					eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)
	//		耐久力持ち当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「ui8ndurability」を減算、さらに「0」に至っていれば「TRUE」を返します。
	_INLINE_ OFWBOOL		eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)noexcept{
		if(PLAYER_eIsHitH(cv2iposition_upper,cv2nhithalf_upper,ui8ndurability))return TRUE;
		if(SHOT_eIsHitH(SHOT_ashotThis0,cv2iposition_upper,cv2nhithalf_upper,ui8ndurability))return TRUE;
		if(SHOT_eIsHitH(SHOT_ashotThis1,cv2iposition_upper,cv2nhithalf_upper,ui8ndurability))return TRUE;
		if(SHOT_eIsHitH(SHOT_ashotThis2,cv2iposition_upper,cv2nhithalf_upper,ui8ndurability))return TRUE;
		return FALSE;
	}
	//	VOID					CONTROLLER_Update(VOID)
	//		コントローラから状態をゲットして、
	//		通常状態他、「押下」のみ状態、ソフトウェア連射状態を設定します。
	_INLINE_ VOID			CONTROLLER_Update(VOID)noexcept{
		CAUTO					cui8cprevious=CONTROLLER_ui8cCurrent;
		AUTO					ui8crapid=CONTROLLER_aui8cRapid[0];

		//	現在値
		CONTROLLER_ui8cCurrent=FAMILYBASIC::CONTROLLER_stui8cRead(0);
		//	変化値
		CONTROLLER_ui8cSingle=CONTROLLER_ui8cCurrent&(CONTROLLER_ui8cCurrent^cui8cprevious);
		//	連射値
		for(UINT8 ui8irapid=1;ui8irapid<CONTROLLER_stcui8nRapid;++ui8irapid)ui8crapid|=CONTROLLER_aui8cRapid[ui8irapid];
		CONTROLLER_ui8iRapid=(CONTROLLER_ui8iRapid+1)%CONTROLLER_stcui8nRapid;
		CONTROLLER_aui8cRapid[CONTROLLER_ui8iRapid]=CONTROLLER_ui8cSingle|(CONTROLLER_ui8cCurrent&(~ui8crapid));
		return;
	}
	//	UINT8					CONTROLLER_ui8cGetRapid(VOID)
	//		「コントローラ」入力値で、「CONTROLLER_ui8cSingle」同様押下の「瞬間」でだけ、当該bitが1になりますが、
	//		押下しっぱなしでも「CONTROLLER_stcui8nRapid」間隔で当該bitが1になります。
	_INLINE_ UINT8			CONTROLLER_ui8cGetRapid(VOID)const noexcept{
		return CONTROLLER_aui8cRapid[CONTROLLER_ui8iRapid];
	}
	//	OFWBOOL					PLAYER_eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)
	//		「自機」対象の通常当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「TRUE」を返しますが、
	//		現状バリア的フィーチャーが無いので、「FALSE」しか返りません。
	OFWBOOL					PLAYER_eIsHitL(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)noexcept{
		if(PLAYER_ui16iPattern==0)if(PLAYER_v2iPosition_Upper.eIsHit512(PLAYER_stcv2inHitHalf_Upper,cv2iposition_upper,cv2nhithalf_upper)){
			PLAYER_ui16iPattern=1;
			SOUND_DRIVER::DEVICE_FM_stWrite(SOUND_DRIVER::FM_IDREGISTERW::NoiseDivRatio5,0x80+31);
			FAMILYBASIC::SE1_stPlay(SE1_stacui8cCrush);
		}
		return FALSE;
	}
	//	OFWBOOL					PLAYER_eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)
	//		「自機」対象の耐久力持ち当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「ui8ndurability」を減算、
	//		さらに「0」に至っていれば「TRUE」を返しますが、
	//		現状バリア的フィーチャーが無いので、「FALSE」しか返りません。
	OFWBOOL					PLAYER_eIsHitH(CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)noexcept{
		if(PLAYER_ui16iPattern==0)if(PLAYER_v2iPosition_Upper.eIsHit512(PLAYER_stcv2inHitHalf_Upper,cv2iposition_upper,cv2nhithalf_upper)){
			PLAYER_ui16iPattern=1;
			SOUND_DRIVER::DEVICE_FM_stWrite(SOUND_DRIVER::FM_IDREGISTERW::NoiseDivRatio5,0x80+31);
			FAMILYBASIC::SE1_stPlay(SE1_stacui8cCrush);
		}
		return FALSE;
	}
	//	VOID					PLAYER_RankUp(VOID)
	//		「自機」ランクを上げ、状況に応じてパワーアップします。
	VOID					PLAYER_RankUp(VOID)noexcept{
		if((PLAYER_ui16iRank&0x0007)==0)switch(PLAYER_ui16iRank>>3){
		case 0:
			PLAYER_idShot=IDSHOT::UpSingle;
			break;
		case 1:
			PLAYER_idShot=IDSHOT::UpDual;
			break;
		case 2:
			PLAYER_idShot=IDSHOT::UpLeftRight;
			break;
		}
		++PLAYER_ui16iRank;
		return;
	}
	//	VOID					SHOT_stStart(SHOT& ashotthis[],const SHOT::IDTYPE cidtype,CVECTOR2& cv2iposition)
	//		「生きて」いない「ショット」を見つけて初期化(発射)します。
	//		成功時「TRUE」を返します。
	OFWBOOL					SHOT_steStart(SHOT (&ashotthis)[SHOT_stcui8nInstanceMaximum],const SHOT::IDTYPE cidtype,CVECTOR2& cv2iposition)noexcept{
		for(AUTO& shotcurrent:ashotthis)if(!shotcurrent.eIsActive()){
			shotcurrent.Start(this,cidtype,cv2iposition);
			return TRUE;
		}
		return FALSE;
	}
	//	OFWBOOL					SHOT_eIsHitL(SHOT& ashotthis[],CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)
	//		「ショット」対象の通常当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「TRUE」を返します。
	OFWBOOL					SHOT_eIsHitL(SHOT (&ashotthis)[SHOT_stcui8nInstanceMaximum],CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper)noexcept{
		for(AUTO& shotcurrent:ashotthis)if(shotcurrent.eIsHitL(cv2iposition_upper,cv2nhithalf_upper)){
			ShotDown();
			return TRUE;
		}
		return FALSE;
	}
	//	OFWBOOL					SHOT_eIsHitH(SHOT& ashotthis[],CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)
	//		「ショット」対象の耐久力持ち当たり判定です。
	//		整数値たる位置「cv2iposition_upper」およびサイズ(の半分)「cv2nhithalf_upper」と比較して、
	//		「ショットによる破壊」的意味で当たっていれば「ui8ndurability」を減算、
	//		さらに「0」に至っていれば「TRUE」を返します。
	OFWBOOL					SHOT_eIsHitH(SHOT (&ashotthis)[SHOT_stcui8nInstanceMaximum],CVECTOR2& cv2iposition_upper,CVECTOR2& cv2nhithalf_upper,UINT8& ui8ndurability)noexcept{
		for(AUTO& shotcurrent:ashotthis)if(shotcurrent.eIsHitH(cv2iposition_upper,cv2nhithalf_upper,ui8ndurability)){
			ShotDown();
			return TRUE;
		}
		return FALSE;
	}
	//	VOID					ENEMY_Start(const ENEMY::IDTYPE cidtype,CVECTOR2& cv2iposition)
	//		「敵」を出現させます。
	//		「敵状態」を保持する構造体の配列を「GAME」クラス側に持っているため、
	//		「敵」出現は「GAME」クラスの役割になります。
	VOID					ENEMY_Start(const ENEMY::IDTYPE cidtype,CVECTOR2& cv2iposition=VECTOR2::stv2ImmediateZero())noexcept{
		for(AUTO& enmycurrent:ENEMY_aenmyThis)if(!enmycurrent.eIsActive()){
			enmycurrent.Start(this,cidtype,cv2iposition);
			break;
		}
		return;
	}
	//	UINT8					ENEMY_ui8iAim(CVECTOR2& cv2iposition_upper)
	//		整数値たる位置「cv2iposition_upper」から見た自機の「方角」を返します。
	//		この「方角」は「VECTOR2::stv2Trigonometric」に渡す事ができます。
	UINT8					ENEMY_ui8iAim(CVECTOR2& cv2iposition_upper)const noexcept{
		return VECTOR2(PLAYER_v2iPosition_Upper-cv2iposition_upper).ui8Atan();
	}
	//	VOID					ENEMY_RankUp(VOID)
	//		敵ランク(難易度)アップします。
	VOID					ENEMY_RankUp(VOID)noexcept{
		if(ENEMY_ui16iRank==0){
			ENEMY_ui16nCounter=16;
			ENEMY_ui16nSpeed=1<<stcui8nDiscardBit;
			ENEMY_ui16nAim=256;
			ENEMYGROUP_ui16nCounter=128;
			ENEMYGROUP_ui16nCounterRest=128;
			ENEMYGROUP_ui16nEntityRest=0;
		}else{
			if((ENEMY_ui16iRank&0x0007)==0)ENEMY_ui16nCounter=STD::stxGetMaximum(ENEMY_ui16nCounter-1,8);
			if((ENEMY_ui16iRank&0x000f)==0)ENEMY_ui16nSpeed=STD::stxGetMinimum(ENEMY_ui16nSpeed+(1<<(stcui8nDiscardBit-1)),2<<stcui8nDiscardBit);
			ENEMY_ui16nAim=STD::stxGetMaximum(ENEMY_ui16nAim-2,64);
			ENEMYGROUP_ui16nCounter=STD::stxGetMaximum(ENEMYGROUP_ui16nCounter-2,8);
		}
		++ENEMY_ui16iRank;
		return;
	}
};

//
//		user
//

static GAME				stgameThis;

//
//		entry
//

VOID					USER_New(VOID)noexcept{
	FAMILYBASIC::stNew();
	FAMILYBASIC::PALETTE_stWriteSet(1,1);
	//	左右ループさせたくないので、スプライトは縦横512ドット空間に設定
	FAMILYBASIC::SPRITE_stSetSize(FAMILYBASIC::IDSIZE::n512);
	FAMILYBASIC::BG0_stPrint({0,0},"LESSON 07:GAME(2+)",0);
	FAMILYBASIC::BG0_stPrint({0,1},"SCORE",0);
	//	星描画
	for(UINT8 i=0;i<3;++i)for(UINT8 j=0;j<128;++j){
		CAUTO				cui16random=FAMILYBASIC::stui16GetRandom();
		CAUTO				cv2iposition=VECTOR2(cui16random&31,(cui16random>>5)&31);
		CAUTO				cui8ipattern=UINT8(0xcd+((cui16random>>10)&1));
		CAUTO				cui8ibgpalette=UINT8((cui16random>>11)&3);

		switch(i){
		case 0:
			FAMILYBASIC::BG1_stWrite(cv2iposition,cui8ipattern,cui8ibgpalette);
			break;
		case 1:
			FAMILYBASIC::BG2_stWrite(cv2iposition,cui8ipattern,cui8ibgpalette);
			break;
		case 2:
			FAMILYBASIC::BG3_stWrite(cv2iposition,cui8ipattern,cui8ibgpalette);
			break;
		}
	}
	stgameThis.New();
	return;
}

VOID					USER_Delete(VOID)noexcept{
	stgameThis.Delete();
	FAMILYBASIC::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	stgameThis.Main();
	return;
}
