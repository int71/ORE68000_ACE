#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//	GAME
class GAME;
using					CGAME=const GAME;
using					PGAME=GAME*;
using					PCGAME=CGAME*;

//
//		class:GAME
//

class GAME{
public:

	//
	//		const
	//

	//	enum class IDMODE
	//		ゲーム進行の「状態」を示す定数です。
	enum class IDMODE{
		Start,
		Normal,
		GameOver
	};
	//	UINT8					FIXEDL_stcui8nBit
	//		16bit中、6bitを「小数点値」扱いにします。
	static constexpr UINT8	FIXEDL_stcui8nBit=		6;
	//	VECTOR2					stcv2nMapBit
	//		マップデータのサイズ(キャラクタ単位)ビット幅です。
	static constexpr VECTOR2	stcv2nMapBit={7,7};
	//	VECTOR2					stcv2nMap
	//		マップデータのサイズ(キャラクタ単位)です。
	static constexpr VECTOR2	stcv2nMap={
		1<<stcv2nMapBit.i16nWidth(),
		1<<stcv2nMapBit.i16nHeight()
	};
	//	VECTOR2					stcv2cMapMask
	//		マップデータのサイズ(キャラクタ単位)に切り詰めるための、
	//		ビットマスク値です。
	static constexpr VECTOR2	stcv2cMapMask={
		stcv2nMap.i16nWidth()-1,
		stcv2nMap.i16nHeight()-1
	};
	//	UINT8					MAP_stcui8cNone
	//		ファミリーベーシック的(8ビット幅での)空白キャラクタコードです。
	static constexpr UINT8	MAP_stcui8cNone=0x20;
	//	UINT8					MAP_stcui8cFlag
	//		ファミリーベーシック的(8ビット幅での)旗キャラクタコードです。
	static constexpr UINT8	MAP_stcui8cFlag=0xc7;
	//	UINT8					MAP_stcui8cLadder
	//		ファミリーベーシック的(8ビット幅での)ハシゴキャラクタコードです。
	static constexpr UINT8	MAP_stcui8cLadder=0xd2;
	//	UINT16					stacui16cMap[]
	//		マップデータです。
	//		8ドット四方のBGキャラクタが、
	//		1キャラクタ当たり16ビットで「stcv2nMap」サイズの大きさで敷き詰められています。
	static constexpr UINT16	stacui16cMap[]=__O68K_TMX2BIN("lesson08.tmx");
	//	static constexpr UINT8	stacui8cBGM
	//		「ゲーム中BGM」の演奏データです。毎度おなじみドドッチドドッチ。
	static constexpr UINT8	BGM_stacui8cMain[]=__O68K_MAKESEQUENCE(R"(
		my($_INIT)='  C ,PG=127';

		[
			"#CHANNEL=PCM0/PCM1/PCM2,TRANSPOSE=0,PMSPEED=204",
			#=======================================	   0
			"#SPEED=1",
			"$_INIT      /$_INIT      /$_INIT      ",
			"     $PCM_Sqr11L,PN=0,PM=0,VL=127,VM=255/            /            ",
			"            /     $PCM_Sqr11L,PN=0,PM=0,VL=127,VM=255/            ",
			"            /            /     $PCM_Delta,PN=0,PM=0,VL=255,VM=255",
			"            /            /            ",
			"#SPEED=5",
			"#LABEL=LoopStart",
			"            /            / 3C ,VL=255 ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
			#=======================================	   1
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <E         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  F         ",
			"            /            /-           ",
			"            /            /  F#        ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			#=======================================	   2
			"            /            / >D         ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
			"            /            / >D         ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
			#=======================================	   3
			"            /            / >D         ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <F#        ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G#        ",
			"            /            /-           ",
			"            /            /  A         ",
			"            /            /-           ",
			#=======================================	   4
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  D         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  D         ",
			"            /            /-           ",
			#=======================================	   5
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <B         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C#        ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
			#=======================================	   6
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
