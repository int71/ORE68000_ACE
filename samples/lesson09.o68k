			"            /            /-           ",
			#=======================================	   7
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <E         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  F         ",
			"            /            /-           ",
			"            /            /  F#        ",
			"            /            /-           ",
