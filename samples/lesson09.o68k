			"            /            /            ",
			"            /            /  D         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  D         ",
			"            /            /-           ",
			#=======================================	   5
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <B         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C#        ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
			#=======================================	   6
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <G         ",
			"            /            /-           ",
			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
