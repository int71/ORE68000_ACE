			"            /            / >C         ",
			"            /            /-           ",
			"            /            /  C         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            / <E         ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
