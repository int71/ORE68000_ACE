			"            /            /            ",
			"            /            / <F#        ",
			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G#        ",
			"            /            /-           ",
			"            /            /  A         ",
			"            /            /-           ",
			#=======================================	   4
			"            /            /  G         ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
