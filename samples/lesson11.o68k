		];
	)");
	//	UINT8					SE0_stacui8cPoint[]
	//		「旗ゲット音」の演奏データです。
	static constexpr _ORDERED_("SE0-00") UINT8	SE0_stacui8cPoint[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=4",
			" 5B ,$PCM_Sqr11L,PN=0,PM=0,VL=224,VM=255",
			"  G         ",
			"#SPEED=32",
			"-           ",
		];
	)");
	//	UINT8					SE0_stacui8cTrumple[]
	//		「踏みつけ音」の演奏データです。
	static constexpr _ORDERED_("SE0-01") UINT8	SE0_stacui8cTrumple[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=4",
			" 5G ,$PCM_Sqr13S,PN=0,PM=0,VL=224,VM=255",
			" B",
			" -",
		];
	)");
	//	UINT8					SE0_stacui8cJump[]
	//		「ジャンプ音」の演奏データです。
	//		「PT=+1」は連続的音程変化、つまりポルタメントです。
	static constexpr _ORDERED_("SE0-02") UINT8	SE0_stacui8cJump[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 4C ,PT=+2,$PCM_Sqr13L,PN=0,PM=0,VL=224,VM=255",
			"#SPEED=32",
			"-D  ,PT=+64",
		];
	)");
	//	UINT8					SE0_stacui8cSlip[]
	//		「スリップ音」の演奏データです。
	static constexpr _ORDERED_("SE0-03") UINT8	SE0_stacui8cSlip[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 6C ,PT=+1,$PCM_Sqr13L,PN=0,PM=0,VL=208,VM=255",
			"#SPEED=4",
			"-D# ,PT=+4",
			"#SPEED=1",
			" C  ,PT=+1",
			"#SPEED=16",
			"-D# ,PT=+16",
		];
	)");
	//	UINT8					SE0_stacui8cWalk0[]
	//		「歩行音(1)」の演奏データです。
	static constexpr _ORDERED_("SE0-04") UINT8	SE0_stacui8cWalk0[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 3E ,$PCM_Sqr13L,PN=0,PM=0,VL=224,VM=255",
			"-E",
		];
	)");
	//	UINT8					SE0_stacui8cWalk1[]
	//		「歩行音(2)」の演奏データです。
	static constexpr _ORDERED_("SE0-04") UINT8	SE0_stacui8cWalk1[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 3G ,$PCM_Sqr13L,PN=0,PM=0,VL=224,VM=255",
			"-G",
		];
	)");
	//	UINT8					SE0_stacui8cLadder0[]
	//		「ハシゴ昇降音(1)」の演奏データです。
	static constexpr _ORDERED_("SE0-04") UINT8	SE0_stacui8cLadder0[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 3C ,PT=+1,$PCM_Sqr13L,PN=0,PM=0,VL=212,VM=255",
			"-C# ,PT=+1",
		];
	)");
	//	UINT8					SE0_stacui8cLadder1[]
	//		「ハシゴ昇降音(2)」の演奏データです。
	static constexpr _ORDERED_("SE0-04") UINT8	SE0_stacui8cLadder1[]=__O68K_MAKESEQUENCE(R"(
		[
			"#CHANNEL=PCM3",
			#=============	   0
			"#SPEED=1",
			" 3G ,PT=+1 ,$PCM_Sqr13L,PN=0,PM=0,VL=212,VM=255",
			"-G# ,PT=+1",
