//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//	GAME
class GAME;
using					CGAME=const GAME;
using					PGAME=GAME*;
using					PCGAME=CGAME*;

//
//		class:GAME
//

class GAME{
public:

	//
	//		const
	//

	//	enum class IDMODE
	//		ゲーム進行の「状態」を示す定数です。
	enum class IDMODE{
		Start,
		Normal,
		GameOver
	};
	//	UINT8					stcui8nDiscardBit
	//		「固定小数点値」中の何ビットを「小数点値」扱いにするかを示します。
	//		ここでは16bit中6bitを「小数点値」扱いにします。
	static constexpr UINT8	stcui8nDiscardBit=6;
	//	INT16					stci16iOne
	//		整数「1」に相当する固定小数点値です。
	static constexpr INT16	stci16iOne=1<<stcui8nDiscardBit;
	//	INT16					stci16cDiscardMask
	//		「小数点値」部分のマスクです。
	static constexpr INT16	stci16cDiscardMask=stci16iOne-1;
	//	UINT8					CONTROLLER_stcui8cRight
	//		コントローラ「右移動操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cRight=FAMILYBASIC::stcui8cMaskButtonRight;
	//	UINT8					CONTROLLER_stcui8cLeft
	//		コントローラ「左移動操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cLeft=FAMILYBASIC::stcui8cMaskButtonLeft;
	//	UINT8					CONTROLLER_stcui8cDown
	//		コントローラ「下移動操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cDown=FAMILYBASIC::stcui8cMaskButtonDown;
	//	UINT8					CONTROLLER_stcui8cUp
	//		コントローラ「上移動操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cUp=FAMILYBASIC::stcui8cMaskButtonUp;
	//	UINT8					CONTROLLER_stcui8cJump
	//		コントローラ「ジャンプ操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cJump=FAMILYBASIC::stcui8cMaskButtonA;
	//	UINT8					CONTROLLER_stcui8cDash
	//		コントローラ「ダッシュ操作」入力ビットを示すマスク値です。
	static constexpr AUTO	CONTROLLER_stcui8cDash=FAMILYBASIC::stcui8cMaskButtonB;
	//	VECTOR2					MAP_stcv2nSizeBit
	//		マップデータのサイズ(キャラクタ単位)ビット幅です。
	static constexpr VECTOR2	MAP_stcv2nSizeBit={7,7};
	//	VECTOR2					MAP_stcv2nSize
	//		マップデータのサイズ(キャラクタ単位)です。
	static constexpr VECTOR2	MAP_stcv2nSize={
		1<<MAP_stcv2nSizeBit.i16nWidth(),
		1<<MAP_stcv2nSizeBit.i16nHeight()
	};
	//	VECTOR2					MAP_stcv2cSizeMask
	//		マップデータのサイズ(キャラクタ単位)に切り詰めるための、
	//		ビットマスク値です。
	static constexpr VECTOR2	MAP_stcv2cSizeMask={
		MAP_stcv2nSize.i16nWidth()-1,
		MAP_stcv2nSize.i16nHeight()-1
	};
	//	UINT8					MAP_stcui8cNone
	//		ファミリーベーシック的(8ビット幅での)空白キャラクタコードです。
	static constexpr UINT8	MAP_stcui8cNone=0x20;
	//	UINT8					MAP_stcui8cFlag
	//		ファミリーベーシック的(8ビット幅での)旗キャラクタコードです。
	static constexpr UINT8	MAP_stcui8cFlag=0xc7;
	//	UINT8					MAP_stcui8cLadder
	//		ファミリーベーシック的(8ビット幅での)ハシゴキャラクタコードです。
	static constexpr UINT8	MAP_stcui8cLadder=0xd2;
	//	UINT16					MAP_stacui16cAttribute[]
	//		マップデータです。
	//		8ドット四方のBGキャラクタが、
	//		1キャラクタ当たり16ビットで「MAP_stcv2nSize」サイズの大きさで敷き詰められています。
	static constexpr UINT16	MAP_stacui16cAttribute[]=__O68K_TMX2BIN("lesson11_MAP.tmx");
	//	VECTOR2					BG_stcv2nSizeBit
	//		背景データのサイズ(キャラクタ単位)ビット幅です。
	static constexpr VECTOR2	BG_stcv2nSizeBit={6,6};
	//	VECTOR2					BG_stcv2nSize
	//		背景データのサイズ(キャラクタ単位)です。
	static constexpr VECTOR2	BG_stcv2nSize={
		1<<BG_stcv2nSizeBit.i16nWidth(),
		1<<BG_stcv2nSizeBit.i16nHeight()
	};
	//	VECTOR2					BG_stcv2cSizeMask
	//		背景データのサイズ(キャラクタ単位)に切り詰めるための、
	//		ビットマスク値です。
	static constexpr VECTOR2	BG_stcv2cSizeMask={
		BG_stcv2nSize.i16nWidth()-1,
		BG_stcv2nSize.i16nHeight()-1
	};
	//	UINT16					BG_stacui16cAttribute[]
	//		背景データです。
	//		8ドット四方のBGキャラクタが、
	//		1キャラクタ当たり16ビットで「BG_stcv2nSize」サイズの大きさで敷き詰められています。
	static constexpr UINT16	BG_stacui16cAttribute[]=__O68K_TMX2BIN("lesson11_BG.tmx");
	//	UINT8					ENEMY_stcui8nInstanceMaximum
	//		「敵最大数」です。
	static constexpr UINT8	ENEMY_stcui8nInstanceMaximum=64;
	//	UINT8					BGM_stacui8cMain[]
	//		「ゲーム中BGM」の演奏データです。毎度おなじみドドッチドドッチ。
	static constexpr UINT8	BGM_stacui8cMain[]=__O68K_MAKESEQUENCE(R"(
		my($_INIT)='  C ,PG=127';

		[
			"#CHANNEL=PCM0/PCM1/PCM2,TRANSPOSE=0,PMSPEED=204",
			#=======================================	   0
			"#SPEED=1",
			"$_INIT      /$_INIT      /$_INIT      ",
			"     $PCM_Sqr11L,PN=0,PM=0,VL=127,VM=255/            /            ",
			"            /     $PCM_Sqr11L,PN=0,PM=0,VL=127,VM=255/            ",
			"            /            /     $PCM_Delta,PN=0,PM=0,VL=255,VM=255",
			"            /            /            ",
			"#SPEED=5",
			"#LABEL=LoopStart",
			"            /            / 3C ,VL=255 ",
			"            /            /-           ",
			"            /            /  C         ",
