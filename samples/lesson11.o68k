			"            /            /-           ",
			"            /            /            ",
			"            /            /            ",
			"            /            /  F         ",
			"            /            /-           ",
			"            /            /  F#        ",
			"            /            /-           ",
			"            /            /  G         ",
			"            /            /-           ",
			#=======================================	   2
			"            /            / >D         ",
			"            /            /-           ",
			"            /            /  D         ",
			"            /            /-           ",
