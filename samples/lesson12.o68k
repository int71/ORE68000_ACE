		           { 2, 6, 0},{ 4, 6, 0},{ 6, 6, 0},{ 8, 6, 0},{10, 6, 0},{12, 6, 0},{14, 6, 0},{16, 6, 0},{18, 6, 0},{20, 6, 0},{22, 6, 0},{24, 6, 0},
		{ 0, 7, 0},{ 2, 8, 0},{ 4, 8, 0},{ 6, 8, 0},{ 8, 8, 0},{10, 8, 0},{12, 8, 0},{14, 8, 0},{16, 8, 0},{18, 8, 0},{20, 8, 0},{22, 8, 0},{24, 8, 0},{26, 7, 0},{28, 7, 0},
