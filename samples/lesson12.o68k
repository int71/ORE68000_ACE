	//	UINT8					GAME_staacui8iPattern[144][2]
	//		牌と絵柄パターンの対応を保持します。
	//		「{横,縦}」を単位として、牌144ヶ分あります。
	//		縦横の値は「lesson12_BITMAP.png」の座標に対応しており、
	//		わざわざ1牌単位で対応させているのは、
	//		「季節」と「花」が4牌別絵柄であるためです。
	static constexpr UINT8	GAME_staacui8iPattern[][2]={
		{0x00,0x00},{0x00,0x00},{0x00,0x00},{0x00,0x00},	//	一萬
		{0x20,0x00},{0x20,0x00},{0x20,0x00},{0x20,0x00},	//	二萬
		{0x40,0x00},{0x40,0x00},{0x40,0x00},{0x40,0x00},	//	三萬
		{0x60,0x00},{0x60,0x00},{0x60,0x00},{0x60,0x00},	//	四萬
		{0x80,0x00},{0x80,0x00},{0x80,0x00},{0x80,0x00},	//	伍萬
		{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},	//	六萬
		{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},	//	七萬
		{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},	//	八萬
		{0x00,0x30},{0x00,0x30},{0x00,0x30},{0x00,0x30},	//	九萬
		{0x20,0x30},{0x20,0x30},{0x20,0x30},{0x20,0x30},	//	一索
		{0x40,0x30},{0x40,0x30},{0x40,0x30},{0x40,0x30},	//	二索
		{0x60,0x30},{0x60,0x30},{0x60,0x30},{0x60,0x30},	//	三索
		{0x80,0x30},{0x80,0x30},{0x80,0x30},{0x80,0x30},	//	四索
		{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},	//	伍索
		{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},	//	六索
		{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},	//	七索
		{0x00,0x60},{0x00,0x60},{0x00,0x60},{0x00,0x60},	//	八索
		{0x20,0x60},{0x20,0x60},{0x20,0x60},{0x20,0x60},	//	九索
		{0x40,0x60},{0x40,0x60},{0x40,0x60},{0x40,0x60},	//	一筒
		{0x60,0x60},{0x60,0x60},{0x60,0x60},{0x60,0x60},	//	二筒
		{0x80,0x60},{0x80,0x60},{0x80,0x60},{0x80,0x60},	//	三筒
		{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},	//	四筒
		{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},	//	伍筒
		{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},	//	六筒
		{0x00,0x90},{0x00,0x90},{0x00,0x90},{0x00,0x90},	//	七筒
		{0x20,0x90},{0x20,0x90},{0x20,0x90},{0x20,0x90},	//	八筒
		{0x40,0x90},{0x40,0x90},{0x40,0x90},{0x40,0x90},	//	九筒
		{0x60,0x90},{0x60,0x90},{0x60,0x90},{0x60,0x90},	//	東
		{0x80,0x90},{0x80,0x90},{0x80,0x90},{0x80,0x90},	//	南
		{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},	//	西
		{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},	//	北
		{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},	//	白板
		{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},	//	緑發
		{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},	//	紅中
		{0x40,0xc0},{0x60,0xc0},{0x80,0xc0},{0xa0,0xc0},	//	季節
		{0xc0,0xc0},{0xe0,0xc0},{0x00,0xf0},{0x20,0xf0}		//	花
	};
	static constexpr UINT8	GAME_stcui8nTile=UINT8(SIZEOF(GAME_staacui8iPattern)/(SIZEOF(UINT8)*2));
	static constexpr UINT8	GAME_stcui8nWidth=15*2;
	static constexpr UINT8	GAME_stcui8nHeight=8*2;
	static constexpr UINT8	GAME_stcui8nLayer=5;
	static constexpr UINT8	GAME_stcui8nDifficulty=0;
	static constexpr UINT8	GAME_stcui8iTileUndefined=0xff;
	static constexpr UINT16	GAME_stcui16cTilePartMask=0x0300;
	static constexpr UINT16	GAME_stcui16cTilePartLU=0x0000;
	static constexpr UINT16	GAME_stcui16cTilePartRU=0x0100;
	static constexpr UINT16	GAME_stcui16cTilePartLD=0x0200;
	static constexpr UINT16	GAME_stcui16cTilePartRD=0x0300;
	static constexpr UINT16	GAME_stcui16cTileSelectedMask=0x0400;
	static constexpr UINT8	IMAGE_stcui8nUnitWidth=16;
	static constexpr UINT8	IMAGE_stcui8nUnitHeight=24;
	static constexpr UINT8	IMAGE_stcui8nPerspectiveWidth=4;
	static constexpr UINT8	IMAGE_stcui8nPerspectiveHeight=8;
	static constexpr UINT8	IMAGE_stcui8nShadowWidth=8;
	static constexpr UINT8	IMAGE_stcui8nShadowHeight=8;
	static constexpr UINT8	IMAGE_stcui8nFaceAlphaWidth=4;
	static constexpr UINT8	IMAGE_stcui8nFaceAlphaHeight=4;
	static constexpr AUTO	IMAGE_stcv2nUnit=VECTOR2(INT16(IMAGE_stcui8nUnitWidth),INT16(IMAGE_stcui8nUnitHeight));
	static constexpr AUTO	IMAGE_stcv2iSideR=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*3,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iSideD=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*3+8,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iSideRD=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*4+8,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iShadow=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*4-8,INT16(IMAGE_stcui8nUnitHeight*2)*6-8);

	static constexpr AUTO	IMAGE_stcv2iSelected=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*2,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	//	CANVAS_RGBA_ROM			IMAGE_stccvsTile
	//		牌絵柄ビットマップデータを保持します。
	//		横32、縦48ドット単位で並べています。
	//		「-cm 0」は減色方法指示で、「0」は「単純切り捨て」です。
	//		「1」の誤差拡散はちょっとノイジーだったんで。
	static _INLINE_ CAUTO	IMAGE_stccvsTile=__O68K_CANVAS_RGBA_ROM("(Resource)/牌_BITMAP_TILE.png","-cm 0");
#ifdef SHOWBACKBITMAP
	static _INLINE_ CAUTO	IMAGE_stccvsBack=__O68K_CANVAS_RGB_ROM("(Resource)/床面_BITMAP.png");
#else
	static constexpr UINT16	stcui16cColorBack=0x141;
#endif
	static constexpr UINT8	SCREEN_stcui8iXBasis=10;
	static constexpr UINT8	SCREEN_stcui8iYBasis=6;

	//
	//		クラス
	//

	class MOUSESTATE;
	using					CMOUSESTATE=const MOUSESTATE;
	using					PMOUSESTATE=MOUSESTATE*;
	using					PCMOUSESTATE=CMOUSESTATE*;

	//
	//		クラス:MOUSESTATE
	//

	//	MOUSESTATE
	class MOUSESTATE{
	public:
		VECTOR2					v2iCursor;
		UINT16					ui16cButtonCurrent;
		UINT16					ui16cButtonSingle;
		OFWBOOL					eBusy;
	};

	//
	//		定義本体:USER
	//

private:
	static _INLINE_ MOUSESTATE	MOUSE_ststatState;
	//	UINT16					GAME_staaaui16cTile[stcui8nLayer][stcui8nHeight][stcui8nWidth]
	//		牌の配置状況を保持します。
	//		「半分ずらし」があるので牌1つで田の字「2x2」の領域を占めます。
	//		位置0～7の8ビットは牌個体識別で、「0」は無し(空白)、「1～144」が牌通し番号になります。
	//		位置8～9の2ビットは田の字中の位置を示し、左上0、右上1、左下2、右下を設定します。
	//		これにより、配列1要素だけで牌の位置が分かります。
	static _INLINE_ UINT16	GAME_staaaui16cTile[GAME_stcui8nLayer][GAME_stcui8nHeight][GAME_stcui8nWidth];
	//	CANVAS_RGB_RAM			OFF_stcvsOne
	//		非表示状態処理するためのバッファです。
	//		牌の大きさは32x48ドットですが、
	//		「半分ずらし」があるので処理単位は16x24ドットにしています。
	static _INLINE_ AUTO	OFF_stcvsOne=CANVAS_RGB_RAM<UINT16(IMAGE_stcui8nUnitWidth),UINT16(IMAGE_stcui8nUnitHeight)>();
	static _INLINE_ OFWBOOL	OFF_steUpdated;
	//	VECTOR2					SCREEN_stv2iOne
	//		描画位置を画面座標で保持します。
	static _INLINE_ VECTOR2	SCREEN_stv2iOne;
public:
	static VOID				stNew(VOID)noexcept{
		constexpr UINT8			pattern_acui8ccursor[]=__O68K_PATTERN("(Resource)/00_SPRITE_CURSOR.png");
		constexpr UINT16		palette_acui16ccursor[]=__O68K_PALETTE("(Resource)/00_SPRITE_CURSOR.png");
		constexpr UINT8			pattern_acui8cgame[]=__O68K_PATTERN("(Resource)/10_SPRITE_lesson12.png");
		constexpr UINT16		palette_acui16cgame[]=__O68K_PALETTE("(Resource)/10_SPRITE_lesson12.png");

		MOUSE_ststatState.v2iCursor={320,240};
		MOUSE_ststatState.ui16cButtonCurrent=0x0000;
		MOUSE_ststatState.eBusy=TRUE;
		GRAPHIC::stNew(TRUE);
		GRAPHIC::PALETTE_stWrite(0x01,palette_acui16ccursor+1,15);
		GRAPHIC::PALETTE_stWrite(0x11,palette_acui16cgame+1,15);
		GRAPHIC::PATTERN_SPRITE_stWrite(0,8,pattern_acui8ccursor);
		GRAPHIC::PATTERN_SPRITE_stWrite(8,8,pattern_acui8cgame);
		GRAPHIC::VBLANK_stSetCallback(VBLANK_stCallback,NULL);
#ifdef SHOWBACKBITMAP
		GRAPHIC::stCopy(IMAGE_stccvsBack,VECTOR2::stv2ImmediateZero());
#else
		GRAPHIC::stFill(stcui16cColorBack);
#endif
		return;
	}
	static VOID				stDelete(VOID)noexcept{
		GRAPHIC::stDelete();
		return;
	}
	static _INLINE_ MOUSESTATE	MOUSE_ststatGetState(VOID)noexcept{
		return MOUSE_ststatState;
	}
	static _INLINE_ VOID	MOUSE_stSetBusy(COFWBOOL cebusy)noexcept{
		MOUSE_ststatState.eBusy=cebusy;
		return;
	}
	static VOID				GAME_stArrange(CUINT32 cui32cseed=0)noexcept{
		//	UINT8&					aacui8iposition[144][3]
		//		複数配置対応しやすいよう、別名設定しておく。
		CAUTO&					aacui8iposition=GAME_staacui8iPosition;
		//	UINT8					aui8iarrange[144]
		//		「0～143」の「配置番号」を混ぜた状態で保持します。
		//		混ぜるのは解のバリエーションを持たせるためです。
		UINT8					aui8iarrange[GAME_stcui8nTile];
		UINT8					aui8itile[GAME_stcui8nTile];
		//	UINT8					ui8itile
		//		次に設置する「牌番号」を保持します。
		//		配置進捗と見なせます。
		UINT8					ui8itile;
		CAUTO&					cfp_searchone=[&](UINT8& ui8ilocal,UINT8& ui8ix,UINT8& ui8iy,UINT8& ui8ilayer,UINT8& ui8ndistance)noexcept{
			for(;ui8ilocal<GAME_stcui8nTile;++ui8ilocal){
				CAUTO					cui8iarrange=aui8iarrange[ui8ilocal];

				if(cui8iarrange!=GAME_stcui8iTileUndefined){
					CAUTO&					acui8iposition=aacui8iposition[cui8iarrange];

					//	配置番号は「済」ではなかった
					ui8ix=acui8iposition[0];
					ui8iy=acui8iposition[1];
					ui8ilayer=acui8iposition[2];
					if(GAME_steArrange_IsSettable(ui8ix,ui8iy,ui8ilayer,ui8ndistance))break;
				}
			}
			return;
		};
		CAUTO&					cfp_searchpair=[&](UINT8& ui8ilocal0,UINT8& ui8ix0,UINT8& ui8iy0,UINT8& ui8ilayer0,UINT8& ui8ilocal1,UINT8& ui8ix1,UINT8& ui8iy1,UINT8& ui8ilayer1,UINT8& ui8ndistance)noexcept{
			UINT8					ui8ndistance1;

			cfp_searchone(ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0,ui8ndistance);
			if(ui8ilocal0<GAME_stcui8nTile){
				for(ui8ilocal1=ui8ilocal0+1;ui8ilocal1<GAME_stcui8nTile;++ui8ilocal1){
					cfp_searchone(ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance1);
					if(ui8ilocal1<GAME_stcui8nTile){
						//	牌2つ目も「配置可能」であった。
						//	ただし、「同じ高さで離れている」ような状況なら配置してはならないので、
						//	牌1つ目を「仮配置」して再チェックする。
						GAME_stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(0x0001),TRUE);
						{
							CAUTO			cesettable=GAME_steArrange_IsSettable(ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance1);

							GAME_stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(GAME_stcui8iTileUndefined),TRUE);
							if(cesettable){
								ui8ndistance=STD::stxGetMinimum(ui8ndistance,ui8ndistance1);
								return;
							}
						}
					}
				}
			}
			ui8ilocal1=GAME_stcui8nTile;
			return;
		};

		OS::LFSR_stSetSeed(cui32cseed);
		STD::stFill(GAME_staaaui16cTile,SIZEOF(GAME_staaaui16cTile),0x00);
		do{
			//	実は「追加配置不可」の状況に陥る場合があるため、
			//	やり直し想定でループにしておきます。
			for(UINT8 ui8iarrange=0;ui8iarrange<GAME_stcui8nTile;++ui8iarrange){
				CAUTO&					acui8iposition=aacui8iposition[ui8iarrange];

				//	左右方向への走査を行えるよう、
				//	「GAME_stcui16cTileTemporaryMask」付きで「田の字」属性を設定。
				GAME_stWriteTile4(
					acui8iposition[0],		//	cui8ix
					acui8iposition[1],		//	cui8iy
					acui8iposition[2],		//	cui8ilayer
					UINT16(GAME_stcui8iTileUndefined),	//	cui16ctile
					TRUE					//	cepart
				);
				//	ついでに配置番号を「整列状態」で設定
				aui8iarrange[ui8iarrange]=ui8iarrange;
				aui8itile[ui8iarrange]=ui8iarrange+1;
			}
			//	混ぜる事で「0～143」出現順をランダムに
			for(UINT8 ui8ilocal=0;ui8ilocal<GAME_stcui8nTile;++ui8ilocal){
				CAUTO					cui8ilocal_source=stui8Random<GAME_stcui8nTile>();
				CAUTO					cui8iarrange_source=aui8iarrange[cui8ilocal_source];

				aui8iarrange[cui8ilocal_source]=aui8iarrange[ui8ilocal];
				aui8iarrange[ui8ilocal]=cui8iarrange_source;
			}
			//	牌4つセットでの混ぜ(難易度無関係)
			{
				constexpr AUTO			cui8npair4=UINT8(GAME_stcui8nTile>>2);

				for(UINT8 ui8ilocal=0;ui8ilocal<cui8npair4;++ui8ilocal){
					CAUTO					cui8ilocal4=ui8ilocal<<2;
					CAUTO					cui8ilocal4_source=UINT8(stui8Random<cui8npair4>()<<2);
					CAUTO					cui8itile_source0=aui8itile[cui8ilocal4_source+0];
					CAUTO					cui8itile_source1=aui8itile[cui8ilocal4_source+1];
					CAUTO					cui8itile_source2=aui8itile[cui8ilocal4_source+2];
					CAUTO					cui8itile_source3=aui8itile[cui8ilocal4_source+3];

					aui8itile[cui8ilocal4_source+0]=aui8itile[cui8ilocal4+0];
					aui8itile[cui8ilocal4_source+1]=aui8itile[cui8ilocal4+1];
					aui8itile[cui8ilocal4_source+2]=aui8itile[cui8ilocal4+2];
					aui8itile[cui8ilocal4_source+3]=aui8itile[cui8ilocal4+3];
					aui8itile[cui8ilocal4+0]=cui8itile_source0;
					aui8itile[cui8ilocal4+1]=cui8itile_source1;
					aui8itile[cui8ilocal4+2]=cui8itile_source2;
					aui8itile[cui8ilocal4+3]=cui8itile_source3;
				}
			}
			//	牌2つセットでの混ぜ(難易度左右する)
			{
				constexpr AUTO			cui8npair2=UINT8(GAME_stcui8nTile>>1);

				for(UINT8 ui8ilocal=0;ui8ilocal<GAME_stcui8nDifficulty;++ui8ilocal){
					CAUTO					cui8ilocal2_destination=UINT8(stui8Random<cui8npair2>()<<1);
					CAUTO					cui8ilocal2_source=UINT8(stui8Random<cui8npair2>()<<1);
					CAUTO					cui8itile_source0=aui8itile[cui8ilocal2_source+0];
					CAUTO					cui8itile_source1=aui8itile[cui8ilocal2_source+1];

					aui8itile[cui8ilocal2_source+0]=aui8itile[cui8ilocal2_destination+0];
					aui8itile[cui8ilocal2_source+1]=aui8itile[cui8ilocal2_destination+1];
					aui8itile[cui8ilocal2_destination+0]=cui8itile_source0;
					aui8itile[cui8ilocal2_destination+1]=cui8itile_source1;
				}
			}
			//	配置情報に従って置き場所を決め、
			//	「設置して良いかどうか」を、左右の空き、下層の牌有無で判定。
			//	2牌1組で置き場所を決めるのがミソ。
			//	「処理が進まないと配置出来ない」位置もあるため、
			//	配置ループは数度回る事が前提。
			ui8itile=0;
			while(ui8itile<GAME_stcui8nTile){
				//	UINT8					cui8itile_start
				//		配置ループ開始前の「牌番号」を保持します。
				//		「進捗有無」判定に使います。
				CAUTO					cui8itile_start=ui8itile;

				for(UINT8 ui8ilocal=0;ui8ilocal<GAME_stcui8nTile;++ui8ilocal){
					UINT8					ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0;
					UINT8					ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1;
					UINT8					ui8ndistance;

					//	ここから実配置開始。
					//	恐らく、ループは一度で完了しない。
					//	とりあえず「配置可能」の候補2つをゲットする。
					//	「左右空きが大きい」方から埋めていく事で「追加配置不可」の状況を起きにくくする。
					ui8ilocal0=ui8ilocal;
					cfp_searchpair(ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0,ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance);
					if(ui8ilocal1<GAME_stcui8nTile){
						{
							UINT8					ui8ilocal0d,ui8ix0d,ui8iy0d,ui8ilayer0d;
							UINT8					ui8ilocal1d,ui8ix1d,ui8iy1d,ui8ilayer1d;
							UINT8					ui8ndistanced;

							ui8ilocal0d=ui8ilocal1+1;
							cfp_searchpair(ui8ilocal0d,ui8ix0d,ui8iy0d,ui8ilayer0d,ui8ilocal1d,ui8ix1d,ui8iy1d,ui8ilayer1d,ui8ndistanced);
							if(ui8ilocal1d<GAME_stcui8nTile){
								if(ui8ndistance<ui8ndistanced){
									ui8ilocal0=		ui8ilocal0d;
									ui8ix0=			ui8ix0d;
									ui8iy0=			ui8iy0d;
									ui8ilayer0=		ui8ilayer0d;
									ui8ilocal1=		ui8ilocal1d;
									ui8ix1=			ui8ix1d;
									ui8iy1=			ui8iy1d;
									ui8ilayer1=		ui8ilayer1d;
									ui8ndistance=	ui8ndistanced;
								}
							}
						}
						//	無事牌2つ目も「配置可能」で確定できたので、処理済みにマーク
						aui8iarrange[ui8ilocal0]=GAME_stcui8iTileUndefined;
						aui8iarrange[ui8ilocal1]=GAME_stcui8iTileUndefined;
#ifdef SHOWARRANGEPROGRESS
						GAME_stWriteTile(ui8ix0,ui8iy0,ui8ilayer0,aui8itile[ui8itile],TRUE);++ui8itile;
						GAME_stWriteTile(ui8ix1,ui8iy1,ui8ilayer1,aui8itile[ui8itile],TRUE);++ui8itile;
#else
						GAME_stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(aui8itile[ui8itile]),TRUE);++ui8itile;
						GAME_stWriteTile4(ui8ix1,ui8iy1,ui8ilayer1,UINT16(aui8itile[ui8itile]),TRUE);++ui8itile;
#endif
						ui8ilocal=ui8ilocal1;
					}
				}
				if(ui8itile==cui8itile_start){
					//	ここに至ったという事は進捗ゼロであったという事。
					//	不幸にも「追加配置不可」の状況に陥った。
					break;
				}
			}
		}while(ui8itile<GAME_stcui8nTile);
		return;
	}
	//	VOID					GAME_stWriteTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile,COFWBOOL ceupdate)
	//		牌の配置状況「GAME_staaaui16cTile」に対し、
	//		横「cui8ix」、縦「cui8iy」、高さ「cui8ilayer」で通し番号「cui8itile」の牌を設定します。
	//		「cui8itile」を「0」で呼び出すと、牌が除去されます。
	//		牌設定、除去共に「2x2」単位で処理を行うので田の字4回呼び出しは不要です。
	//		「ceupdate」に「TRUE」を指定すると表示更新も行います。
	static VOID				GAME_stWriteTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile,COFWBOOL ceupdate=TRUE)noexcept{
		if(cui8itile){
			GAME_stWriteTile4(cui8ix,cui8iy,cui8ilayer,UINT16(cui8itile),TRUE);
			if(ceupdate)SCREEN_stDraw(cui8ix,cui8iy,cui8ilayer);
		}else{
			if(
				AUTO					ui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
				ui16ctile
			){
				AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

				GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
				GAME_stWriteTile4(ui8ix,ui8iy,cui8ilayer,0x0000,FALSE);
				if(ceupdate)SCREEN_stDraw(ui8ix,ui8iy,cui8ilayer);
			}
		}
		return;
	}
	static OFWBOOL			GAME_steIsSelectable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		if(
			AUTO					ui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
			ui16ctile
		){
			AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

			GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			if(
				(cui8ilayer+1<GAME_stcui8nLayer)?(
					(GAME_staaaui16cTile[cui8ilayer+1][cui8iy+0][cui8ix+0]==0x0000)&&
					(GAME_staaaui16cTile[cui8ilayer+1][cui8iy+0][cui8ix+1]==0x0000)&&
					(GAME_staaaui16cTile[cui8ilayer+1][cui8iy+1][cui8ix+0]==0x0000)&&
					(GAME_staaaui16cTile[cui8ilayer+1][cui8iy+1][cui8ix+1]==0x0000)
				):TRUE
			)return OFWBOOL((2<=ui8ix)?(
				(GAME_staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix-1]==0x0000)&&
				(GAME_staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix-1]==0x0000)
			):TRUE)||OFWBOOL((ui8ix+2<GAME_stcui8nWidth)?(
				(GAME_staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+2]==0x0000)&&
				(GAME_staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+2]==0x0000)
			):TRUE);
		}
		return FALSE;
	}
	static VOID				GAME_stSelectTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL ceselected,COFWBOOL ceupdate=TRUE)noexcept{
		if(
			AUTO					ui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
			ui16ctile
		){
			AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

			GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			GAME_stWriteTile4(
				ui8ix,ui8iy,cui8ilayer,
				ceselected?(ui16ctile|GAME_stcui16cTileSelectedMask):(ui16ctile&~GAME_stcui16cTileSelectedMask),
				TRUE
			);
			if(ceupdate)SCREEN_stDrawFace(ui8ix,ui8iy,cui8ilayer);
		}
		return;
	}
	static _INLINE_ UINT16	GAME_stui16cGetTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
#ifdef SHOWARRANGEPROGRESS
		CAUTO					cui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];

		return ((cui16ctile&0xff)!=GAME_stcui8iTileUndefined)?cui16ctile:0x0000;
#else
		return GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
#endif
	}
	static UINT16			GAME_stui16cGetTilebyScreenPosition(UINT8& ui8ix,UINT8& ui8iy,UINT8& ui8ilayer,CVECTOR2& cv2iposition)noexcept{
		//	通常高さでのチェック
		for(UINT8 ui8ilayer1=GAME_stcui8nLayer;0<ui8ilayer1;--ui8ilayer1){
			CAUTO				cui8ilayer=UINT8(ui8ilayer1-1);

			if(
				CAUTO					cv2ipoint=cv2iposition+SCREEN_stv2dGetOffset(INT8(cui8ilayer));
				(0<=cv2ipoint.i16iX())&&
				(cv2ipoint.i16iX()<INT16(GAME_stcui8nWidth)*INT16(IMAGE_stcui8nUnitWidth))&&
				(0<=cv2ipoint.i16iY())&&
				(cv2ipoint.i16iY()<INT16(GAME_stcui8nHeight)*INT16(IMAGE_stcui8nUnitHeight))
			){
				ui8ix=UINT8(cv2ipoint.i16iX()/USER::IMAGE_stcui8nUnitWidth);
				ui8iy=stui8Divide24(UINT16(cv2ipoint.i16iY()));
				for(UINT8 ui8ilayer1_over=GAME_stcui8nLayer;cui8ilayer<ui8ilayer1_over;--ui8ilayer1_over){
					ui8ilayer=UINT8(ui8ilayer1_over-1);
					if(
						AUTO					ui16ctile=GAME_staaaui16cTile[ui8ilayer][ui8iy][ui8ix];
						ui16ctile
					){
						GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
						return ui16ctile;
					}
				}
			}
		}
		//	床面でのチェック(1段目の横っ面チェック)
		ui8ilayer=0;
		if(
			CAUTO					cv2ipoint=cv2iposition+SCREEN_stv2dGetOffset(-1);
			(0<=cv2ipoint.i16iX())&&
			(cv2ipoint.i16iX()<INT16(GAME_stcui8nWidth)*INT16(IMAGE_stcui8nUnitWidth))&&
			(0<=cv2ipoint.i16iY())&&
			(cv2ipoint.i16iY()<INT16(GAME_stcui8nHeight)*INT16(IMAGE_stcui8nUnitHeight))
		){
			ui8ix=UINT8(cv2ipoint.i16iX()/USER::IMAGE_stcui8nUnitWidth);
			ui8iy=stui8Divide24(UINT16(cv2ipoint.i16iY()));
			if(
				AUTO					ui16ctile=GAME_staaaui16cTile[0][ui8iy][ui8ix];
				ui16ctile
			){
				GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
				return ui16ctile;
			}
		}
		return 0x0000;
	}
	static _INLINE_ VECTOR2	SCREEN_stv2dGetOffset(CINT8 ci8ilayer)noexcept{
		return {
			INT16(INT16(ci8ilayer)*INT16(IMAGE_stcui8nPerspectiveWidth)-(INT16(SCREEN_stcui8iXBasis)<<3)),
			INT16(INT16(ci8ilayer)*INT16(IMAGE_stcui8nPerspectiveHeight)-(INT16(SCREEN_stcui8iYBasis)<<3))
		};
	}
	static VECTOR2			SCREEN_stv2iGetPosition(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		return VECTOR2(
			INT16(cui8ix)*INT16(USER::IMAGE_stcui8nUnitWidth),
			INT16(cui8iy)*INT16(USER::IMAGE_stcui8nUnitHeight)
		)-SCREEN_stv2dGetOffset(INT8(cui8ilayer));
	}
	//	VOID					SCREEN_stDraw(VOID)
	//		全画面更新します。
	//		残念な事に遅いので、初期表示時以外は位置指定するようにしてください。
	static VOID				SCREEN_stDraw(VOID)noexcept{
		for(UINT8 ui8iy=0;ui8iy<GAME_stcui8nHeight+2;++ui8iy){
			for(UINT8 ui8ix=0;ui8ix<GAME_stcui8nWidth+2;++ui8ix){
				SCREEN_stDraw_Layered(ui8ix,ui8iy,GAME_stcui8nLayer-1);
			}
		}
		return;
	}
	//	VOID					SCREEN_stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		位置「(cui8ix,cui8iy)」、高さ「cui8ilayer」にある牌に関連する領域の表示更新を行います。
	//		更新を行う「領域」は画面座標であり、高さが下る度パース的には「右下」に伸びるため、
	//		牌管理情報的には「左上」に遡ります。
	//		また、横っ面、影の更新も行うため、「右下」への拡張も行います。
	static _INLINE_ VOID	SCREEN_stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	もし牌があるなら左上起点になるよう補正
		if((cui8ix<GAME_stcui8nWidth)&&(cui8iy<GAME_stcui8nHeight))if(
			AUTO					ui16ctile=GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer);
			ui16ctile
		)GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
		//	横っ面と影で右「(4+8)*(段番号+1)」ドット、下「(8+8)*(段番号+1)」ドット拡大があるので、
		//	その表示範囲をカバーすべく、処理範囲を決定。
		{
			CAUTO					ci16nextensionwidth=INT16((INT16(IMAGE_stcui8nPerspectiveWidth+IMAGE_stcui8nShadowWidth))*INT16(cui8ilayer+1)+INT16(IMAGE_stcui8nUnitWidth*2));

			for(
				AUTO					i16nextensionheight=INT16(INT16(IMAGE_stcui8nPerspectiveHeight+IMAGE_stcui8nShadowHeight)*INT16(cui8ilayer+1)+INT16(IMAGE_stcui8nUnitHeight*2));
				0<i16nextensionheight;
				i16nextensionheight-=INT16(IMAGE_stcui8nUnitHeight)
			){
				AUTO					ui8ix_current=ui8ix;

				for(
					AUTO					i8nextensionwidth=ci16nextensionwidth;
					0<i8nextensionwidth;
					i8nextensionwidth-=INT8(IMAGE_stcui8nUnitWidth)
				){
					SCREEN_stDraw_Layered(ui8ix_current,ui8iy,cui8ilayer,TRUE);	//	「空白」への更新もあり得るので強制する必要がある
					++ui8ix_current;
				}
				++ui8iy;
			}
		}
		return;
	}
	static _INLINE_ VOID	SCREEN_stDrawFace(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	もし牌があるなら左上起点になるよう補正
		if((cui8ix<GAME_stcui8nWidth)&&(cui8iy<GAME_stcui8nHeight))if(
			AUTO					ui16ctile=GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer);
			ui16ctile
		){
			GAME_stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			SCREEN_stDraw_Layered(ui8ix,ui8iy,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix+1,ui8iy,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix,ui8iy+1,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix+1,ui8iy+1,cui8ilayer);
		}
		return;
	}
private:
	static UINT8			stui8Divide24(CUINT16 cui16source)noexcept{
		//	「384/24=16」程度が得られれば良い。
		//	n*11/256
		CAUTO					cui8result=UINT8((cui16source*11)>>8);

		if(cui16source<UINT16(cui8result)*24)return cui8result-1;
		return cui8result;
	}
	template<CUINT8 cui8nRange>
	static UINT8			stui8Random(VOID)noexcept{
		return UINT8(((OS::LFSR_stui16Read()&0xff)*UINT16(cui8nRange))>>8);
	}
	static VOID				VBLANK_stCallback(const PVOID cpobject)noexcept{
		CAUTO					cstatmouse=OS::DEVICE_MOUSE_ststatRead();

		MOUSE_ststatState.v2iCursor+=cstatmouse.v2dRelative;
		MOUSE_ststatState.v2iCursor.i16iX()=STD::stxClamp(MOUSE_ststatState.v2iCursor.i16iX(),INT16(0),INT16(639));
		MOUSE_ststatState.v2iCursor.i16iY()=STD::stxClamp(MOUSE_ststatState.v2iCursor.i16iY(),INT16(0),INT16(479));
		if(MOUSE_ststatState.eBusy)GRAPHIC::SPRITE_stWrite16(0,MOUSE_ststatState.v2iCursor-VECTOR2(8,8),0x04,0x0);
		else GRAPHIC::SPRITE_stWrite16(0,MOUSE_ststatState.v2iCursor,0x00,0x0);
		MOUSE_ststatState.ui16cButtonSingle=cstatmouse.ui16cButton&~MOUSE_ststatState.ui16cButtonCurrent;
		MOUSE_ststatState.ui16cButtonCurrent=cstatmouse.ui16cButton;
		return;
	}
	static VOID				GAME_stAdjustPosition(UINT8& ui8ix,UINT8& ui8iy,UINT16& ui16ctile)noexcept{
		switch(ui16ctile&GAME_stcui16cTilePartMask){
		case GAME_stcui16cTilePartLU:
			break;
		case GAME_stcui16cTilePartRU:
			--ui8ix;
			break;
		case GAME_stcui16cTilePartLD:
			--ui8iy;
			break;
		case GAME_stcui16cTilePartRD:
			--ui8ix;
			--ui8iy;
			break;
		}
		ui16ctile&=~GAME_stcui16cTilePartMask;
		return;
	}
	static _INLINE_ VOID	GAME_stWriteTile4(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT16 cui16ctile,COFWBOOL cepart)noexcept{
		GAME_staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=cui16ctile|(cepart?GAME_stcui16cTilePartLU:0x0000);
		GAME_staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=cui16ctile|(cepart?GAME_stcui16cTilePartRU:0x0000);
		GAME_staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+0]=cui16ctile|(cepart?GAME_stcui16cTilePartLD:0x0000);
		GAME_staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+1]=cui16ctile|(cepart?GAME_stcui16cTilePartRD:0x0000);
		return;
	}
	//	OFWBOOL					GAME_steArrange_IsSettable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,UINT8& ui8ndistance)
	//		位置「(cui8ix,cui8iy,cui8ilayer)」に配置可能であるかどうかを返します。
	//		下記条件に合致すると「配置可能」と判定します。
	//		・牌が存在しない事
	//		・下層が存在する事
	//		・下記条件を満たす事
	//		  ・左右延長線上に牌が存在しない
	//		  ・左延長線上に牌が存在せず、右に牌が隣接している
	//		  ・右延長線上に牌が存在せず、左に牌が隣接している
	static OFWBOOL			GAME_steArrange_IsSettable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,UINT8& ui8ndistance)noexcept{
		CAUTO					cui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
		OFWBOOL					eneighbour;

		if(GAME_steArrange_IsThisExists(cui8ix,cui8iy,cui8ilayer))return FALSE;
		if(!GAME_steArrange_IsFootExists(cui8ix,cui8iy,cui8ilayer))return FALSE;
		ui8ndistance=0;
		if(GAME_steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,TRUE,eneighbour,ui8ndistance)){
			if(eneighbour){
				UINT8					ui8ndistancer=0;

				if(GAME_steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,FALSE,eneighbour,ui8ndistancer)){
					ui8ndistance=STD::stxGetMaximum(ui8ndistance,ui8ndistancer);
					return !eneighbour;
				}else{
					return FALSE;
				}
			}else{
				return GAME_steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,FALSE,eneighbour,ui8ndistance);
			}
		}
		return FALSE;
	}
	static OFWBOOL			GAME_steArrange_IsSettable_Side(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL cel,OFWBOOL& eneighbour,UINT8& ui8ndistance)noexcept{
		//	この時点で、位置「(cui8ix,cui8iy,cui8ilayer)」に牌が存在しない事は前提。
		++ui8ndistance;
		if(cel?(2<=cui8ix):(cui8ix<GAME_stcui8nWidth-2)){
			AUTO					ui8ixh=cel?UINT8(cui8ix-2):UINT8(cui8ix+2);
			AUTO					ui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][ui8ixh];

			if(ui16ctile){
				AUTO					ui8iyh=cui8iy;

				//	「空き(端)」ではない。
				GAME_stAdjustPosition(ui8ixh,ui8iyh,ui16ctile);
				if(ui8iyh==cui8iy){
					//	「半分ずらし」ではない
					if(GAME_steArrange_IsExists(ui16ctile)){
						//	実在なので「隣接あり設置可能」で確定
						eneighbour=TRUE;
						return TRUE;
					}else{
						//	ひとまず隣は空いているが、延長線上がどうかは分からない。
						if(GAME_steArrange_IsFootExists(ui8ixh,ui8iyh,cui8ilayer)){
							if(GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance)){
								//	ここで「eneighbour」が「TRUE」だと、
								//	「1つ離れて存在」という事になるので設置してはならない。
								//	返すべきは「eneighbour」の否定。
								return !eneighbour;
							}else{
								//	延長線上にあるか何かした。
								return FALSE;
							}
						}else{
							//	下層が存在していないなら「延長線自体無い」という事なので、「隣接無し配置可能」で確定。
							eneighbour=FALSE;
							return TRUE;
						}
					}
				}else{
					//	「半分ずらし」になっている
					if(GAME_steArrange_IsExists(ui16ctile)){
						OFWBOOL					eneighbour_dummy;

						//	実在なので「隣接設置可能」で仮
						eneighbour=TRUE;
						//	「設置可能」でありさえすれば、
						//	「隣接設置可能」で確定
						return GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh+2,cui8ilayer,cel,eneighbour_dummy,ui8ndistance);
					}else{
						//	ひとまず上隣は空いているが、延長線上がどうかは分からない。
						if(GAME_steArrange_IsFootExists(ui8ixh,ui8iyh,cui8ilayer)){
							AUTO					ui8ndistanced=ui8ndistance;

							if(GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance)){
								//	ここで「eneighbour」が「TRUE」だと、
								//	「1つおきで存在」という事になるので設置してはならない。
								if(eneighbour){
									return FALSE;
								}else{
									CAUTO					cesettable=GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh+2,cui8ilayer,cel,eneighbour,ui8ndistanced);

									ui8ndistance=STD::stxGetMaximum(ui8ndistance,ui8ndistanced);
									return cesettable;
								}
							}else{
								return FALSE;
							}
						}else{
							//	上隣に下層は存在していないので「延長線自体無い」。
							return GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh+2,cui8ilayer,cel,eneighbour,ui8ndistance);
						}
					}
				}
			}else{
				AUTO					ui8iyh=UINT8(cui8iy+1);

				//	「空き(端)」であった。
				ui16ctile=GAME_staaaui16cTile[cui8ilayer][ui8iyh][ui8ixh];
				if(ui16ctile){
					//	「半分ずらし」になっている
					if(GAME_steArrange_IsExists(ui16ctile)){
						//	実在なので「隣接あり設置可能」で確定
						eneighbour=TRUE;
						return TRUE;
					}else{
						if(GAME_steArrange_IsFootExists(ui8ixh,ui8iyh,cui8ilayer)){
							return GAME_steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance);
						}
					}
				}
			}
		}
		eneighbour=FALSE;
		return TRUE;
	}
	static _INLINE_ OFWBOOL	GAME_steArrange_IsFootExists(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		CAUTO					celayern=OFWBOOL(0<cui8ilayer);
		CAUTO					cefootlu=celayern?GAME_steArrange_IsThisExists(cui8ix+0,cui8iy+0,cui8ilayer-1):TRUE;
		CAUTO					cefootru=celayern?GAME_steArrange_IsThisExists(cui8ix+1,cui8iy+0,cui8ilayer-1):TRUE;
		CAUTO					cefootld=celayern?GAME_steArrange_IsThisExists(cui8ix+0,cui8iy+1,cui8ilayer-1):TRUE;
		CAUTO					cefootrd=celayern?GAME_steArrange_IsThisExists(cui8ix+1,cui8iy+1,cui8ilayer-1):TRUE;

		return (cefootlu&&cefootru&&cefootld&&cefootrd);
	}
	static _INLINE_ OFWBOOL	GAME_steArrange_IsThisExists(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		return GAME_steArrange_IsExists(GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix]);
	}
	static constexpr OFWBOOL	GAME_steArrange_IsExists(CUINT16 cui16ctile)noexcept{
		CAUTO					cui8itile=UINT8(cui16ctile&0xff);

		return OFWBOOL((cui8itile!=0x00)&&(cui8itile!=GAME_stcui8iTileUndefined));
	}
	//	VOID					SCREEN_stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		高さ「cui8ilayer」での、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		「cui8ilayer」は画面表示上の位置を決めるためのもので、
	//		内部描画処理はトップ「GAME_stcui8nLayer-1」からの開始になります。
	static VOID				SCREEN_stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL ceupdateforced=FALSE)noexcept{
		OFF_stDraw_Begin(cui8ix,cui8iy,cui8ilayer);
		if(ceupdateforced)OFF_stDraw_MarkUpdate();
		for(UINT8 ui8ilayer_drawing=0;ui8ilayer_drawing<GAME_stcui8nLayer;++ui8ilayer_drawing)OFF_stDraw_Layer(cui8ix,cui8iy,cui8ilayer,ui8ilayer_drawing);
		if(OFF_steUpdated)GRAPHIC::stCopy(OFF_stcvsOne,SCREEN_stv2iOne);
		return;
	}
	static VOID				OFF_stDraw_Begin(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		OFF_steUpdated=FALSE;
		SCREEN_stv2iOne={
			INT16(((cui8ix*2+SCREEN_stcui8iXBasis)<<3)-(cui8ilayer<<2)),
			INT16(((cui8iy*3+SCREEN_stcui8iYBasis)<<3)-(cui8ilayer<<3))
		};
		return;
	}
	static _INLINE_ VOID	OFF_stDraw_MarkUpdate(VOID)noexcept{
		if(!OFF_steUpdated)OFF_stDraw_MarkUpdate_Body();
		return;
	}
	static VOID				OFF_stDraw_MarkUpdate_Body(VOID)noexcept{
		OFF_steUpdated=TRUE;
#ifdef SHOWBACKBITMAP
		OFF_stcvsOne.CopyRect(IMAGE_stccvsBack,{SCREEN_stv2iOne,OFF_stcvsOne.stcv2nSize},VECTOR2::stv2ImmediateZero());
#else
		OFF_stcvsOne.Fill(stcui16cColorBack);
#endif
		return;
	}
	static VOID				OFF_stDraw_Layer(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8ilayer_drawing)noexcept{
		CAUTO					cui8doffset=cui8ilayer-cui8ilayer_drawing;
		//	VECTOR2					cv2idestination_minimum
		//		最下段時、位置「(4,8)」ずらしで床面影描画を行うので、
		//		表示対象に入るよう、下限値をマイナスにする。
		CAUTO					cv2idestination_minimum=(cui8ilayer_drawing==0)?VECTOR2(-INT16(IMAGE_stcui8nPerspectiveWidth),-INT16(IMAGE_stcui8nPerspectiveHeight)):VECTOR2::stv2ImmediateZero();
		AUTO					v2idestination=VECTOR2(
			INT16(cui8doffset*IMAGE_stcui8nPerspectiveWidth),
			INT16(cui8doffset*IMAGE_stcui8nPerspectiveHeight)
		);
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	下面描画のため「左上遡り」をするが、
		//	横「-16」以下、「+16」以上は表示対象から外れるので、
		//	最小限遡っておく。
		while((cv2idestination_minimum.i16iX()<v2idestination.i16iX())&&(0<ui8ix)){
			v2idestination.i16iX()-=INT16(IMAGE_stcui8nUnitWidth);
			--ui8ix;
		}
		//	縦は24ドット基準。
		while((cv2idestination_minimum.i16iY()<v2idestination.i16iY())&&(0<ui8iy)){
			v2idestination.i16iY()-=INT16(IMAGE_stcui8nUnitHeight);
			--ui8iy;
		}
		{
			CAUTO					ci16idestinationx_origin=v2idestination.i16iX();

			for(;v2idestination.i16iY()<INT16(IMAGE_stcui8nUnitHeight);v2idestination.i16iY()+=INT16(IMAGE_stcui8nUnitHeight)){
				AUTO					ui8ix_current=ui8ix;

				for(v2idestination.i16iX()=ci16idestinationx_origin;v2idestination.i16iX()<INT16(IMAGE_stcui8nUnitWidth);v2idestination.i16iX()+=INT16(IMAGE_stcui8nUnitWidth)){
					OFF_stDraw_Layer_Positioned(v2idestination,ui8ix_current,ui8iy,cui8ilayer_drawing);
					++ui8ix_current;
				}
				++ui8iy;
			}
		}
		return;
	}
	//	VOID					OFF_stDraw_Layer_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		表示位置「cv2idestination」への、高さ「cui8ilayer」、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		牌の表面以外、表示範囲に含まれる側面、床面、影の描画も行います。
	//		床面への影描画はオフセット「(+4,+8)」があるため、横「-19」、縦「-31」までは描画がありえます。
	static VOID				OFF_stDraw_Layer_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		CAUTO					cerange=OFWBOOL((cui8ix<GAME_stcui8nWidth)&&(cui8iy<GAME_stcui8nHeight));
		CAUTO					ceup1=(cerange&&(cui8ilayer<GAME_stcui8nLayer-1))?(GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer+1)!=0):FALSE;
		CAUTO					ceup2=(cerange&&(cui8ilayer<GAME_stcui8nLayer-2))?(GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer+2)!=0):FALSE;

		if(!ceup2){
			CAUTO					cex0=OFWBOOL(cui8ix<GAME_stcui8nWidth);
			CAUTO					cex1=OFWBOOL((1<=cui8ix)&&(cui8ix<GAME_stcui8nWidth+1));
			CAUTO					cey0=OFWBOOL(cui8iy<GAME_stcui8nHeight);
			CAUTO					cey1=OFWBOOL((1<=cui8iy)&&(cui8iy<GAME_stcui8nHeight+1));
			CAUTO					cex0y0=OFWBOOL(cex0&&cey0);
			CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
			CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
			CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
			CAUTO					cui16cx0y1=cex0y1?GAME_stui16cGetTile(cui8ix+0,cui8iy-1,cui8ilayer):UINT16(0x0000);
			CAUTO					cui16cx1y1=cex1y1?GAME_stui16cGetTile(cui8ix-1,cui8iy-1,cui8ilayer):UINT16(0x0000);
			CAUTO					cui16cx1y0=cex1y0?GAME_stui16cGetTile(cui8ix-1,cui8iy+0,cui8ilayer):UINT16(0x0000);

			//	側壁
			if(cui16cx1y1){
				OFF_stDraw_MarkUpdate();
				switch(cui16cx1y1&GAME_stcui16cTilePartMask){
				case GAME_stcui16cTilePartLU:
					//	状況的にあり得ない
					break;
				case GAME_stcui16cTilePartRU:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						{
							IMAGE_stcv2iSideR.i16iX(),
							IMAGE_stcv2iSideR.i16iY()+INT16(IMAGE_stcui8nUnitHeight)
						},{
							INT16(IMAGE_stcui8nPerspectiveWidth),
							INT16(IMAGE_stcui8nUnitHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						//	+-----------+--   + //
						//	|     |X1Y1 |X0Y1   //
						//	|           |       //
						//	|           |       //
						//	|           |       //
						//	|LU    RU   |LD   | //
						//	|--   +   --|------ //
						//	|           |\X0Y0  //	6	d
						//	|           | +---- //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|LD   |RD   | |     //	b	0
						//	+-----------+ |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideD,{
								INT16(IMAGE_stcui8nUnitWidth),
								INT16(IMAGE_stcui8nPerspectiveHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+-----------+X0Y1   //
						//	|     |X1Y1 |\      //
						//	|           | +     //
						//	|           | |     //
						//	|           | |     //
						//	|LU    RU   | |     //
						//	|--   +   --| |     //
						//	|           | |X0Y0 //	a	0
						//	|           | |     //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|LD   |RD   | |     //	b	0
						//	+-----------+ |     //
					}
					break;
				case GAME_stcui16cTilePartLD:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						{
							IMAGE_stcv2iSideD.i16iX()+INT16(IMAGE_stcui8nUnitWidth),
							IMAGE_stcv2iSideD.i16iY()
						},{
							INT16(IMAGE_stcui8nUnitWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |LD   |RD   | //
						//	------+-----------+ //
						//	|     |X1Y0 |\X0Y0  //	4	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |LD   |RD   | //
						//	------+-----------+ //
						//	       \X1Y0  X0Y0  //	d	e
						//	--------+---------- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
					break;
				case GAME_stcui16cTilePartRD:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						IMAGE_stcv2iSideRD,{
							INT16(IMAGE_stcui8nPerspectiveWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideD,{
								INT16(IMAGE_stcui8nUnitWidth),
								INT16(IMAGE_stcui8nPerspectiveHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						if(cui16cx1y0){
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|LD   |RD   |LD   | //
							//	+-----------+------ //
							//	|     |X1Y0 |\X0Y0  //	2	d
							//	|           | +---- //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|LU    RU   | |     //	a	0
							//	|--   +   --| |     //
							OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
								IMAGE_stcv2iSideR,{
									INT16(IMAGE_stcui8nPerspectiveWidth),
									INT16(IMAGE_stcui8nUnitHeight)
								}
							},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|LD   |RD   |LD   | //
							//	+-----------+------ //
							//	 \     X1Y0  \X0Y0  //	5	d
							//	  +-----------+---- //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}else{
						if(cui16cx1y0){
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|LD   |RD   | |     //
							//	+-----------+ |     //
							//	|     |X1Y0 |\|X0Y0 //	3	0
							//	|           | +     //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|LU    RU   | |     //	a	0
							//	|--   +   --| |     //
							OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
								IMAGE_stcv2iSideR,{
									INT16(IMAGE_stcui8nPerspectiveWidth),
									INT16(IMAGE_stcui8nUnitHeight)
								}
							},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|LD   |RD   | |     //
							//	+-----------+ |     //
							//	 \           \|X0Y0 //	f	0
							//	  +-----------+     //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}
					break;
				}
			}else{
				if(cui16cx0y1){
					OFF_stDraw_MarkUpdate();
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						IMAGE_stcv2iSideD,{
							INT16(IMAGE_stcui8nUnitWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |LD   | //
						//	+-----------+------ //
						//	|     |X1Y0 |\X0Y0  //	2	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |LD   | //
						//	            +------ //
						//	        X1Y0 \X0Y0  //	c	d
						//	              +---- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}else{
					if(cui16cx1y0){
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	+-----------+       //
						//	|     |X1Y0 |\X0Y0  //	8	0
						//	|           | +     //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //	
						OFF_stDraw_MarkUpdate();
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	             X0Y1   //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	        X1Y0 X0Y0   //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}
			}
		}
		if(!ceup1){
			if(
				CAUTO					cui16ctile=cerange?GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer):UINT16(0x0000);
				cui16ctile
			){
				constexpr AUTO			cv2iselectedrd=IMAGE_stcv2iSelected+IMAGE_stcv2nUnit;
				CAUTO&					acui8ipattern=GAME_staacui8iPattern[(cui16ctile&0xff)-1];
				CAUTO					cv2isource=VECTOR2(INT16(acui8ipattern[0]),INT16(acui8ipattern[1]));
				CAUTO					cv2isourcerd=cv2isource+IMAGE_stcv2nUnit;
				CAUTO					ceselected=OFWBOOL(cui16ctile&GAME_stcui16cTileSelectedMask);

				//	表面
				switch(cui16ctile&GAME_stcui16cTilePartMask){
				case GAME_stcui16cTilePartLU:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isource.i16iX(),		cv2isource.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						IMAGE_stcv2iSelected.i16iX(),	IMAGE_stcv2iSelected.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case GAME_stcui16cTilePartRU:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isourcerd.i16iX(),	cv2isource.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						cv2iselectedrd.i16iX(),	IMAGE_stcv2iSelected.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case GAME_stcui16cTilePartLD:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isource.i16iX(),		cv2isourcerd.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						IMAGE_stcv2iSelected.i16iX(),	cv2iselectedrd.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case GAME_stcui16cTilePartRD:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isourcerd.i16iX(),	cv2isourcerd.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						cv2iselectedrd.i16iX(),	cv2iselectedrd.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				}
			}else{
				//	最下段時、床面への影表示を行います。
				if(cui8ilayer==0)OFF_stDraw_Layer_Positioned_Shadow({
					INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nPerspectiveWidth)),
					INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nPerspectiveHeight))
				},cui8ix,cui8iy,0);
			}
		}
		return;
	}
	static VOID				OFF_stDraw_Layer_Positioned_Face(CVECTOR2& cv2idestination,CVECTOR2& cv2isource)noexcept{
		OFF_stDraw_MarkUpdate();
		if constexpr(FALSE){
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				cv2isource,IMAGE_stcv2nUnit
			},cv2idestination,IDBLEND::BackNega_SourceAlpha);
		}else{
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					cv2isource.i16iX(),
					cv2isource.i16iY()
				},{
					INT16(IMAGE_stcui8nUnitWidth),
					INT16(IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				cv2idestination.i16iX(),
				cv2idestination.i16iY()
			},IDBLEND::BackNega_SourceAlpha);
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					cv2isource.i16iX(),
					INT16(cv2isource.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
				},{
					INT16(IMAGE_stcui8nFaceAlphaWidth),
					INT16(IMAGE_stcui8nUnitHeight-IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				cv2idestination.i16iX(),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
			},IDBLEND::BackNega_SourceAlpha);
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					INT16(cv2isource.i16iX()+INT16(IMAGE_stcui8nFaceAlphaWidth)),
					INT16(cv2isource.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
				},{
					INT16(IMAGE_stcui8nUnitWidth-IMAGE_stcui8nFaceAlphaWidth),
					INT16(IMAGE_stcui8nUnitHeight-IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nFaceAlphaWidth)),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
			});
		}
		return;
	}
	static VOID				OFF_stDraw_Layer_Positioned_Shadow(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer1)noexcept{
		//	<影>
		//	+--------0H-------1H
		//	|＼    0A|＼    1A|
		//	|  0C    |  1C    |
		//	|    ＼ 0D    ＼ 1D
		//	|0B    ＼|1B    ＼|
		//	0G---0E--0F---1E--1F
		//	|＼    2A|＼    3A|
		//	|  2C    |  3C    |
		//	|    ＼ 2D    ＼ 3D
		//	|2B    ＼|3B    ＼|
		//	2G---2E--2F---3E--3F
		//	|＼    4A|＼    5A|
		//	|  4C    |  5C    |
		//	|    ＼ 4D    ＼ 5D
		//	|4B    ＼|5B    ＼|
		//	4G---4E--4F---5E--5F
		//	処理単位は16x24ドット6分割の8ドット四方で、さらに直角三角形2分割して「斜め線の影」を表現する。
		//	「A～G」は「TRUE/FALSE」2値を取り、この組み合わせで表示すべき影形状を決定する。
		//	・A
		//		影を落とす「上方向」の牌有無で決定。
		//		ただし「上方向」の牌が単独の場合「FALSE」とし、BとCだけ「TRUE」とする。
		//		この扱いにより、「右上角が少し欠けている影」の判別が出来る。
		//	・B
		//		影を落とす「左方向」の牌有無で決定。
		//		ただし「左方向」の牌が単独の場合「FALSE」とし、AとCだけ「TRUE」とする。
		//		この扱いにより、「左下角が少し欠けている影」の判別が出来る。
		//	・C
		//		影を落とす「左上方向」の牌有無で決定。
		//	・D/E
		//		影を落とす「2段以上上」の牌有無で決定。
		//		「1段上」だけであれば縦/横輪郭は「ぼかし」になり、「2段以上上」にあれば塗りつぶしになる。
		//	・F/G/H
		//		牌のつなぎ目に発生する「微妙な影のへこみ」表現で使用。
		//		影を落とす牌の対応する頂点が「田の字」で言う隅以外、つまり「直線状の影」になるようであれば「TRUE」とする。
		//		「直線状の影」が「TRUE」なのは、OR結合で「直線状の影」が優先されるようにするため。
		CAUTO					cui8ix0=UINT8(cui8ix);
		CAUTO					cui8ix1=UINT8(cui8ix-1);
		CAUTO					cui8ix2=UINT8(cui8ix-2);
		CAUTO					cui8ix3=UINT8(cui8ix-3);
		CAUTO					cui8iy0=UINT8(cui8iy);
		CAUTO					cui8iy1=UINT8(cui8iy-1);
		CAUTO					cui8iy2=UINT8(cui8iy-2);
		CAUTO					cui8ilayer2=cui8ilayer1+1;
		CAUTO					cui8ilayer3=cui8ilayer1+2;
		CAUTO					cui8ilayer4=cui8ilayer1+3;
		CAUTO					cui8ilayer5=cui8ilayer1+4;
		CAUTO					cex0=OFWBOOL(cui8ix0<GAME_stcui8nWidth);
		CAUTO					cex1=OFWBOOL(cui8ix1<GAME_stcui8nWidth);
		CAUTO					cex2=OFWBOOL(cui8ix2<GAME_stcui8nWidth);
		CAUTO					cex3=OFWBOOL(cui8ix3<GAME_stcui8nWidth);
		CAUTO					cey0=OFWBOOL(cui8iy0<GAME_stcui8nHeight);
		CAUTO					cey1=OFWBOOL(cui8iy1<GAME_stcui8nHeight);
		CAUTO					cey2=OFWBOOL(cui8iy2<GAME_stcui8nHeight);
		CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
		CAUTO					cex2y0=OFWBOOL(cex2&&cey0);
		CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
		CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
		CAUTO					cex2y1=OFWBOOL(cex2&&cey1);
		CAUTO					cex3y1=OFWBOOL(cex3&&cey1);
		CAUTO					cex1y2=OFWBOOL(cex1&&cey2);
		CAUTO					cex2y2=OFWBOOL(cex2&&cey2);
		CAUTO					cex3y2=OFWBOOL(cex3&&cey2);
		CAUTO					cel1=OFWBOOL(cui8ilayer1<GAME_stcui8nLayer);
		CAUTO					cel2=OFWBOOL(cui8ilayer2<GAME_stcui8nLayer);
		CAUTO					cel3=OFWBOOL(cui8ilayer3<GAME_stcui8nLayer);
		CAUTO					cel4=OFWBOOL(cui8ilayer4<GAME_stcui8nLayer);
		CAUTO					cel5=OFWBOOL(cui8ilayer5<GAME_stcui8nLayer);
		//	<X1Y0>    |  |  +               //
		//	|         |  |  |\              //
		//	|         |  |  | \             //
		//	+---------+  |  |  +----*----*  //
		//	 \         \ |  |  | * ** * **  //
		//	  \3        \|  |  |1 ＼|* ＼|  //
		//	   +---------+  |  1--1-1--*-*  //
		//	    \         \ |  | 1 #2 * **  //
		//	     \2        \|  |1 ＼|2 ＼|  //
		//	      +---------+  1--1-1--2-2  //
		//	       \         \ | 1 12 2 #3  //
		//	        \1        \|1 ＼|2 ＼|  //
		//	         +---------1--1-1--2-2  //
		CAUTO					cui16cx1y0l1=(cex1y0&&cel1)?GAME_stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer1):UINT16(0x0000);
		CAUTO					cui16cx1y0l2=(cex1y0&&cel2)?GAME_stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx1y0l3=(cex1y0&&cel3)?GAME_stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer3):UINT16(0x0000);
		constexpr AUTO			cex1y0_0a=OFWBOOL(FALSE);
		CAUTO					cex1y0_0b=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_0c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_0d=OFWBOOL(FALSE);
		CAUTO					cex1y0_0e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_0f=OFWBOOL((cui16cx1y0l1&&((cui16cx1y0l1&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartRU))||cui16cx1y0l2);
		CAUTO					cex1y0_0g=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_0h=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1a=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1b=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1d=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1e=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1f=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1h=OFWBOOL(FALSE);
		CAUTO					cex1y0_2a=OFWBOOL(cui16cx1y0l1&&((cui16cx1y0l1&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartRU));
		CAUTO					cex1y0_2b=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2c=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2d=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_2e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2f=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2g=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_3a=OFWBOOL(FALSE);
		CAUTO					cex1y0_3b=OFWBOOL(cui16cx1y0l2);
		constexpr AUTO			cex1y0_3c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_3d=OFWBOOL(FALSE);
		CAUTO					cex1y0_3e=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_3f=OFWBOOL((cui16cx1y0l2&&((cui16cx1y0l2&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartRU))||cui16cx1y0l3);
		CAUTO					cex1y0_4a=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4b=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4c=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4d=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_4e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4f=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4g=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_5a=OFWBOOL(cui16cx1y0l2&&((cui16cx1y0l2&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartRU));
		CAUTO					cex1y0_5b=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5c=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5d=OFWBOOL(cui16cx1y0l3);
		CAUTO					cex1y0_5e=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5f=OFWBOOL(cui16cx1y0l2);
		//	<X2Y0>    |  |  +                           //
		//	|         |  |  |\                          //
		//	|         |  |  | \                         //
		//	+---------+  |  |  +         +----*----*    //
		//	 \         \ |  |  |＼       | * ** * **    //
		//	  \3        \|  |  |  ＼     |* ＼|* ＼|    //
		//	   +---------+  |  |    \    *--*-*--*-*    //
		//	    \         \ |  |    |＼  | * ** * **    //
		//	     \2        \|  |    |  ＼|* ＼|* ＼|    //
		//	      +---------+  |    |    3--*-*--*-*    //
		//	       \         \ |    |    | * ** * **    //
		//	        \1        \|    |    |3 ＼|* ＼|    //
		//	         +---------+(1)-|(2)-3--3-3--*-*    //
		CAUTO					cui16cx2y0l2=(cex2y0&&cel2)?GAME_stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx2y0l3=(cex2y0&&cel3)?GAME_stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer3):UINT16(0x0000);
		CAUTO					cui16cx2y0l4=(cex2y0&&cel4)?GAME_stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer4):UINT16(0x0000);
		constexpr AUTO			cex2y0_0a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0g=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0h=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1h=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2f=OFWBOOL(FALSE);
		CAUTO					cex2y0_2g=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_3a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_4a=OFWBOOL(FALSE);
		CAUTO					cex2y0_4b=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_4c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_4d=OFWBOOL(FALSE);
		CAUTO					cex2y0_4e=OFWBOOL(cui16cx2y0l3);
		CAUTO					cex2y0_4f=OFWBOOL((cui16cx2y0l3&&((cui16cx2y0l3&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartRU))||cui16cx2y0l4);
		CAUTO					cex2y0_4g=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_5a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5f=OFWBOOL(FALSE);
		//	<X0Y1>    |  |  +   //
		//	|         |  |  |   //
		//	|         |  |  |   //
		//	+---------+  |  |   //
		//	 \         \ |  |   //
		//	  \2        \|  |   //
		//	   +---------+  |   //
		//	    \         \ |   //
		//	     \1        \|   //
		//	      +----1----1   //
		//	      | * 11 1 11   //
		//	      |* ＼|# ＼|   //
		//	      *--*-1--2-1   //
		//	      | * ** * 22   //
		//	      |* ＼|* ＼|   //
		//	      *--*-*--*-2   //
		//	      | * ** * **   //
		//	      |* ＼|* ＼|   //
		//	      *--*-*--*-*   //
		CAUTO					cui16cx0y1l1=(cex0y1&&cel1)?GAME_stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer1):UINT16(0x0000);
		CAUTO					cui16cx0y1l2=(cex0y1&&cel2)?GAME_stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx0y1l3=(cex0y1&&cel3)?GAME_stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer3):UINT16(0x0000);
		CAUTO					cex0y1_0a=OFWBOOL(cui16cx0y1l1);
		constexpr AUTO			cex0y1_0b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_0c=OFWBOOL(FALSE);
		CAUTO					cex0y1_0d=OFWBOOL(cui16cx0y1l1);
		constexpr AUTO			cex0y1_0e=OFWBOOL(FALSE);
		CAUTO					cex0y1_0f=OFWBOOL((cui16cx0y1l1&&((cui16cx0y1l1&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartLD))||cui16cx0y1l2);
		constexpr AUTO			cex0y1_0g=OFWBOOL(FALSE);
		CAUTO					cex0y1_0h=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1a=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1b=OFWBOOL(cui16cx0y1l1&&((cui16cx0y1l1&GAME_stcui16cTilePartMask)!=GAME_stcui16cTilePartLD));
		CAUTO					cex0y1_1c=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1d=OFWBOOL(cui16cx0y1l1);
