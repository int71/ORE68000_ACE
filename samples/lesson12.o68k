		if(cui8d0||cui8d1||cui8d2||cui8d3||cui8d4||cui8d5){
			constexpr AUTO			cv2nsource=VECTOR2(INT16(IMAGE_stcui8nShadowWidth),INT16(IMAGE_stcui8nShadowHeight));

			OFF_stDraw_MarkUpdate();
			if(cui8d0)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d0)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()),
				INT16(cv2idestination.i16iY())
			},IDBLEND::BackNega_SourceAlpha);
			if(cui8d1)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d1)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nShadowWidth)),
				INT16(cv2idestination.i16iY())
			},IDBLEND::BackNega_SourceAlpha);
			if(cui8d2)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d2)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nShadowHeight*1))
			},IDBLEND::BackNega_SourceAlpha);
			if(cui8d3)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d3)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nShadowWidth)),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nShadowHeight*1))
			},IDBLEND::BackNega_SourceAlpha);
			if(cui8d4)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d4)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nShadowHeight*2))
			},IDBLEND::BackNega_SourceAlpha);
			if(cui8d5)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{INT16(IMAGE_stcv2iShadow.i16iX()+INT16(cui8d5)),IMAGE_stcv2iShadow.i16iY()},cv2nsource},{
				INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nShadowWidth)),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nShadowHeight*2))
			},IDBLEND::BackNega_SourceAlpha);
#ifdef SHOWSHADOWOFFSET
			DEBUG::stWrite(cui8ix);
			DEBUG::stWrite(",");
			DEBUG::stWrite(cui8iy);
			DEBUG::stWrite("/0:");
			DEBUG::stWrite(ce0a?"A":"_");
			DEBUG::stWrite(ce0b?"B":"_");
			DEBUG::stWrite(ce0c?"C":"_");
			DEBUG::stWrite(ce0d?"D":"_");
			DEBUG::stWrite(ce0e?"E":"_");
			DEBUG::stWrite(ce0f?"F":"_");
			DEBUG::stWrite(ce0g?"G":"_");
			DEBUG::stWrite(ce0h?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d0>>3));
			DEBUG::stWrite(" 1:");
			DEBUG::stWrite(ce1a?"A":"_");
			DEBUG::stWrite(ce1b?"B":"_");
			DEBUG::stWrite(ce1c?"C":"_");
			DEBUG::stWrite(ce1d?"D":"_");
			DEBUG::stWrite(ce1e?"E":"_");
			DEBUG::stWrite(ce1f?"F":"_");
			DEBUG::stWrite(ce0f?"G":"_");
			DEBUG::stWrite(ce1h?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d1>>3));
			DEBUG::stWrite(" 2:");
			DEBUG::stWrite(ce2a?"A":"_");
			DEBUG::stWrite(ce2b?"B":"_");
			DEBUG::stWrite(ce2c?"C":"_");
			DEBUG::stWrite(ce2d?"D":"_");
			DEBUG::stWrite(ce2e?"E":"_");
			DEBUG::stWrite(ce2f?"F":"_");
			DEBUG::stWrite(ce2g?"G":"_");
			DEBUG::stWrite(ce0f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d2>>3));
			DEBUG::stWrite(" 3:");
			DEBUG::stWrite(ce3a?"A":"_");
			DEBUG::stWrite(ce3b?"B":"_");
			DEBUG::stWrite(ce3c?"C":"_");
			DEBUG::stWrite(ce3d?"D":"_");
			DEBUG::stWrite(ce3e?"E":"_");
			DEBUG::stWrite(ce3f?"F":"_");
			DEBUG::stWrite(ce2f?"G":"_");
			DEBUG::stWrite(ce1f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d3>>3));
			DEBUG::stWrite(" 4:");
			DEBUG::stWrite(ce4a?"A":"_");
			DEBUG::stWrite(ce4b?"B":"_");
			DEBUG::stWrite(ce4c?"C":"_");
			DEBUG::stWrite(ce4d?"D":"_");
			DEBUG::stWrite(ce4e?"E":"_");
			DEBUG::stWrite(ce4f?"F":"_");
			DEBUG::stWrite(ce4g?"G":"_");
			DEBUG::stWrite(ce2f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d4>>3));
			DEBUG::stWrite(" 5:");
			DEBUG::stWrite(ce5a?"A":"_");
			DEBUG::stWrite(ce5b?"B":"_");
			DEBUG::stWrite(ce5c?"C":"_");
			DEBUG::stWrite(ce5d?"D":"_");
			DEBUG::stWrite(ce5e?"E":"_");
			DEBUG::stWrite(ce5f?"F":"_");
			DEBUG::stWrite(ce4f?"G":"_");
			DEBUG::stWrite(ce3f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHexLine(UINT8(cui8d5>>3));
#endif
		}
		return;
	}
	static constexpr UINT8	OFF_stui8dDraw_Layer_Positioned_Shadow_GetOffset(COFWBOOL cea,COFWBOOL ceb,COFWBOOL cec,COFWBOOL ced,COFWBOOL cee,COFWBOOL cef,COFWBOOL ceg,COFWBOOL ceh)noexcept{
		//	A～H場所
		//	+--------H
		//	|＼     A|
		//	|  C     | 
		//	|    ＼  D 
		//	|B     ＼|
		//	G----E---F
		//	パーツ割
		//	     x0   x1   x2   x3
		//	    +----+----+----+----+
		//	  0x|    |■■|■■|■■|
		//	    |    |＼■|＼__|____|
		//	    +----+----+----+----+
		//	  1x|■＼|  ＼|  ＼|■ ||
		//	    |■■|＼  |    |■ /|
		//	    +----+----+----+----+
		//	  2x|■＼|    |■■|■ \|
		//	    |■ ||＼  |■■|■ ||
		//	    +----+----+----+----+
		//	  3x|■ ||■■|■■|■ ||
		//	    |■ ||___/|\___|__／|
		//	    +----+----+----+----+
		//	  4x|■■|    |    |    |
		//	    |■／|    |    |    |
		//	    +----+----+----+----+
		constexpr UINT8			acui8idoffset[]={
		//	ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH
		//	<表示対象無し>
		//	________ _______H ______G_ ______GH _____F__ _____F_H _____FG_ _____FGH ____E___ ____E__H ____E_G_ ____E_GH ____EF__ ____EF_H ____EFG_ ____EFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	___D____ ___D___H ___D__G_ ___D__GH ___D_F__ ___D_F_H ___D_FG_ ___D_FGH ___DE___ ___DE__H ___DE_G_ ___DE_GH ___DEF__ ___DEF_H ___DEFG_ ___DEFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	__C_____ __C____H __C___G_ __C___GH __C__F__ __C__F_H __C__FG_ __C__FGH __C_E___ __C_E__H __C_E_G_ __C_E_GH __C_EF__ __C_EF_H __C_EFG_ __C_EFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	__CD____ __CD___H __CD__G_ __CD__GH __CD_F__ __CD_F_H __CD_FG_ __CD_FGH __CDE___ __CDE__H __CDE_G_ __CDE_GH __CDEF__ __CDEF_H __CDEFG_ __CDEFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	_B______ _B_____H _B____G_ _B____GH _B___F__ _B___F_H _B___FG_ _B___FGH _B__E___ _B__E__H _B__E_G_ _B__E_GH _B__EF__ _B__EF_H _B__EFG_ _B__EFGH
			0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3,
		//	_B_D____ _B_D___H _B_D__G_ _B_D__GH _B_D_F__ _B_D_F_H _B_D_FG_ _B_D_FGH _B_DE___ _B_DE__H _B_DE_G_ _B_DE_GH _B_DEF__ _B_DEF_H _B_DEFG_ _B_DEFGH
			0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3,
		//	_BC_____ _BC____H _BC___G_ _BC___GH _BC__F__ _BC__F_H _BC__FG_ _BC__FGH _BC_E___ _BC_E__H _BC_E_G_ _BC_E_GH _BC_EF__ _BC_EF_H _BC_EFG_ _BC_EFGH
			0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3,
		//	_BCD____ _BCD___H _BCD__G_ _BCD__GH _BCD_F__ _BCD_F_H _BCD_FG_ _BCD_FGH _BCDE___ _BCDE__H _BCDE_G_ _BCDE_GH _BCDEF__ _BCDEF_H _BCDEFG_ _BCDEFGH
			0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3,
		//	A_______ A______H A_____G_ A_____GH A____F__ A____F_H A____FG_ A____FGH A___E___ A___E__H A___E_G_ A___E_GH A___EF__ A___EF_H A___EFG_ A___EFGH
			0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3,
		//	A__D____ A__D___H A__D__G_ A__D__GH A__D_F__ A__D_F_H A__D_FG_ A__D_FGH A__DE___ A__DE__H A__DE_G_ A__DE_GH A__DEF__ A__DEF_H A__DEFG_ A__DEFGH
			0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3,
		//	A_C_____ A_C____H A_C___G_ A_C___GH A_C__F__ A_C__F_H A_C__FG_ A_C__FGH A_C_E___ A_C_E__H A_C_E_G_ A_C_E_GH A_C_EF__ A_C_EF_H A_C_EFG_ A_C_EFGH
			0x02<<3, 0x02<<3, 0x03<<3, 0x03<<3, 0x02<<3, 0x02<<3, 0x03<<3, 0x03<<3, 0x0c<<3, 0x07<<3, 0x0c<<3, 0x07<<3, 0x0b<<3, 0x0b<<3, 0x0b<<3, 0x0c<<3,
		//	A_CD____ A_CD___H A_CD__G_ A_CD__GH A_CD_F__ A_CD_F_H A_CD_FG_ A_CD_FGH A_CDE___ A_CDE__H A_CDE_G_ A_CDE_GH A_CDEF__ A_CDEF_H A_CDEFG_ A_CDEFGH
			0x02<<3, 0x02<<3, 0x0d<<3, 0x0d<<3, 0x0e<<3, 0x0e<<3, 0x03<<3, 0x03<<3, 0x01<<3, 0x01<<3, 0x0a<<3, 0x0a<<3, 0x01<<3, 0x01<<3, 0x01<<3, 0x01<<3,
		//	AB______ AB_____H AB____G_ AB____GH AB___F__ AB___F_H AB___FG_ AB___FGH AB__E___ AB__E__H AB__E_G_ AB__E_GH AB__EF__ AB__EF_H AB__EFG_ AB__EFGH
			0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3,
		//	AB_D____ AB_D___H AB_D__G_ AB_D__GH AB_D_F__ AB_D_F_H AB_D_FG_ AB_D_FGH AB_DE___ AB_DE__H AB_DE_G_ AB_DE_GH AB_DEF__ AB_DEF_H AB_DEFG_ AB_DEFGH
			0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3,
		//	ABC_____ ABC____H ABC___G_ ABC___GH ABC__F__ ABC__F_H ABC__FG_ ABC__FGH ABC_E___ ABC_E__H ABC_E_G_ ABC_E_GH ABC_EF__ ABC_EF_H ABC_EFG_ ABC_EFGH
			0x0f<<3, 0x07<<3, 0x0d<<3, 0x0f<<3, 0x0f<<3, 0x0c<<3, 0x03<<3, 0x0c<<3, 0x0c<<3, 0x07<<3, 0x0c<<3, 0x07<<3, 0x0b<<3, 0x0c<<3, 0x0b<<3, 0x0c<<3,
		//	ABCD____ ABCD___H ABCD__G_ ABCD__GH ABCD_F__ ABCD_F_H ABCD_FG_ ABCD_FGH ABCDE___ ABCDE__H ABCDE_G_ ABCDE_GH ABCDEF__ ABCDEF_H ABCDEFG_ ABCDEFGH
			0x03<<3, 0x03<<3, 0x0d<<3, 0x0d<<3, 0x0e<<3, 0x0e<<3, 0x03<<3, 0x03<<3, 0x10<<3, 0x10<<3, 0x10<<3, 0x10<<3, 0x0a<<3, 0x0a<<3, 0x0a<<3, 0x0a<<3
		};

		return acui8idoffset[
			+(cea?0x80:0x00)
			+(ceb?0x40:0x00)
			+(cec?0x20:0x00)
			+(ced?0x10:0x00)
			+(cee?0x08:0x00)
			+(cef?0x04:0x00)
			+(ceg?0x02:0x00)
			+(ceh?0x01:0x00)
		];
	}
};

//
//		user
//

OFWBOOL					SELECT_eSelected;
UINT8					SELECT_ui8iTile,SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer;

VOID					MARK_Erase(VOID)noexcept{
	GRAPHIC::SPRITE_stErase(1);
	GRAPHIC::SPRITE_stErase(2);
	GRAPHIC::SPRITE_stErase(3);
	GRAPHIC::SPRITE_stErase(4);
	return;
}

VOID					USER_New(VOID)noexcept{
	USER::stNew();
	USER::GAME_stArrange();
#ifdef SHOWARRANGEPROGRESS
#else
	USER::SCREEN_stDraw();
#endif
	USER::MOUSE_stSetBusy(FALSE);
	SELECT_eSelected=FALSE;
	return;
}

VOID					USER_Delete(VOID)noexcept{
	USER::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	CAUTO					cstatmouse=USER::MOUSE_ststatGetState();
	UINT8					ui8ix,ui8iy,ui8ilayer;

	if(
		CAUTO					cui16ctile=USER::GAME_stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,cstatmouse.v2iCursor);
		cui16ctile
	){
		CAUTO					cui8ix=ui8ix,cui8iy=ui8iy,cui8ilayer=ui8ilayer;
		CAUTO					ceselectable=USER::GAME_steIsSelectable(cui8ix,cui8iy,cui8ilayer);

		if(cstatmouse.ui16cButtonSingle&OS::MOUSE_stcui8cMaskButtonLeft){
			//	マウスボタン押下
			if(ceselectable){
				CAUTO					cui8itile=UINT8(USER::GAME_stui16cGetTile(cui8ix,cui8iy,cui8ilayer)&0xff);

				//	ゲット可能な牌を指している
				if(SELECT_eSelected){
					//	既に1つ選択している
					if(
						(SELECT_ui8iTile!=cui8itile)&&
						(((SELECT_ui8iTile-1)&~3)==((cui8itile-1)&~3))
					){
						//	同じ牌であったので既存もろとも消し去る
						USER::MOUSE_stSetBusy(TRUE);
						MARK_Erase();
						USER::GAME_stSelectTile(cui8ix,cui8iy,cui8ilayer,TRUE);
						USER::GAME_stWriteTile(SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer,0x00,TRUE);
						USER::GAME_stWriteTile(cui8ix,cui8iy,cui8ilayer,0x00,TRUE);
						SELECT_eSelected=FALSE;
						USER::MOUSE_stSetBusy(FALSE);
						return;
					}else{
						//	違う牌であったので選択し直す
						USER::MOUSE_stSetBusy(TRUE);
						MARK_Erase();
						USER::GAME_stSelectTile(SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer,FALSE);
						SELECT_ui8iTile=cui8itile;
						SELECT_ui8iX=cui8ix;
						SELECT_ui8iY=cui8iy;
						SELECT_ui8iLayer=cui8ilayer;
						USER::GAME_stSelectTile(SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer,TRUE);
						USER::MOUSE_stSetBusy(FALSE);
						return;
					}
				}else{
					//	1つ目の選択
					USER::MOUSE_stSetBusy(TRUE);
					MARK_Erase();
					SELECT_eSelected=TRUE;
					SELECT_ui8iTile=cui8itile;
					SELECT_ui8iX=cui8ix;
					SELECT_ui8iY=cui8iy;
					SELECT_ui8iLayer=cui8ilayer;
					USER::GAME_stSelectTile(SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer,TRUE);
					USER::MOUSE_stSetBusy(FALSE);
					return;
				}
			}else{
				//	ゲット可能な牌ではない
				if(SELECT_eSelected){
					//	既に1つ目が選択されていたならキャンセル扱い
					USER::MOUSE_stSetBusy(TRUE);
					MARK_Erase();
					SELECT_eSelected=FALSE;
					USER::GAME_stSelectTile(SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer,FALSE);
					USER::MOUSE_stSetBusy(FALSE);
					return;
				}
			}
		}
		//	マーク表示
		{
			CAUTO					cv2iposition=USER::SCREEN_stv2iGetPosition(ui8ix,ui8iy,ui8ilayer);
			CAUTO					cv2ipositionRD=cv2iposition+VECTOR2(
				USER::IMAGE_stcui8nUnitWidth*2-1,
				USER::IMAGE_stcui8nUnitHeight*2-1
			);
			CAUTO					cv2isprite=cv2iposition;
			CAUTO					cv2ispriteRD=VECTOR2(
				cv2ipositionRD.i16iX()-7,
				cv2ipositionRD.i16iY()-7
			);
			//	UINT8					cui8ipattern
			//		選択可能な牌を指しているかどうかで、マーク形状を変えてやります。
			CAUTO					cui8ipattern=ceselectable?UINT8(0x08):UINT8(0x09);

			if(USER::GAME_stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
				cv2iposition.i16iX(),	cv2iposition.i16iY()
			})==cui16ctile)GRAPHIC::SPRITE_stWrite8(1,{
				cv2iposition.i16iX(),	cv2iposition.i16iY()
			},cui8ipattern,0x1,FALSE,FALSE);
			else GRAPHIC::SPRITE_stErase(1);
			if(USER::GAME_stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
				cv2ipositionRD.i16iX(),	cv2iposition.i16iY()
			})==cui16ctile)GRAPHIC::SPRITE_stWrite8(2,{
				cv2ispriteRD.i16iX(),	cv2isprite.i16iY()
			},cui8ipattern,0x1,TRUE,FALSE);
			else GRAPHIC::SPRITE_stErase(2);
			if(USER::GAME_stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
				cv2iposition.i16iX(),	cv2ipositionRD.i16iY()
			})==cui16ctile)GRAPHIC::SPRITE_stWrite8(3,{
				cv2isprite.i16iX(),		cv2ispriteRD.i16iY()
			},cui8ipattern,0x1,FALSE,TRUE);
			else GRAPHIC::SPRITE_stErase(3);
			if(USER::GAME_stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
				cv2ipositionRD.i16iX(),	cv2ipositionRD.i16iY()
			})==cui16ctile)GRAPHIC::SPRITE_stWrite8(4,{
				cv2ispriteRD.i16iX(),	cv2ispriteRD.i16iY()
			},cui8ipattern,0x1,TRUE,TRUE);
			else GRAPHIC::SPRITE_stErase(4);
			return;
		}
	}
	MARK_Erase();
	return;
}
