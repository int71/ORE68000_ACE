//
//		include
//

#include				<sub/graphic.hpp>

//
//		macro
//

#define SHOWBACKBITMAP

//
//		using
//

using namespace m68k::ore68000ace;
using namespace m68k::i71::sub;

//
//		クラス:USER
//

class USER{
public:

	//
	//		定数
	//

	using					IDBLEND=GRAPHIC::IDBLEND;
	//	UINT8					staacui8iArrangement[144][3]
	//		牌の配置を保持します。
	//		「{横,縦,高さ}」を単位として、牌144ヶ分あります。
	static constexpr UINT8	staacui8iArrangement[][3]={
		//	第1層
		           { 2, 0, 0},{ 4, 0, 0},{ 6, 0, 0},{ 8, 0, 0},{10, 0, 0},{12, 0, 0},{14, 0, 0},{16, 0, 0},{18, 0, 0},{20, 0, 0},{22, 0, 0},{24, 0, 0},
		                                 { 6, 2, 0},{ 8, 2, 0},{10, 2, 0},{12, 2, 0},{14, 2, 0},{16, 2, 0},{18, 2, 0},{20, 2, 0},
		                      { 4, 4, 0},{ 6, 4, 0},{ 8, 4, 0},{10, 4, 0},{12, 4, 0},{14, 4, 0},{16, 4, 0},{18, 4, 0},{20, 4, 0},{22, 4, 0},
		           { 2, 6, 0},{ 4, 6, 0},{ 6, 6, 0},{ 8, 6, 0},{10, 6, 0},{12, 6, 0},{14, 6, 0},{16, 6, 0},{18, 6, 0},{20, 6, 0},{22, 6, 0},{24, 6, 0},
		{ 0, 7, 0},{ 2, 8, 0},{ 4, 8, 0},{ 6, 8, 0},{ 8, 8, 0},{10, 8, 0},{12, 8, 0},{14, 8, 0},{16, 8, 0},{18, 8, 0},{20, 8, 0},{22, 8, 0},{24, 8, 0},{26, 7, 0},{28, 7, 0},
		                      { 4,10, 0},{ 6,10, 0},{ 8,10, 0},{10,10, 0},{12,10, 0},{14,10, 0},{16,10, 0},{18,10, 0},{20,10, 0},{22,10, 0},
		                                 { 6,12, 0},{ 8,12, 0},{10,12, 0},{12,12, 0},{14,12, 0},{16,12, 0},{18,12, 0},{20,12, 0},
		           { 2,14, 0},{ 4,14, 0},{ 6,14, 0},{ 8,14, 0},{10,14, 0},{12,14, 0},{14,14, 0},{16,14, 0},{18,14, 0},{20,14, 0},{22,14, 0},{24,14, 0},
		//	第2層
		                                            { 8, 2, 1},{10, 2, 1},{12, 2, 1},{14, 2, 1},{16, 2, 1},{18, 2, 1},
		                                            { 8, 4, 1},{10, 4, 1},{12, 4, 1},{14, 4, 1},{16, 4, 1},{18, 4, 1},
		                                            { 8, 6, 1},{10, 6, 1},{12, 6, 1},{14, 6, 1},{16, 6, 1},{18, 6, 1},
		                                            { 8, 8, 1},{10, 8, 1},{12, 8, 1},{14, 8, 1},{16, 8, 1},{18, 8, 1},
		                                            { 8,10, 1},{10,10, 1},{12,10, 1},{14,10, 1},{16,10, 1},{18,10, 1},
		                                            { 8,12, 1},{10,12, 1},{12,12, 1},{14,12, 1},{16,12, 1},{18,12, 1},
		//	第3層
		                                                       {10, 4, 2},{12, 4, 2},{14, 4, 2},{16, 4, 2},
		                                                       {10, 6, 2},{12, 6, 2},{14, 6, 2},{16, 6, 2},
		                                                       {10, 8, 2},{12, 8, 2},{14, 8, 2},{16, 8, 2},
		                                                       {10,10, 2},{12,10, 2},{14,10, 2},{16,10, 2},
		//	第4層
		                                                                  {12, 6, 3},{14, 6, 3},
		                                                                  {12, 8, 3},{14, 8, 3},
		//	第5層
		                                                                  {13, 7, 4}
	};
	//	UINT8					staacui8iPattern[144][2]
	//		牌と絵柄パターンの対応を保持します。
	//		「{横,縦}」を単位として、牌144ヶ分あります。
	//		縦横の値は「lesson12_BITMAP.png」の座標に対応しており、
	//		わざわざ1牌単位で対応させているのは、
	//		「季節」と「花」が4牌別絵柄であるためです。
	static constexpr UINT8	staacui8iPattern[][2]={
		{0x00,0x00},{0x00,0x00},{0x00,0x00},{0x00,0x00},	//	一萬
		{0x20,0x00},{0x20,0x00},{0x20,0x00},{0x20,0x00},	//	二萬
		{0x40,0x00},{0x40,0x00},{0x40,0x00},{0x40,0x00},	//	三萬
		{0x60,0x00},{0x60,0x00},{0x60,0x00},{0x60,0x00},	//	四萬
		{0x80,0x00},{0x80,0x00},{0x80,0x00},{0x80,0x00},	//	伍萬
		{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},	//	六萬
		{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},	//	七萬
		{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},	//	八萬
		{0x00,0x30},{0x00,0x30},{0x00,0x30},{0x00,0x30},	//	九萬
		{0x20,0x30},{0x20,0x30},{0x20,0x30},{0x20,0x30},	//	一索
		{0x40,0x30},{0x40,0x30},{0x40,0x30},{0x40,0x30},	//	二索
		{0x60,0x30},{0x60,0x30},{0x60,0x30},{0x60,0x30},	//	三索
		{0x80,0x30},{0x80,0x30},{0x80,0x30},{0x80,0x30},	//	四索
		{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},	//	伍索
		{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},	//	六索
		{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},	//	七索
		{0x00,0x60},{0x00,0x60},{0x00,0x60},{0x00,0x60},	//	八索
		{0x20,0x60},{0x20,0x60},{0x20,0x60},{0x20,0x60},	//	九索
		{0x40,0x60},{0x40,0x60},{0x40,0x60},{0x40,0x60},	//	一筒
		{0x60,0x60},{0x60,0x60},{0x60,0x60},{0x60,0x60},	//	二筒
		{0x80,0x60},{0x80,0x60},{0x80,0x60},{0x80,0x60},	//	三筒
		{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},	//	四筒
		{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},	//	伍筒
		{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},	//	六筒
		{0x00,0x90},{0x00,0x90},{0x00,0x90},{0x00,0x90},	//	七筒
		{0x20,0x90},{0x20,0x90},{0x20,0x90},{0x20,0x90},	//	八筒
		{0x40,0x90},{0x40,0x90},{0x40,0x90},{0x40,0x90},	//	九筒
		{0x60,0x90},{0x60,0x90},{0x60,0x90},{0x60,0x90},	//	東
		{0x80,0x90},{0x80,0x90},{0x80,0x90},{0x80,0x90},	//	南
		{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},	//	西
		{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},	//	北
		{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},	//	白板
		{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},	//	緑發
		{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},	//	紅中
		{0x40,0xc0},{0x60,0xc0},{0x80,0xc0},{0xa0,0xc0},	//	季節
		{0xc0,0xc0},{0xe0,0xc0},{0x00,0xf0},{0x20,0xf0}		//	花
	};
	static constexpr UINT8	stcui8nTile=UINT8(SIZEOF(staacui8iPattern)/(SIZEOF(UINT8)*2));
	static constexpr UINT8	stcui8iXBasis=10;
	static constexpr UINT8	stcui8iYBasis=6;
	static constexpr UINT8	stcui8nWidth=15*2;
	static constexpr UINT8	stcui8nHeight=8*2;
	static constexpr UINT8	stcui8nLayer=5;
	static constexpr UINT16	stcui16cColorBack=0x141;
	//	CANVAS_RGBA_ROM			stccvsTile
	//		牌絵柄ビットマップデータを保持します。
	//		横32、縦48ドット単位で並べています。
	//		「-cm 0」は減色方法指示で、「0」は「単純切り捨て」です。
	//		「1」の誤差拡散はちょっとノイジーだったんで。
	static _INLINE_ CAUTO	stccvsTile=__O68K_CANVAS_RGBA_ROM("(Resource)/牌_BITMAP_TILE.png","-cm 0");
#ifdef SHOWBACKBITMAP
	static _INLINE_ CAUTO	stccvsBack=__O68K_CANVAS_RGB_ROM("(Resource)/床面_BITMAP.png");
#endif
	//	CANVAS_RGB_RAM			stcvsWork
	//		非表示状態処理するためのバッファです。
	//		牌の大きさは32x48ドットですが、
	//		「半分ずらし」があるので処理単位は16x24ドットにしています。
	static _INLINE_ AUTO	stcvsWork=CANVAS_RGB_RAM<16,24>();

	//
	//		定義本体:USER
	//

public:
	//	UINT16					staaaui16cTile[stcui8nLayer][stcui8nHeight][stcui8nWidth]
	//		牌の配置状況を保持します。
	//		「半分ずらし」があるので牌1つで田の字「2x2」の領域を占めます。
	//		位置0～7の8ビットは牌個体識別で、「0」は無し(空白)、「1～144」が牌通し番号になります。
	//		位置8～9の2ビットは田の字中の位置を示し、左上0、右上1、左下2、右下を設定します。
	//		これにより、配列1要素だけで牌の位置が分かります。
	static _INLINE_ UINT16	staaaui16cTile[stcui8nLayer][stcui8nHeight][stcui8nWidth];
public:
	static VOID				stNew(VOID)noexcept{
		GRAPHIC::stNew(TRUE);
#ifdef SHOWBACKBITMAP
		GRAPHIC::stCopy(stccvsBack,VECTOR2::stv2ImmediateZero());
#else
		GRAPHIC::stFill(stcui16cColorBack);
#endif
		STD::stFill(staaaui16cTile,SIZEOF(staaaui16cTile),0x00);
		return;
	}
	static VOID				stDelete(VOID)noexcept{
		GRAPHIC::stDelete();
		return;
	}
	//	VOID					stWrite(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile)
	//		牌の配置状況「staaaui16cTile」に対し、
	//		横「cui8ix」、縦「cui8iy」、高さ「cui8ilayer」で通し番号「cui8itile」の牌を設定します。
	//		「cui8itile」を「0」で呼び出すと、牌が除去されます。
	//		牌設定、除去共に「2x2」単位で処理を行うので田の字4回呼び出しは不要ですが、
	//		(まとめ更新に都合良きよう)表示更新はしないので、
	//		必要な設定完了し次第、「stDraw」を呼び出してください。
	static VOID				stWrite(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile)noexcept{
		if(cui8itile){
			CAUTO					cui16ctile=UINT16(cui8itile);

			staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=cui16ctile|0x0000;
			staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=cui16ctile|0x0100;
			staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+0]=cui16ctile|0x0200;
			staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+1]=cui16ctile|0x0300;
		}else{
			if(
				CAUTO					cui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
				cui16ctile
			)switch(cui16ctile&0x0300){
			case 0x0000:
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+1]=0x0000;
				break;
			case 0x0100:
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix-1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix-1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+0]=0x0000;
				break;
			case 0x0200:
				staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=0x0000;
				break;
			case 0x0300:
				staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix-1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix-1]=0x0000;
				staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=0x0000;
				break;
			}
		}
		return;
	}
	//	VOID					stDraw(VOID)
	//		全画面更新します。
	//		残念な事に遅いので、初期表示時以外は位置指定するようにしてください。
	static VOID				stDraw(VOID)noexcept{
		for(UINT8 ui8ix=0;ui8ix<stcui8nWidth+2;++ui8ix)for(UINT8 ui8iy=0;ui8iy<stcui8nHeight+2;++ui8iy)stDraw_Layered(ui8ix,ui8iy,stcui8nLayer-1,stcui8nLayer-1);
		return;
	}
	//	VOID					stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		高さ「cui8ilayer」での、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		更新を行う「領域」は画面座標であり、高さが下る度パース的には「右下」に伸びるため、
	//		牌管理情報的には「左上」に遡ります。
	//		また、横っ面、影の更新も行うため、「右下」への拡張も行います。
	static _INLINE_ VOID	stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer=stcui8nLayer-1)noexcept{
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	もし牌があるなら左上起点になるよう補正
		if((cui8ix<stcui8nWidth)&&(cui8iy<stcui8nHeight))if(
			CAUTO					cui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
			cui16ctile
		)switch(cui16ctile&0x0300){
		case 0x0000:
			break;
		case 0x0100:
			--ui8ix;
			break;
		case 0x0200:
			--ui8iy;
			break;
		case 0x0300:
			--ui8ix;
			--ui8iy;
			break;
		}
		//	横っ面と影で右「(4+8)*(段番号+1)」ドット、下「(8+8)*(段番号+1)」ドット拡大があるので、
		//	その表示範囲をカバーすべく、処理範囲を決定。
		{
			CAUTO					ci16nextensionwidth=INT16((4+8)*INT16(cui8ilayer+1)+32);

			for(
				AUTO					i16nextensionheight=INT16((8+8)*INT16(cui8ilayer+1)+48);
				0<i16nextensionheight;
				i16nextensionheight-=24
			){
				AUTO					ui8ix_current=ui8ix;

				for(
					AUTO					i8nextensionwidth=ci16nextensionwidth;
					0<i8nextensionwidth;
					i8nextensionwidth-=16
				){
					stDraw_Layered(ui8ix_current,ui8iy,cui8ilayer,cui8ilayer);
					++ui8ix_current;
				}
				++ui8iy;
			}
		}
		return;
	}
private:
	//	VOID					stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8ilayershowing)
	//		高さ「cui8ilayershowing」での、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		「cui8ilayer」は処理対象段番号で、「cui8ilayershowing」と異なるなら、
	//		それは描画範囲が右下に寄っているという事です。
	static VOID				stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8ilayershowing)noexcept{
		CAUTO					cv2idestination=VECTOR2(
			INT16(((cui8ix*2+stcui8iXBasis)<<3)-(cui8ilayershowing<<2)),
			INT16(((cui8iy*3+stcui8iYBasis)<<3)-(cui8ilayershowing<<3))
		);

		//	背景
		//	「cui8ix」、「cui8iy」は範囲外の可能性あり
		if(cui8ilayer){
			//	再帰呼び出しして1段下の様子描画を行います。
			//	牌の表面描画がある場合は省略しても構わんのですが、
			//	角とか透過させられるよう、毎回描画することにします。
			stDraw_Layered(cui8ix,cui8iy,cui8ilayer-1,cui8ilayershowing);
		}else{
			//	最下段時、床面表示する
#ifdef SHOWBACKBITMAP
			stcvsWork.CopyRect(stccvsBack,{cv2idestination,stcvsWork.stcv2nSize},VECTOR2::stv2ImmediateZero());
#else
			stcvsWork.Fill(stcui16cColorBack);
#endif
		}
		{
			CAUTO					cui8doffset=cui8ilayershowing-cui8ilayer;
			//	VECTOR2					cv2idestination_minimum
			//		最下段時、位置「(4,8)」ずらしで床面影描画を行うので、
			//		表示対象に入るよう、下限値をマイナスにする。
			CAUTO					cv2idestination_minimum=(cui8ilayer==0)?VECTOR2(-4,-8):VECTOR2::stv2ImmediateZero();
			AUTO					v2idestination=VECTOR2(
				INT16(cui8doffset<<2),
				INT16(cui8doffset<<3)
			);
			AUTO					ui8ix=cui8ix;
			AUTO					ui8iy=cui8iy;

			//	下面描画のため「左上遡り」をするが、
			//	横「-16」以下、「+16」以上は表示対象から外れるので、
			//	最小限遡っておく。
			while(cv2idestination_minimum.i16iX()<v2idestination.i16iX()){
				v2idestination.i16iX()-=16;
				--ui8ix;
			}
			//	縦は24ドット基準。
			while(cv2idestination_minimum.i16iY()<v2idestination.i16iY()){
				v2idestination.i16iY()-=24;
				--ui8iy;
			}
			{
				CAUTO					ci16idestinationx_origin=v2idestination.i16iX();

				for(;v2idestination.i16iY()<24;v2idestination.i16iY()+=24){
					AUTO					ui8ix_current=ui8ix;

					for(v2idestination.i16iX()=ci16idestinationx_origin;v2idestination.i16iX()<16;v2idestination.i16iX()+=16){
						stDraw_Layered_Positioned(v2idestination,ui8ix_current,ui8iy,cui8ilayer);
						++ui8ix_current;
					}
					++ui8iy;
				}
			}
		}
		if(cui8ilayer==cui8ilayershowing)GRAPHIC::stCopy(stcvsWork,cv2idestination);
		return;
	}
	//	VOID					stDraw_Layered_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		表示位置「cv2idestination」への、高さ「cui8ilayer」、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		牌の表面以外、表示範囲に含まれる側面、床面、影の描画も行います。
	//		床面への影描画はオフセット「(+4,+8)」があるため、横「-19」、縦「-31」までは描画がありえます。
	static VOID				stDraw_Layered_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		CAUTO					cerange=OFWBOOL((cui8ix<stcui8nWidth)&&(cui8iy<stcui8nHeight));
		CAUTO					ceup1=(cerange&&(cui8ilayer<stcui8nLayer-1))?(staaaui16cTile[cui8ilayer+1][cui8iy][cui8ix]!=0):FALSE;
		CAUTO					ceup2=(cerange&&(cui8ilayer<stcui8nLayer-2))?(staaaui16cTile[cui8ilayer+2][cui8iy][cui8ix]!=0):FALSE;

		if(!ceup2){
			CAUTO					cex0=OFWBOOL(cui8ix<stcui8nWidth);
			CAUTO					cex1=OFWBOOL((1<=cui8ix)&&(cui8ix<stcui8nWidth+1));
			CAUTO					cey0=OFWBOOL(cui8iy<stcui8nHeight);
			CAUTO					cey1=OFWBOOL((1<=cui8iy)&&(cui8iy<stcui8nHeight+1));
			CAUTO					cex0y0=OFWBOOL(cex0&&cey0);
			CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
			CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
			CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
			CAUTO					cui16cx0y1=cex0y1?staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix+0]:UINT16(0x0000);
			CAUTO					cui16cx1y1=cex1y1?staaaui16cTile[cui8ilayer][cui8iy-1][cui8ix-1]:UINT16(0x0000);
			CAUTO					cui16cx1y0=cex1y0?staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix-1]:UINT16(0x0000);

			//	側壁
			if(cui16cx1y1){
				switch(cui16cx1y1&0x0300){
				case 0x0000:
					//	状況的にあり得ない
					break;
				case 0x0100:
					stcvsWork.CopyRect(stccvsTile,{{64,240+24},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						//	+-----------+--   + //
						//	|     |X1Y1 |X0Y1   //
						//	|           |       //
						//	|           |       //
						//	|           |       //
						//	|0000  0100 |0200 | //
						//	|--   +   --|------ //
						//	|           |\X0Y0  //	6	d
						//	|           | +---- //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|0200 |0300 | |     //	b	0
						//	+-----------+ |     //
						stcvsWork.CopyRect(stccvsTile,{{96,240+ 0},{16,8}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+-----------+X0Y1   //
						//	|     |X1Y1 |\      //
						//	|           | +     //
						//	|           | |     //
						//	|           | |     //
						//	|0000  0100 | |     //
						//	|--   +   --| |     //
						//	|           | |X0Y0 //	a	0
						//	|           | |     //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|0200 |0300 | |     //	b	0
						//	+-----------+ |     //
					}
					break;
				case 0x0200:
					stcvsWork.CopyRect(stccvsTile,{{96+16,240+ 0},{16,8}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |0200 |0300 | //
						//	------+-----------+ //
						//	|     |X1Y0 |\X0Y0  //	4	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|0000  0100 | |     //	a	0
						//	|--   +   --| |     //
						stcvsWork.CopyRect(stccvsTile,{{64,240+ 0},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |0200 |0300 | //
						//	------+-----------+ //
						//	       \X1Y0  X0Y0  //	d	e
						//	--------+---------- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
					break;
				case 0x0300:
					stcvsWork.CopyRect(stccvsTile,{{128,240+ 0},{4,8}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						stcvsWork.CopyRect(stccvsTile,{{96+ 0,240+ 0},{16,8}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						if(cui16cx1y0){
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|0200 |0300 |0200 | //
							//	+-----------+------ //
							//	|     |X1Y0 |\X0Y0  //	2	d
							//	|           | +---- //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|0000  0100 | |     //	a	0
							//	|--   +   --| |     //
							stcvsWork.CopyRect(stccvsTile,{{64,240+ 0},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|0200 |0300 |0200 | //
							//	+-----------+------ //
							//	 \     X1Y0  \X0Y0  //	5	d
							//	  +-----------+---- //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}else{
						if(cui16cx1y0){
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|0200 |0300 | |     //
							//	+-----------+ |     //
							//	|     |X1Y0 |\|X0Y0 //	3	0
							//	|           | +     //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|0000  0100 | |     //	a	0
							//	|--   +   --| |     //
							stcvsWork.CopyRect(stccvsTile,{{64,240+ 0},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|0200 |0300 | |     //
							//	+-----------+ |     //
							//	 \           \|X0Y0 //	f	0
							//	  +-----------+     //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}
					break;
				}
			}else{
				if(cui16cx0y1){
					stcvsWork.CopyRect(stccvsTile,{{96+ 0,240+ 0},{16,8}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |0200 | //
						//	+-----------+------ //
						//	|     |X1Y0 |\X0Y0  //	2	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|0000  0100 | |     //	a	0
						//	|--   +   --| |     //
						stcvsWork.CopyRect(stccvsTile,{{64,240+ 0},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |0200 | //
						//	            +------ //
						//	        X1Y0 \X0Y0  //	c	d
						//	              +---- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}else{
					if(cui16cx1y0){
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	+-----------+       //
						//	|     |X1Y0 |\X0Y0  //	8	0
						//	|           | +     //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|0000  0100 | |     //	a	0
						//	|--   +   --| |     //	
						stcvsWork.CopyRect(stccvsTile,{{64,240+ 0},{4,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	             X0Y1   //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	        X1Y0 X0Y0   //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}
			}
		}
		if(!ceup1){
			if(
				CAUTO					cui16ctile=cerange?staaaui16cTile[cui8ilayer][cui8iy][cui8ix]:UINT16(0x0000);
				cui16ctile
			){
				CAUTO&					acui8ipattern=staacui8iPattern[(cui16ctile&0xff)-1];
				CAUTO					cv2isource=VECTOR2(INT16(acui8ipattern[0]),INT16(acui8ipattern[1]));

				//	表面
				switch(cui16ctile&0x0300){
				case 0x0000:
					stDraw_Layered_Positioned_Face(
						cv2idestination,
						{INT16(cv2isource.i16iX()+ 0),INT16(cv2isource.i16iY()+ 0)}
					);
					stDraw_Layered_Positioned_Shadow(
						cv2idestination,
						cui8ix,cui8iy,cui8ilayer+1
					);
					break;
				case 0x0100:
					stDraw_Layered_Positioned_Face(
						cv2idestination,
						{INT16(cv2isource.i16iX()+16),INT16(cv2isource.i16iY()+ 0)}
					);
					stDraw_Layered_Positioned_Shadow(
						cv2idestination,
						cui8ix,cui8iy,cui8ilayer+1
					);
					break;
				case 0x0200:
					stDraw_Layered_Positioned_Face(
						cv2idestination,
						{INT16(cv2isource.i16iX()+ 0),INT16(cv2isource.i16iY()+24)}
					);
					stDraw_Layered_Positioned_Shadow(
						cv2idestination,
						cui8ix,cui8iy,cui8ilayer+1
					);
					break;
				case 0x0300:
					stDraw_Layered_Positioned_Face(
						cv2idestination,
						{INT16(cv2isource.i16iX()+16),INT16(cv2isource.i16iY()+24)}
					);
					stDraw_Layered_Positioned_Shadow(
						cv2idestination,
						cui8ix,cui8iy,cui8ilayer+1
					);
					break;
				}
			}else{
				//	最下段時、床面への影表示を行います。
				if(cui8ilayer==0)stDraw_Layered_Positioned_Shadow(
					{INT16(cv2idestination.i16iX()+4),INT16(cv2idestination.i16iY()+8)},
					cui8ix,cui8iy,0
				);
			}
		}
		return;
	}
	static VOID				stDraw_Layered_Positioned_Face(CVECTOR2& cv2idestination,CVECTOR2& cv2isource)noexcept{
		stcvsWork.CopyRect(stccvsTile,{cv2isource,{16,24}},cv2idestination,IDBLEND::BackNega_SourceAlpha);
		return;
	}
	static VOID				stDraw_Layered_Positioned_Shadow(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer1)noexcept{
		//	影
		//	<X1Y0>    |  +              <X2Y0>    |  |  +                           <X0Y1>    |  |  +   <X1Y1>-+  |  |  +           <X2Y1>-+  |  |  +                       <X1Y2>-+  |  |  +           <X2Y2>-+  |  |  +                       //
		//	|         |  |\             |         |  |  |\                          |         |  |  |           \ |  |  |＼                 \ |  |  |＼                             \ |  |  |＼                 \ |  |  |＼                     //
		//	|         |  | \            |         |  |  | \                         |         |  |  |   L3       \|  |  |  ＼       L3       \|  |  |  ＼                   L3       \|  |  |  ＼       L3       \|  |  |  ＼                   //
		//	|         |  |  +---------+ +---------+  |  |  +         +---------+    +---------+  |  |   +---------+  |  |    \      +---------+  |  |    \                  +---------+  |  |    \      +---------+  |  |    \                  //
		//	|         |  |  |＼  |＼  |  \         \ |  |  |＼       |＼  |＼  |     \         \ |  |    \         \ |  |    |＼     \         \ |  |    |＼                 \         \ |  |    |＼     \         \ |  |    |＼                //
		//	|         |  |  |L1＼|  ＼|   \L3       \|  |  |  ＼     |  ＼|  ＼|      \L2       \|  |     \L2       \|  |    |  ＼    \L2       \|  |    |  ＼                \L2       \|  |    |  ＼    \L2       \|  |    |  ＼              //
		//	+---------+  |  |----+----|    +---------+  |  |    \    |----+----|       +---------+  |      +---------+  |    |    \    +---------+  |    |    \                +---------+  |    |    \    +---------+  |    |    \             //
		//	 \         \ |  |＼L1|＼  |     \         \ |  |    |＼  |＼  |＼  |        \         \ |       \         \ |    |    |     \         \ |    |    |＼               \         \ |    |    |     \         \ |    |    |＼           //
		//	  \L2       \|  |L1＼|L2＼|      \L2       \|  |    |  ＼|  ＼|  ＼|         \L1       \|        \L1       \|(L1)|(L2)|      \L1       \|(L1)|(L2)|  ＼              \L1       \|    |    |      \L1       \|    |    |  ＼         //
		//	   +---------+  |----+----|       +---------+  |    |    |----+----|          +---------+         +---------+---------+       +---------+---------+---------+         +---------+(L1)|    |       +---------+(L1)|    |    \        //
		//	    \         \ |＼L1|＼L2|        \         \ |    |    |＼  |＼  |          |＼L1|＼L1|          ＼       |＼L1|＼L2|        ＼        ＼  |    |＼L3|＼  |          ＼        ＼  |    |        ＼        ＼  |    |    |＼      //
		//	     \L1       \|L1＼|L2＼|         \L1       \|    |    |L3＼|  ＼|          |  ＼|L1＼|            ＼(L1) |L1＼|L2＼|          ＼(L1)    ＼|    |L3＼|L4＼|            ＼(L1)    ＼|    |          ＼(L1)    ＼|    |    |  ＼    //
		//	      +---------+---------+          +---------+(L1)|(L2)+---------+          |----+----|              \----|----+----|            \---------\----|----+----|              \---------\(L2)|            \---------\(L2)|    |    \   //
		//	                                                                              |＼  |＼L2|               ＼  |＼L2|＼L2|             ＼        ＼  |＼L3|＼L4|               ＼        ＼  |             ＼        ＼  |    |    |   //
		//	                                                                              |  ＼|  ＼|                 ＼|L2＼|L2＼|               ＼(L2)    ＼|L3＼|L4＼|                 ＼(L2)    ＼|               ＼(L2)    ＼|    |    |   //
		//	                                                                              |----+----|                   |----+----|                 \---------|----+----|                   \---------\                 \---------\(L3)|    |   //
		//	                                                                              |＼  |＼  |                   |＼L3|＼L3|                  ＼       |＼L3|＼L4|                    ＼                          ＼        ＼  |(L4)|   //
		//	                                                                              |  ＼|  ＼|                   |  ＼|L3＼|                    ＼(L3) |L3＼|L4＼|                      ＼(L3)                      ＼(L3)    ＼|    |   //
		//	                                                                              +---------+                   +---------+                      \--- +---------+                   +----+----+                      \----+----+----+   //
		//	                                                                                                                                                                                |＼  |＼L4|                       ＼  |＼L4|＼L4|   //
		//	                                                                                                                                                                                |  ＼|  ＼|                         ＼|L4＼|L4＼|   //
		//	                                                                                                                                                                                |----+----|                           |----+----|   //
		//	                                                                                                                                                                                |＼  |＼  |                           |＼  |＼  |   //
		//	                                                                                                                                                                                |  ＼|  ＼|                           |  ＼|  ＼|   //
		//	                                                                                                                                                                                |----+----|                           |----+----|   //
		//	                                                                                                                                                                                |＼  |＼  |                           |＼  |＼  |   //
		//	                                                                                                                                                                                |  ＼|  ＼|                           |  ＼|  ＼|   //
		//	                                                                                                                                                                                +---------+                           +---------+   //
		CAUTO					cui8ix0=UINT8(cui8ix);
		CAUTO					cui8ix1=UINT8(cui8ix-1);
		CAUTO					cui8ix2=UINT8(cui8ix-2);
		CAUTO					cui8iy0=UINT8(cui8iy);
		CAUTO					cui8iy1=UINT8(cui8iy-1);
		CAUTO					cui8iy2=UINT8(cui8iy-2);
		CAUTO					cui8ilayer2=cui8ilayer1+1;
		CAUTO					cui8ilayer3=cui8ilayer1+2;
		CAUTO					cui8ilayer4=cui8ilayer1+3;
		CAUTO					cex0=OFWBOOL(cui8ix0<stcui8nWidth);
		CAUTO					cex1=OFWBOOL(cui8ix1<stcui8nWidth);
		CAUTO					cex2=OFWBOOL(cui8ix2<stcui8nWidth);
		CAUTO					cey0=OFWBOOL(cui8iy0<stcui8nHeight);
		CAUTO					cey1=OFWBOOL(cui8iy1<stcui8nHeight);
		CAUTO					cey2=OFWBOOL(cui8iy2<stcui8nHeight);
		CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
		CAUTO					cex2y0=OFWBOOL(cex2&&cey0);
		CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
		CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
		CAUTO					cex2y1=OFWBOOL(cex2&&cey1);
		CAUTO					cex1y2=OFWBOOL(cex1&&cey2);
		CAUTO					cex2y2=OFWBOOL(cex2&&cey2);
		CAUTO					cel1=OFWBOOL(cui8ilayer1<stcui8nLayer);
		CAUTO					cel2=OFWBOOL(cui8ilayer2<stcui8nLayer);
		CAUTO					cel3=OFWBOOL(cui8ilayer3<stcui8nLayer);
		CAUTO					cel4=OFWBOOL(cui8ilayer4<stcui8nLayer);
		//	<X1Y0>
		CAUTO					cex1y0l1=(cex1y0&&cel1)?OFWBOOL(staaaui16cTile[cui8ilayer1][cui8iy0][cui8ix1]):FALSE;
		CAUTO					cex1y0l2=(cex1y0&&cel2)?OFWBOOL(staaaui16cTile[cui8ilayer2][cui8iy0][cui8ix1]):FALSE;
		//	<X2Y0>
		CAUTO					cex2y0l3=(cex2y0&&cel3)?OFWBOOL(staaaui16cTile[cui8ilayer3][cui8iy0][cui8ix2]):FALSE;
		//	<X0Y1>
		CAUTO					cex0y1l1=(cex0y1&&cel1)?OFWBOOL(staaaui16cTile[cui8ilayer1][cui8iy1][cui8ix0]):FALSE;
		CAUTO					cex0y1l2=(cex0y1&&cel2)?OFWBOOL(staaaui16cTile[cui8ilayer2][cui8iy1][cui8ix0]):FALSE;
		//	<X1Y1>
		CAUTO					cex1y1l1=(cex1y1&&cel1)?OFWBOOL(staaaui16cTile[cui8ilayer1][cui8iy1][cui8ix1]):FALSE;
		CAUTO					cex1y1l2=(cex1y1&&cel2)?OFWBOOL(staaaui16cTile[cui8ilayer2][cui8iy1][cui8ix1]):FALSE;
		CAUTO					cex1y1l3=(cex1y1&&cel3)?OFWBOOL(staaaui16cTile[cui8ilayer3][cui8iy1][cui8ix1]):FALSE;
		//	<X2Y1>
		CAUTO					cex2y1l3=(cex2y1&&cel3)?OFWBOOL(staaaui16cTile[cui8ilayer3][cui8iy1][cui8ix2]):FALSE;
		CAUTO					cex2y1l4=(cex2y1&&cel4)?OFWBOOL(staaaui16cTile[cui8ilayer4][cui8iy1][cui8ix2]):FALSE;
		//	<X1Y2>
		CAUTO					cex1y2l4=(cex1y2&&cel4)?OFWBOOL(staaaui16cTile[cui8ilayer4][cui8iy2][cui8ix1]):FALSE;
		//	<X2Y2>
		CAUTO					cex2y2l4=(cex2y2&&cel4)?OFWBOOL(staaaui16cTile[cui8ilayer4][cui8iy2][cui8ix2]):FALSE;
		//	+---------+
		//	|＼0A|＼1A|
		//	|0B＼|1B＼|
		//	|----+----|
		//	|＼2A|＼3A|
		//	|2B＼|3B＼|
		//	|----+----|
		//	|＼4A|＼5A|
		//	|4B＼|5B＼|
		//	+---------+
		CAUTO					ce0a=OFWBOOL(cex0y1l1||cex1y1l1||cex2y1l3||cex2y2l4);
		CAUTO					ce0b=OFWBOOL(cex1y0l1||cex1y1l1||cex2y1l3||cex2y2l4);
		CAUTO					ce1a=OFWBOOL(cex0y1l1||cex1y1l2||cex1y2l4||cex2y2l4);
		CAUTO					ce1b=OFWBOOL(cex0y1l1||cex1y1l2||cex2y1l4||cex2y2l4);
		CAUTO					ce2a=OFWBOOL(cex1y0l1||cex1y1l2||cex2y1l3);
		CAUTO					ce2b=OFWBOOL(cex1y0l1||cex1y1l2||cex2y1l3);
		CAUTO					ce3a=OFWBOOL(cex0y1l2||cex1y1l2||cex2y1l4);
		CAUTO					ce3b=OFWBOOL(cex1y0l2||cex1y1l2||cex2y1l4);
		CAUTO					ce4a=OFWBOOL(cex1y0l1||cex1y1l3||cex2y1l3);
		CAUTO					ce4b=OFWBOOL(cex1y0l1||cex2y0l3||cex2y1l3);
		CAUTO					ce5a=OFWBOOL(cex1y0l2||cex1y1l3||cex2y1l4);
		CAUTO					ce5b=OFWBOOL(cex1y0l2||cex1y1l3||cex2y1l4);
		CAUTO					cui8i0=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce0a,ce0b);
		CAUTO					cui8i1=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce1a,ce1b);
		CAUTO					cui8i2=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce2a,ce2b);
		CAUTO					cui8i3=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce3a,ce3b);
		CAUTO					cui8i4=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce4a,ce4b);
		CAUTO					cui8i5=stui8iDraw_Layered_Positioned_Shadow_GetOffset(ce5a,ce5b);

		if(cui8i0)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i0),248},{8,8}},{INT16(cv2idestination.i16iX()+ 0),INT16(cv2idestination.i16iY()+ 0)},IDBLEND::BackNega_SourceAlpha);
		if(cui8i1)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i1),248},{8,8}},{INT16(cv2idestination.i16iX()+ 8),INT16(cv2idestination.i16iY()+ 0)},IDBLEND::BackNega_SourceAlpha);
		if(cui8i2)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i2),248},{8,8}},{INT16(cv2idestination.i16iX()+ 0),INT16(cv2idestination.i16iY()+ 8)},IDBLEND::BackNega_SourceAlpha);
		if(cui8i3)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i3),248},{8,8}},{INT16(cv2idestination.i16iX()+ 8),INT16(cv2idestination.i16iY()+ 8)},IDBLEND::BackNega_SourceAlpha);
		if(cui8i4)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i4),248},{8,8}},{INT16(cv2idestination.i16iX()+ 0),INT16(cv2idestination.i16iY()+16)},IDBLEND::BackNega_SourceAlpha);
		if(cui8i5)stcvsWork.CopyRect(stccvsTile,{{INT16(cui8i5),248},{8,8}},{INT16(cv2idestination.i16iX()+ 8),INT16(cv2idestination.i16iY()+16)},IDBLEND::BackNega_SourceAlpha);
		return;
	}
	static constexpr UINT8	stui8iDraw_Layered_Positioned_Shadow_GetOffset(COFWBOOL cea,COFWBOOL ceb)noexcept{
		//	+----+----+
		//	|＼0A|＼1A|
		//	|0B＼|1B＼|
		//	|----+----+
		//	|＼2A|＼3A|
		//	|2B＼|3B＼|
		//	|----+----+
		//	|＼4A|＼5A|
		//	|4B＼|5B＼|
		//	+---------+
		return 96+(cea?8:0)+(ceb?16:0);
	}
};

//
//		user
//

VOID					USER_New(VOID)noexcept{
	USER::stNew();
	for(UINT8 ui8itile=0;ui8itile<USER::stcui8nTile;++ui8itile){
		CAUTO&					acui8iarrangement=USER::staacui8iArrangement[ui8itile];

		USER::stWrite(acui8iarrangement[0],acui8iarrangement[1],acui8iarrangement[2],ui8itile+1);
	}
	USER::stDraw();
	return;
}

VOID					USER_Delete(VOID)noexcept{
	USER::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	return;
}
