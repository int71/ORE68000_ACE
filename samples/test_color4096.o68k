//
//		include
//

#include				<sub/os.hpp>
#include				<sub/graphic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//
//		user
//

VOID					USER_New(VOID)noexcept{
//	CAUTO		ccvssource=__O68K_CANVAS_RGB_ROM("(Resource)/OREDIUS68K.png");
	CAUTO		ccvssource=[](VOID)noexcept{
		static constexpr UINT16	stacui16cimage[]={
			//	R
			0xffff,0x0fff,0xffff,0x0fff,
			0xf000,0x00ff,0xf000,0x00ff,
			0xf000,0x00ff,0xf000,0x00ff,
			0xffff,0xffff,0xffff,0xffff,
			0xf000,0x00ff,0xf000,0x00ff,
			0xf000,0x00ff,0xf000,0x00ff,
			0xf000,0x00f0,0xf000,0x00f0,
			0xffff,0x0f0f,0xffff,0x0f0f,
			//	G
			0xffff,0xff0f,0xffff,0xff0f,
			0xf000,0x000f,0xf000,0x000f,
			0xf000,0x0000,0xf000,0x0000,
			0xffff,0xffff,0xffff,0xffff,
			0xf000,0x0000,0xf000,0x0000,
			0xf000,0x000f,0xf000,0x000f,
			0xf000,0x0000,0xf000,0x0000,
			0xffff,0xff0f,0xffff,0xff0f,
			//	B
			0xffff,0xff0f,0xffff,0xff0f,
			0xf000,0x000f,0xf000,0x000f,
			0xf000,0x0000,0xf000,0x0000,
			0xffff,0xffff,0xffff,0xffff,
			0xf000,0x0000,0xf000,0x0000,
			0xf000,0x000f,0xf000,0x000f,
			0xf000,0x0000,0xf000,0x0000,
			0xffff,0xff0f,0xffff,0xff0f,
			//	A
			0xffff,0xff0f,0xffff,0xff0f,
			0x0fff,0xff0f,0xffff,0xff0f,
			0xffff,0xff0f,0xffff,0xff0f,
			0x0fff,0xff0f,0xffff,0xff0f,
			0xffff,0xff0f,0xffff,0xff0f,
			0x0fff,0xff0f,0xffff,0xff0f,
			0xffff,0xff0f,0xffff,0xff0f,
			0x0fff,0xff0f,0xffff,0xff0f,
			//	Guard
			0x0000,0x0000
		};

		return CANVAS_RGBA_ROM<16,8>(stacui16cimage);
	}();
	AUTO		cvsrgb=CANVAS_RGB_RAM<16,16>();
	AUTO		cvsa=CANVAS_A_RAM<16,16>();

	GRAPHIC::stNew(TRUE);
	cvsrgb.Fill(0x0707);
	cvsa.Fill(0x3);
	for(UINT16 ui16icounter=0;ui16icounter<16;++ui16icounter){
//		GRAPHIC::stFillRect(0x7f0f,{{INT16(ui16icounter),INT16(ui16icounter<<3)},{INT16(16),INT16(16)}},GRAPHIC::IDBLEND::BackNega_SourceAlpha);
		GRAPHIC::stCopyAlpha(cvsrgb,cvsa,{INT16(ui16icounter),INT16(ui16icounter<<3)},GRAPHIC::IDBLEND::BackNega_SourceAlpha);
	}
	return;
}

VOID					USER_Delete(VOID)noexcept{
	GRAPHIC::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	static UINT16			stui16iposition=0;

	++stui16iposition;
	return;
}
