//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;

//
//		user
//

UINT16					ui16iX=0;
UINT16					ui16iY=48;
UINT16					ui16iPattern0=0;
UINT16					ui16iPattern1=0;

VOID					USER_New(VOID)noexcept{
	static constexpr UINT16	stcui16cattribute[]={
		0x80c0,0x80c0,0x80c0,0x80c0,0x90c1,0x90c1,0x90c1,0x90c1,0x80c2,0x80c2,0x80c2,0x80c2,0x90c3,0x90c3,0x90c3,0x90c3,
		0x80c4,0x80c5,0x80c5,0x80c5,0x80c5,0x80c5,0x80c5,0x80c6,0x90c4,0x90c5,0x90c5,0x90c5,0x90c5,0x90c5,0x90c5,0x90c6
	};

	FAMILYBASIC::stNew();
	FAMILYBASIC::PALETTE_stWriteSet(0,1);
	FAMILYBASIC::BG0_stWriteAttribute({0,8},stcui16cattribute,UINT16(SIZEOF(stcui16cattribute)));
	VIDEO_DRIVER::VRAM_TEXT_stWrite(0,0,"グラフィック画面でのテキスト表示",1);
	DEBUG::stWriteLine("仮想シリアル出力");
	return;
}

VOID					USER_Delete(VOID)noexcept{
	FAMILYBASIC::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	FAMILYBASIC::SPRITE_stWrite16(0,VECTOR2((ui16iX>>1)+ 0,ui16iY+ 0),(ui16iPattern0>>1)+0x1c,2);
	FAMILYBASIC::SPRITE_stWrite16(1,VECTOR2((ui16iX>>1)+32,ui16iY+ 0),(ui16iPattern1>>1)+0x70,3);
	--ui16iX;
	++ui16iPattern0;
	if(ui16iPattern0==0x18)ui16iPattern0=0;
	ui16iPattern1+=2;
	if(ui16iPattern1==0x10)ui16iPattern1=0;
	return;
}
