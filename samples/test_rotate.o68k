//
//		include
//

#include				<sub/familybasic.hpp>

//
//		macro
//

#define __O68K_ROTATE

//
//		using
//

using namespace m68k::i71::sub;
using					FB=FAMILYBASIC_R<FAMILYBASIC::IDRESOLUTION::n320x240>;

//
//		user
//

VECTOR2					v2iPosition={120,98};

VOID					USER_New(VOID)noexcept{
	FB::stNew();
	FB::PALETTE_stWriteSet(1,1);
	FB::BG0_stPrint({2,3},"TEST:ROTATE",0);
	return;
}

VOID					USER_Delete(VOID)noexcept{
	FB::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	using					IDBUTTON=FB::JOYSTICK_IDBUTTON;
	CAUTO					cui8cjoystick=FB::CONTROLLER_stui8cRead(0);

	FB::SPRITE_stWrite16(0,v2iPosition,172,0);
	if(cui8cjoystick&(1<<IDBUTTON::Right))++v2iPosition.i16iX();
	if(cui8cjoystick&(1<<IDBUTTON::Left))--v2iPosition.i16iX();
	if(cui8cjoystick&(1<<IDBUTTON::Down))++v2iPosition.i16iY();
	if(cui8cjoystick&(1<<IDBUTTON::Up))--v2iPosition.i16iY();
	return;
}
