 ****************************************************************************/

//	カメ救い
//		貴方は「カメの神様」です。
//		「一般ガメ」が漠然と地表におりますので、水場に移動させてください。
//		なぜなら「X虫」が「一般ガメ」をゲットして持ち去ろうとするからです。
//		貴方は「一般ガメ」を救う事が出来るでしょうか。
//
//		<ルール>
//		・「カメの神様」は「つかみ」と「ハジキ」のテクが使える
//		・「一般ガメ」全員を「つかみ」で水場に移動させればクリア
//		・「X虫」は「一般ガメ」を持ち去る
//		・「X虫」は「ハジキ」で退治できる
//		・「ハジキ」は1点消費する(のでゲーム開始直後は使えない)
//		・以下で「MISS」が増え、コレが3になるとゲームオーバー
//		  ・「一般ガメ」が画面下に落ちた
//		  ・「一般ガメ」が「X虫」によって画面上に持ち去られた
//		  ・「一般ガメ」を「地形」に移動させた(いわゆる「壁の中にいる」状態)
//		  ・ピヨった「一般ガメ」を水場に放り込んだ(溺死)
//		<ルール詳細>
//		・「一般ガメ」は高いところから落ちるとピヨる
//		・ピヨった「一般ガメ」は一定時間で起きる
//		・「X虫」は地形を無視する
//		・「X虫」は水が苦手なので水場に移動した「一般ガメ」は持ち去れない
//		・「X虫」は「ハジキ」で退治できる(点にはならない)
//		・「一般ガメ」持ち去り中の「X虫」も「ハジキ」で退治できる(点にはならない)
//		・「一般ガメ」にも「ハジキ」は当たり、くたばりはしないがピヨる。
//		・「X虫」は退治すれば「つかみ」が出来る
//		・退治した「X虫」は水場に放り込むとエサになり、「一般ガメ」が「X虫」を食うと点になる
//		<その他>
//		・「ハジキ」は核融合
//		・通常移動時の「X虫」はワ──プしている(ので地形無視)
//		・そのため実は羽無しで飛べるが、羽があった方がカッコヨイと思っている

//
//		include
//

#include				<sub/familybasic.hpp>

//
//		using
//

using namespace m68k::i71::sub;
using					FB=FAMILYBASIC;

//
//		class
//

//	GAME
class GAME;
using					CGAME=const GAME;
using					PGAME=GAME*;
using					PCGAME=CGAME*;

//
//		class:GAME
//

//	GAME
//		動作に必要なデータ、共通処理等を置きます。
//		グローバル変数、関数でも構わないのですが、クラスにしとくと、
//		後で「2人交互プレー対応」が必要になったりしても慌てずに済みます。
class GAME{
public:

	//
	//		const
	//

	//	IDSTATE
	enum class IDSTATE:UINT8{
		Title,
		Start,
		Normal,
		Clear,
		Next,
		GameOver
	};
	//	UINT8					FIXEDU_stcui8nBit
	//		固定小数点値の整数部ビット数を示します。
	//		「INT16」で「+320」を表現するなら、「10」が最小値になります。
	static constexpr UINT8	FIXEDU_stcui8nBit=		10;
	static constexpr INT16	FIXEDU_stci16nSize=		1<<FIXEDU_stcui8nBit;
	static constexpr INT16	FIXEDU_stci16cMask=		FIXEDU_stci16nSize-1;
	//	UINT8					FIXEDL_stcui8nBit
	//		固定小数点値の小数部ビット数を示します。
	static constexpr UINT8	FIXEDL_stcui8nBit=		16-FIXEDU_stcui8nBit;
	static constexpr INT16	FIXEDL_stci16nSize=		1<<FIXEDL_stcui8nBit;
	static constexpr INT16	FIXEDL_stci16cMask=		FIXEDL_stci16nSize-1;
	static constexpr INT16	FIXED_stci16cMask_Lower=	FIXEDL_stci16nSize-1;
	static constexpr INT16	FIXED_stci16cMask_Upper=	~FIXED_stci16cMask_Lower;
	static constexpr INT16	FIXED_stci16iPositionMinimum=	(  0-8)<<FIXEDL_stcui8nBit;
	static constexpr INT16	FIXED_stci16iPosisionXMaximum=	(256+8)<<FIXEDL_stcui8nBit;
	static constexpr INT16	FIXED_stci16iPosisionYMaximum=	(212+8)<<FIXEDL_stcui8nBit;
	static constexpr INT16	FIXED_stci16nSpeedMaximum=	256;
	static constexpr AUTO	FIXED_stcv2nHitHalf=	VECTOR2(8,8)<<FIXEDL_stcui8nBit;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iGod=	0;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iPeople_Normal=	1;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iPeople_Eating=	2;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iPeople_Out=	3;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iEnemy=	4;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iShoot=	5;
	static constexpr UINT8	PALETTE_SPRITE_stcui8iSplash=	6;
	static constexpr UINT8	SPRITE_stcui8iMaximum=	0x80;
	static constexpr UINT8	BG_stcui8nBit=			FIXEDL_stcui8nBit+3;
	static constexpr INT16	BG_stci16nSize=			1<<BG_stcui8nBit;
	static constexpr INT16	BG_stci16cMask=			BG_stci16nSize-1;
	static constexpr UINT8	BG_stcui8cSpaceStart=	0x20;
	static constexpr UINT8	BG_stcui8cSpaceEnd=		0xb8;
	static constexpr UINT8	BG_stcui8cWater=		0xff;
	static constexpr OFWBOOL	BG_steIsSpace(CUINT8 cui8cthis)noexcept{
		return ((BG_stcui8cSpaceStart<=cui8cthis)&&(cui8cthis<BG_stcui8cSpaceEnd));
	}
	static constexpr OFWBOOL	BG_steIsMovable(CUINT8 cui8cthis)noexcept{
		return (BG_steIsSpace(cui8cthis)||(cui8cthis==BG_stcui8cWater));
	}
