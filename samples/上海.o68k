//
//		クラス:COMMON
//

class COMMON{
public:
	static UINT8			stui8Divide24(CUINT16 cui16source)noexcept{
		//	「384/24=16」程度が得られれば良い。
		//	n*11/256
		CAUTO					cui8result=UINT8((cui16source*11)>>8);

		if(cui16source<UINT16(cui8result)*24)return cui8result-1;
		return cui8result;
	}
	template<CUINT8 cui8nRange>
	static UINT8			stui8Random(VOID)noexcept{
		return UINT8(((OS::LFSR_stui16Read()&0xff)*UINT16(cui8nRange))>>8);
	}
	template<CUINT8 cui8nThis,class CLASS>
	static VOID				stShuffle(CLASS* const cpxthis,CUINT8 cui8nrange=cui8nThis)noexcept{
		for(UINT8 ui8ilocal=0;ui8ilocal<cui8nrange;++ui8ilocal){
			CAUTO					cui8ilocal_source=stui8Random<cui8nThis>();
			CAUTO					cxsource=cpxthis[cui8ilocal_source];

			cpxthis[cui8ilocal_source]=cpxthis[ui8ilocal];
			cpxthis[ui8ilocal]=cxsource;
		}
		return;
	}
	static constexpr UINT8	stui8nGetLength(const PCUSTR cpcustrsource)noexcept{
		AUTO					pcustrsource=cpcustrsource;

		while(*pcustrsource)++pcustrsource;
		return pcustrsource-cpcustrsource;
	}
	static VOID				stWrite(const PUSTR cpustrdestination,CUINT16 cui16source)noexcept{
		PUSTR					pustrdestination=cpustrdestination;
		AUTO					ui16nrest=cui16source;
		UINT8					ui8idegree;
		OFWBOOL					ezero=FALSE;

		for(ui8idegree=0;100<=ui16nrest;++ui8idegree)ui16nrest-=100;
		if(ui8idegree){
			*pustrdestination='0'+ui8idegree;++pustrdestination;
			ezero=TRUE;
		}
		for(ui8idegree=0;10<=ui16nrest;++ui8idegree)ui16nrest-=10;
		if(ui8idegree||ezero){
			*pustrdestination='0'+ui8idegree;++pustrdestination;
			ezero=TRUE;
		}
		*pustrdestination='0'+ui16nrest;++pustrdestination;
		*pustrdestination=0;
		return;
	}
};

//
//		クラス:GAME
//

class GAME{
public:

	//
	//		定数
	//

	using					IDBLEND=GRAPHIC::IDBLEND;
	//	UINT8					staacui8iPattern[144][2]
	//		牌と絵柄パターンの対応を保持します。
	//		「{横,縦}」を単位として、牌144ヶ分あります。
	//		縦横の値は「牌_BITMAP_TILE.png」の座標に対応しており、
	//		わざわざ1牌単位で対応させているのは、
	//		「季節」と「花」が4牌別絵柄であるためです。
	static constexpr UINT8	staacui8iPattern[][2]={
		{0x00,0x00},{0x00,0x00},{0x00,0x00},{0x00,0x00},	//	一萬
		{0x20,0x00},{0x20,0x00},{0x20,0x00},{0x20,0x00},	//	二萬
		{0x40,0x00},{0x40,0x00},{0x40,0x00},{0x40,0x00},	//	三萬
		{0x60,0x00},{0x60,0x00},{0x60,0x00},{0x60,0x00},	//	四萬
		{0x80,0x00},{0x80,0x00},{0x80,0x00},{0x80,0x00},	//	伍萬
		{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},{0xa0,0x00},	//	六萬
		{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},{0xc0,0x00},	//	七萬
		{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},{0xe0,0x00},	//	八萬
		{0x00,0x30},{0x00,0x30},{0x00,0x30},{0x00,0x30},	//	九萬
		{0x20,0x30},{0x20,0x30},{0x20,0x30},{0x20,0x30},	//	一索
		{0x40,0x30},{0x40,0x30},{0x40,0x30},{0x40,0x30},	//	二索
		{0x60,0x30},{0x60,0x30},{0x60,0x30},{0x60,0x30},	//	三索
		{0x80,0x30},{0x80,0x30},{0x80,0x30},{0x80,0x30},	//	四索
		{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},{0xa0,0x30},	//	伍索
		{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},{0xc0,0x30},	//	六索
		{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},{0xe0,0x30},	//	七索
		{0x00,0x60},{0x00,0x60},{0x00,0x60},{0x00,0x60},	//	八索
		{0x20,0x60},{0x20,0x60},{0x20,0x60},{0x20,0x60},	//	九索
		{0x40,0x60},{0x40,0x60},{0x40,0x60},{0x40,0x60},	//	一筒
		{0x60,0x60},{0x60,0x60},{0x60,0x60},{0x60,0x60},	//	二筒
		{0x80,0x60},{0x80,0x60},{0x80,0x60},{0x80,0x60},	//	三筒
		{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},{0xa0,0x60},	//	四筒
		{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},{0xc0,0x60},	//	伍筒
		{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},{0xe0,0x60},	//	六筒
		{0x00,0x90},{0x00,0x90},{0x00,0x90},{0x00,0x90},	//	七筒
		{0x20,0x90},{0x20,0x90},{0x20,0x90},{0x20,0x90},	//	八筒
		{0x40,0x90},{0x40,0x90},{0x40,0x90},{0x40,0x90},	//	九筒
		{0x60,0x90},{0x60,0x90},{0x60,0x90},{0x60,0x90},	//	東
		{0x80,0x90},{0x80,0x90},{0x80,0x90},{0x80,0x90},	//	南
		{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},{0xa0,0x90},	//	西
		{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},{0xc0,0x90},	//	北
		{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},{0xe0,0x90},	//	白板
		{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},{0x00,0xc0},	//	緑發
		{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},{0x20,0xc0},	//	紅中
		{0x40,0xc0},{0x60,0xc0},{0x80,0xc0},{0xa0,0xc0},	//	季節
		{0xc0,0xc0},{0xe0,0xc0},{0x00,0xf0},{0x20,0xf0}		//	花
	};
	static constexpr UINT8	stcui8nTile=UINT8(SIZEOF(staacui8iPattern)/(SIZEOF(UINT8)*2));
	static constexpr UINT8	stcui8nWidth=15*2;
	static constexpr UINT8	stcui8nHeight=8*2;
	static constexpr UINT8	stcui8nLayer=5;
	static constexpr UINT8	stcui8nLayout=6;
	static constexpr UINT8	stcui8iTileUndefined=0xff;
	static constexpr UINT16	stcui16cTilePartMask=0x0300;
	static constexpr UINT16	stcui16cTilePartLU=0x0000;
	static constexpr UINT16	stcui16cTilePartRU=0x0100;
	static constexpr UINT16	stcui16cTilePartLD=0x0200;
	static constexpr UINT16	stcui16cTilePartRD=0x0300;
	static constexpr UINT16	stcui16cTileSelectedMask=0x0400;
	static constexpr UINT8	IMAGE_stcui8nUnitWidth=16;
	static constexpr UINT8	IMAGE_stcui8nUnitHeight=24;
	static constexpr UINT8	IMAGE_stcui8nPerspectiveWidth=4;
	static constexpr UINT8	IMAGE_stcui8nPerspectiveHeight=8;
	static constexpr UINT8	IMAGE_stcui8nShadowWidth=8;
	static constexpr UINT8	IMAGE_stcui8nShadowHeight=8;
	static constexpr UINT8	IMAGE_stcui8nFaceAlphaWidth=4;
	static constexpr UINT8	IMAGE_stcui8nFaceAlphaHeight=4;
	static constexpr AUTO	IMAGE_stcv2nUnit=VECTOR2(INT16(IMAGE_stcui8nUnitWidth),INT16(IMAGE_stcui8nUnitHeight));
	static constexpr AUTO	IMAGE_stcv2iSideR=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*3,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iSideD=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*3+8,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iSideRD=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*4+8,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	static constexpr AUTO	IMAGE_stcv2iShadow=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*4-8,INT16(IMAGE_stcui8nUnitHeight*2)*6-8);
	static constexpr AUTO	IMAGE_stcv2iSelected=VECTOR2(INT16(IMAGE_stcui8nUnitWidth*2)*2,INT16(IMAGE_stcui8nUnitHeight*2)*5);
	//	CANVAS_RGBA_ROM			IMAGE_stccvsTile
	//		牌絵柄ビットマップデータを保持します。
	//		横32、縦48ドット単位で並べています。
	//		「-cm 0」は減色方法指示で、「0」は「単純切り捨て」です。
	//		「1」の誤差拡散はちょっとノイジーだったんで。
	static inline CAUTO		IMAGE_stccvsTile=__O68K_CANVAS_RGBA_ROM("(Resource)/上海 - 牌.png","-cm 0");
#ifdef SHOWENDING
	static inline CAUTO		IMAGE_stccvsEnd=__O68K_CANVAS_RGBA_ROM("(Resource)/上海 - 天晴.png");
#endif
#ifdef SHOWBACKBITMAP
	static inline CAUTO		IMAGE_stccvsBack=__O68K_CANVAS_RGB_ROM("(Resource)/上海 - 床面.png");
#else
	static constexpr UINT16	stcui16cColorBack=0x141;
#endif
	static constexpr UINT8	SCREEN_stcui8iXBasis=10;
	static constexpr UINT8	SCREEN_stcui8iYBasis=9;

	//
	//		クラス
	//

	class MOUSESTATE;
	using					CMOUSESTATE=const MOUSESTATE;
	using					PMOUSESTATE=MOUSESTATE*;
	using					PCMOUSESTATE=CMOUSESTATE*;

	//
	//		クラス:MOUSESTATE
	//

	//	MOUSESTATE
	class MOUSESTATE{
	public:
		VECTOR2					v2iCursor;
		UINT16					ui16cButtonCurrent;
		UINT16					ui16cButtonSingle;
		OFWBOOL					eBusy;
	};

	//
	//		定義本体:GAME
	//

public:
	static inline UINT8		stui8nTileRest;
	static inline OFWBOOL	SELECT_eSelected;
	static inline UINT8		SELECT_ui8iTile;
	static inline UINT8		SELECT_ui8iX,SELECT_ui8iY,SELECT_ui8iLayer;
private:
	//	CUINT8[144][3]*			stpcacui8iPositionCurrent
	//		プレー中の配置型たる、牌座標群へのポインタです。
	//		参照先の座標群は「[144][3]」の2次元配列ですが、
	//		1次元配列へのポインタが配列長の概念を持たない事と同様、
	//		「stpcacui8iPositionCurrent」も「144」という配列長は関知しません。
	//		つまり、言語仕様的に範囲外チェックできません。
	static inline CUINT8	(*stpcacui8iPositionCurrent)[3];
	//	UINT16					staaaui16cTile[stcui8nLayer][stcui8nHeight][stcui8nWidth]
	//		牌の配置状況を保持します。
	//		「半分ずらし」があるので牌1つで田の字「2x2」の領域を占めます。
	//		位置0～7の8ビットは牌個体識別で、「0」は無し(空白)、「1～144」が牌通し番号になります。
	//		位置8～9の2ビットは田の字中の位置を示し、左上0、右上1、左下2、右下を設定します。
	//		これにより、配列1要素だけで牌の位置が分かります。
	static inline UINT16	staaaui16cTile[stcui8nLayer][stcui8nHeight][stcui8nWidth];
	static inline OFWBOOL	steProgressive;
	static inline MOUSESTATE	MOUSE_ststatState;
	//	CANVAS_RGB_RAM			OFF_stcvsOne
	//		非表示状態処理するためのバッファです。
	//		牌の大きさは32x48ドットですが、
	//		「半分ずらし」があるので処理単位は16x24ドットにしています。
	static inline AUTO		OFF_stcvsOne=CANVAS_RGB_RAM<UINT16(IMAGE_stcui8nUnitWidth),UINT16(IMAGE_stcui8nUnitHeight)>();
	static inline OFWBOOL	OFF_steUpdated;
	//	VECTOR2					SCREEN_stv2iOne
	//		描画位置を画面座標で保持します。
	static inline VECTOR2	SCREEN_stv2iOne;
public:
	static VOID				stNew(VOID)noexcept{
		constexpr UINT8			pattern_acui8ccursor[]=__O68K_PATTERN("(Resource)/00_SPRITE_CURSOR.png");
		constexpr UINT16		palette_acui16ccursor[]=__O68K_PALETTE("(Resource)/00_SPRITE_CURSOR.png");
		constexpr UINT8			pattern_acui8cgame[]=__O68K_PATTERN("(Resource)/上海 - スプライト.png");
		constexpr UINT16		palette_acui16cgame[]=__O68K_PALETTE("(Resource)/上海 - スプライト.png");

		MOUSE_ststatState.v2iCursor={320,240};
		MOUSE_ststatState.ui16cButtonCurrent=0x0000;
		MOUSE_ststatState.eBusy=TRUE;
		GRAPHIC::stNew(TRUE);
		GRAPHIC::PALETTE_stWrite(0x01,palette_acui16ccursor+1,15);
		GRAPHIC::PALETTE_stWrite(0x11,palette_acui16cgame+1,15);
		GRAPHIC::PATTERN_SPRITE_stWrite(0,8,pattern_acui8ccursor);
		GRAPHIC::PATTERN_SPRITE_stWrite(8,8,pattern_acui8cgame);
		GRAPHIC::VBLANK_stSetCallback(VBLANK_stCallback,NULL);
		stClear();
		return;
	}
	static VOID				stDelete(VOID)noexcept{
		GRAPHIC::stDelete();
		return;
	}
	static VOID				stInitialize(CUINT8 cui8ilayout,CUINT32 cui32cseed,CUINT8 cui8ndifficulty)noexcept{
		stArrange(cui8ilayout,cui32cseed,cui8ndifficulty);
#ifdef SHOWARRANGEPROGRESS
#else
		SCREEN_stDraw();
#endif
		MOUSE_stSetBusy(FALSE);
		return;
	}
	//	VOID					stCheckProgressive(VOID)
	//		「取れる牌が残っているか」、つまり「ゲームオーバーでないか」のチェックを行い、
	//		状態を更新します。
	static VOID				stCheckProgressive(VOID)noexcept{
		OFWBOOL					aeselectable[stcui8nTile>>2];

		for(AUTO& eselectable:aeselectable)eselectable=FALSE;
		for(UINT8 ui8itile=0;ui8itile<stcui8nTile;++ui8itile){
			CAUTO					acui8iposition=stpcacui8iPositionCurrent[ui8itile];
			CAUTO					cui8ix=acui8iposition[0];
			CAUTO					cui8iy=acui8iposition[1];
			CAUTO					cui8ilayer=acui8iposition[2];

			if(
				CAUTO					cui8itile=UINT8(staaaui16cTile[cui8ilayer][cui8iy][cui8ix]&0xff);
				cui8itile
			)if(steIsSelectable(cui8ix,cui8iy,cui8ilayer)){
				AUTO&					eselectable=aeselectable[stui8iGetTileGroup(cui8itile)>>2];

				if(eselectable)return;
				eselectable=TRUE;
			}
		}
		steProgressive=FALSE;
		return;
	}
	static OFWBOOL			steIsProgressive(VOID)noexcept{
		return steProgressive;
	}
	//	VOID					stWriteTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile,COFWBOOL ceupdate)
	//		牌の配置状況「staaaui16cTile」に対し、
	//		横「cui8ix」、縦「cui8iy」、高さ「cui8ilayer」で通し番号「cui8itile」の牌を設定します。
	//		「cui8itile」を「0」で呼び出すと、牌が除去されます。
	//		牌設定、除去共に「2x2」単位で処理を行うので田の字4回呼び出しは不要です。
	//		「ceupdate」に「TRUE」を指定すると表示更新も行います。
	static VOID				stWriteTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8itile,COFWBOOL ceupdate=TRUE)noexcept{
		if(cui8itile){
			stWriteTile4(cui8ix,cui8iy,cui8ilayer,UINT16(cui8itile),TRUE);
			if(ceupdate)SCREEN_stDraw(cui8ix,cui8iy,cui8ilayer);
		}else{
			if(
				AUTO					ui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
				ui16ctile
			){
				AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

				stAdjustPosition(ui8ix,ui8iy,ui16ctile);
				stWriteTile4(ui8ix,ui8iy,cui8ilayer,0x0000,FALSE);
				if(ceupdate)SCREEN_stDraw(ui8ix,ui8iy,cui8ilayer);
			}
		}
		return;
	}
	static OFWBOOL			steIsSelectable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		if(
			AUTO					ui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
			ui16ctile
		){
			AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

			stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			if(
				(cui8ilayer+1<stcui8nLayer)?(
					(staaaui16cTile[cui8ilayer+1][cui8iy+0][cui8ix+0]==0x0000)&&
					(staaaui16cTile[cui8ilayer+1][cui8iy+0][cui8ix+1]==0x0000)&&
					(staaaui16cTile[cui8ilayer+1][cui8iy+1][cui8ix+0]==0x0000)&&
					(staaaui16cTile[cui8ilayer+1][cui8iy+1][cui8ix+1]==0x0000)
				):TRUE
			)return OFWBOOL((2<=ui8ix)?(
				(staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix-1]==0x0000)&&
				(staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix-1]==0x0000)
			):TRUE)||OFWBOOL((ui8ix+2<stcui8nWidth)?(
				(staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+2]==0x0000)&&
				(staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+2]==0x0000)
			):TRUE);
		}
		return FALSE;
	}
	static VOID				stSelectTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL ceselected,COFWBOOL ceupdate=TRUE)noexcept{
		if(
			AUTO					ui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
			ui16ctile
		){
			AUTO					ui8ix=cui8ix,ui8iy=cui8iy;

			stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			stWriteTile4(
				ui8ix,ui8iy,cui8ilayer,
				ceselected?(ui16ctile|stcui16cTileSelectedMask):(ui16ctile&~stcui16cTileSelectedMask),
				TRUE
			);
			if(ceupdate)SCREEN_stDrawFace(ui8ix,ui8iy,cui8ilayer);
		}
		return;
	}
	static _INLINE_ UINT16	stui16cGetTile(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
#ifdef SHOWARRANGEPROGRESS
		CAUTO					cui16ctile=GAME_staaaui16cTile[cui8ilayer][cui8iy][cui8ix];

		return ((cui16ctile&0xff)!=GAME_stcui8iTileUndefined)?cui16ctile:0x0000;
#else
		return staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
#endif
	}
	static UINT16			stui16cGetTilebyScreenPosition(UINT8& ui8ix,UINT8& ui8iy,UINT8& ui8ilayer,CVECTOR2& cv2iposition)noexcept{
		//	通常高さでのチェック
		for(UINT8 ui8ilayer1=stcui8nLayer;0<ui8ilayer1;--ui8ilayer1){
			CAUTO				cui8ilayer=UINT8(ui8ilayer1-1);

			if(
				CAUTO					cv2ipoint=cv2iposition+SCREEN_stv2dGetOffset(INT8(cui8ilayer));
				(0<=cv2ipoint.i16iX())&&
				(cv2ipoint.i16iX()<INT16(stcui8nWidth)*INT16(IMAGE_stcui8nUnitWidth))&&
				(0<=cv2ipoint.i16iY())&&
				(cv2ipoint.i16iY()<INT16(stcui8nHeight)*INT16(IMAGE_stcui8nUnitHeight))
			){
				ui8ix=UINT8(cv2ipoint.i16iX()/GAME::IMAGE_stcui8nUnitWidth);
				ui8iy=COMMON::stui8Divide24(UINT16(cv2ipoint.i16iY()));
				for(UINT8 ui8ilayer1_over=stcui8nLayer;cui8ilayer<ui8ilayer1_over;--ui8ilayer1_over){
					ui8ilayer=UINT8(ui8ilayer1_over-1);
					if(
						AUTO					ui16ctile=staaaui16cTile[ui8ilayer][ui8iy][ui8ix];
						ui16ctile
					){
						stAdjustPosition(ui8ix,ui8iy,ui16ctile);
						return ui16ctile;
					}
				}
			}
		}
		//	床面でのチェック(1段目の横っ面チェック)
		ui8ilayer=0;
		if(
			CAUTO					cv2ipoint=cv2iposition+SCREEN_stv2dGetOffset(-1);
			(0<=cv2ipoint.i16iX())&&
			(cv2ipoint.i16iX()<INT16(stcui8nWidth)*INT16(IMAGE_stcui8nUnitWidth))&&
			(0<=cv2ipoint.i16iY())&&
			(cv2ipoint.i16iY()<INT16(stcui8nHeight)*INT16(IMAGE_stcui8nUnitHeight))
		){
			ui8ix=UINT8(cv2ipoint.i16iX()/GAME::IMAGE_stcui8nUnitWidth);
			ui8iy=COMMON::stui8Divide24(UINT16(cv2ipoint.i16iY()));
			if(
				AUTO					ui16ctile=staaaui16cTile[0][ui8iy][ui8ix];
				ui16ctile
			){
				stAdjustPosition(ui8ix,ui8iy,ui16ctile);
				return ui16ctile;
			}
		}
		return 0x0000;
	}
	static constexpr UINT8	stui8iGetTileGroup(CUINT8 cui8itile)noexcept{
		return (UINT8(cui8itile)-1)&~3;
	}
	static _INLINE_ MOUSESTATE	MOUSE_ststatGetState(VOID)noexcept{
		return MOUSE_ststatState;
	}
	static _INLINE_ VOID	MOUSE_stSetBusy(COFWBOOL cebusy)noexcept{
		MOUSE_ststatState.eBusy=cebusy;
		return;
	}
	static _INLINE_ VECTOR2	SCREEN_stv2dGetOffset(CINT8 ci8ilayer)noexcept{
		return {
			INT16(INT16(ci8ilayer)*INT16(IMAGE_stcui8nPerspectiveWidth)-(INT16(SCREEN_stcui8iXBasis)<<3)),
			INT16(INT16(ci8ilayer)*INT16(IMAGE_stcui8nPerspectiveHeight)-(INT16(SCREEN_stcui8iYBasis)<<3))
		};
	}
	static VECTOR2			SCREEN_stv2iGetPosition(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		return VECTOR2(
			INT16(cui8ix)*INT16(GAME::IMAGE_stcui8nUnitWidth),
			INT16(cui8iy)*INT16(GAME::IMAGE_stcui8nUnitHeight)
		)-SCREEN_stv2dGetOffset(INT8(cui8ilayer));
	}
	static _INLINE_ VOID	SCREEN_stClear(VOID)noexcept{
		SCREEN_stClear({VECTOR2::stv2ImmediateZero(),GRAPHIC::stcv2nScreen});
		return;
	}
	static _INLINE_ VOID	SCREEN_stClear(GRAPHIC::CSHAPE& cshpsource)noexcept{
#ifdef SHOWBACKBITMAP
		GRAPHIC::stCopyRect(IMAGE_stccvsBack,cshpsource,cshpsource.v2iPosition);
#else
		GRAPHIC::stFillRect(stcui16cColorBack,cshpsource);
#endif
		return;
	}
	//	VOID					SCREEN_stDraw(VOID)
	//		全画面更新します。
	//		残念な事に遅いので、初期表示時以外は位置指定するようにしてください。
	static VOID				SCREEN_stDraw(VOID)noexcept{
		for(UINT8 ui8iy=0;ui8iy<stcui8nHeight+2;++ui8iy){
			for(UINT8 ui8ix=0;ui8ix<stcui8nWidth+2;++ui8ix){
				SCREEN_stDraw_Layered(ui8ix,ui8iy,stcui8nLayer-1);
			}
		}
		return;
	}
	//	VOID					SCREEN_stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		位置「(cui8ix,cui8iy)」、高さ「cui8ilayer」にある牌に関連する領域の表示更新を行います。
	//		更新を行う「領域」は画面座標であり、高さが下る度パース的には「右下」に伸びるため、
	//		牌管理情報的には「左上」に遡ります。
	//		また、横っ面、影の更新も行うため、「右下」への拡張も行います。
	static _INLINE_ VOID	SCREEN_stDraw(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	もし牌があるなら左上起点になるよう補正
		if((cui8ix<stcui8nWidth)&&(cui8iy<stcui8nHeight))if(
			AUTO					ui16ctile=stui16cGetTile(cui8ix,cui8iy,cui8ilayer);
			ui16ctile
		)stAdjustPosition(ui8ix,ui8iy,ui16ctile);
		//	横っ面と影で右「(4+8)*(段番号+1)」ドット、下「(8+8)*(段番号+1)」ドット拡大があるので、
		//	その表示範囲をカバーすべく、処理範囲を決定。
		{
			CAUTO					ci16nextensionwidth=INT16((INT16(IMAGE_stcui8nPerspectiveWidth+IMAGE_stcui8nShadowWidth))*INT16(cui8ilayer+1)+INT16(IMAGE_stcui8nUnitWidth*2));

			for(
				AUTO					i16nextensionheight=INT16(INT16(IMAGE_stcui8nPerspectiveHeight+IMAGE_stcui8nShadowHeight)*INT16(cui8ilayer+1)+INT16(IMAGE_stcui8nUnitHeight*2));
				0<i16nextensionheight;
				i16nextensionheight-=INT16(IMAGE_stcui8nUnitHeight)
			){
				AUTO					ui8ix_current=ui8ix;

				for(
					AUTO					i8nextensionwidth=ci16nextensionwidth;
					0<i8nextensionwidth;
					i8nextensionwidth-=INT8(IMAGE_stcui8nUnitWidth)
				){
					SCREEN_stDraw_Layered(ui8ix_current,ui8iy,cui8ilayer,TRUE);	//	「空白」への更新もあり得るので強制する必要がある
					++ui8ix_current;
				}
				++ui8iy;
			}
		}
		return;
	}
	static _INLINE_ VOID	SCREEN_stDrawFace(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	もし牌があるなら左上起点になるよう補正
		if((cui8ix<stcui8nWidth)&&(cui8iy<stcui8nHeight))if(
			AUTO					ui16ctile=stui16cGetTile(cui8ix,cui8iy,cui8ilayer);
			ui16ctile
		){
			stAdjustPosition(ui8ix,ui8iy,ui16ctile);
			SCREEN_stDraw_Layered(ui8ix,ui8iy,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix+1,ui8iy,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix,ui8iy+1,cui8ilayer);
			SCREEN_stDraw_Layered(ui8ix+1,ui8iy+1,cui8ilayer);
		}
		return;
	}
	template<CUINT16 DCLASS_cui16nWidth,CUINT16 DCLASS_cui16nHeight>
	static _INLINE_ VOID	OFF_stDrawBack(CANVAS_RGB_RAM<DCLASS_cui16nWidth,DCLASS_cui16nHeight>& cvsthis,CVECTOR2& cv2iposition_screen)noexcept{
		using					DCLASS=CANVAS_RGB_RAM<DCLASS_cui16nWidth,DCLASS_cui16nHeight>;

#ifdef SHOWBACKBITMAP
		cvsthis.CopyRect(
			IMAGE_stccvsBack,
			{cv2iposition_screen,DCLASS::stcv2nSize},
			VECTOR2::stv2ImmediateZero()
		);
#else
		ccvsthis.Fill(stcui16cColorBack);
#endif
		return;
	}
private:
	static VOID				stClear(VOID)noexcept{
		stui8nTileRest=0;
		SELECT_eSelected=FALSE;
		STD::stFill(staaaui16cTile,SIZEOF(staaaui16cTile),0x00);
		steProgressive=FALSE;
		return;
	}
