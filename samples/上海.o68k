				                                                                                                    {20,13,2},{22,13,2},{24,13,2},
				//	第4層
				                         { 5, 1,3},{ 7, 1,3},

				                                                  {10, 4,3},
				                         { 5, 7,3},               {10, 6,3},{12, 7,3},{14, 7,3},{16, 7,3},                         {23, 7,3},
				                                                                                          {18, 8,3},
				                                                                                          {18,10,3},

				                                                                                                         {21,13,3},{23,13,3},
				//	第5層
				                              { 6, 1,4},

				                                                  {10, 5,4},
				                                                                 {13, 7,4},{15, 7,4},
				                                                                                          {18, 9,4},

				                                                                                                              {22,13,4}
			},
			//	配置「豹」
			{
				//	第1層
				                    { 4, 2,0},{ 6, 2,0},{ 8, 2,0},                                                  {20, 2,0},{22, 2,0},{24, 2,0},
				          { 2, 4,0},{ 4, 4,0},{ 6, 4,0},{ 8, 4,0},{10, 4,0},                              {18, 4,0},{20, 4,0},{22, 4,0},{24, 4,0},{26, 4,0},
				{ 0, 5,0},{ 2, 6,0},{ 4, 6,0},{ 6, 6,0},{ 8, 6,0},{10, 6,0},{12, 5,0},{14, 5,0},{16, 5,0},{18, 6,0},{20, 6,0},{22, 6,0},{24, 6,0},{26, 6,0},{28, 5,0},
				{ 0, 7,0},{ 2, 8,0},{ 4, 8,0},{ 6, 8,0},{ 8, 8,0},{10, 8,0},{12, 7,0},{14, 7,0},{16, 7,0},{18, 8,0},{20, 8,0},{22, 8,0},{24, 8,0},{26, 8,0},{28, 7,0},
				{ 0, 9,0},{ 2,10,0},{ 4,10,0},{ 6,10,0},{ 8,10,0},{10,10,0},{12, 9,0},{14, 9,0},{16, 9,0},{18,10,0},{20,10,0},{22,10,0},{24,10,0},{26,10,0},{28, 9,0},
				                    { 4,12,0},{ 6,12,0},{ 8,12,0},                                                  {20,12,0},{22,12,0},{24,12,0},
				//	第2層
				                              { 6, 2,1},                                                                      {22, 2,1},
				                    { 4, 4,1},{ 6, 4,1},{ 8, 4,1},                                                  {20, 4,1},{22, 4,1},{24, 4,1},
				                    { 4, 6,1},{ 6, 6,1},{ 8, 6,1},                                                  {20, 6,1},{22, 6,1},{24, 6,1},
				{ 0, 7,1},{ 2, 7,1},{ 4, 8,1},{ 6, 8,1},{ 8, 8,1},{10, 7,1},{12, 7,1},{14, 7,1},{16, 7,1},{18, 7,1},{20, 8,1},{22, 8,1},{24, 8,1},{26, 7,1},{28, 7,1},
				                    { 4,10,1},{ 6,10,1},{ 8,10,1},                                                  {20,10,1},{22,10,1},{24,10,1},
				                              { 6,12,1},                                                                      {22,12,1},
				//	第3層
				                              { 6, 4,2},                                                                      {22, 4,2},
				                    { 4, 6,2},{ 6, 6,2},{ 8, 6,2},                                                  {20, 6,2},{22, 6,2},{24, 6,2},
				          { 2, 7,2},{ 4, 8,2},{ 6, 8,2},{ 8, 8,2},{10, 7,2},{12, 7,2},          {16, 7,2},{18, 7,2},{20, 8,2},{22, 8,2},{24, 8,2},{26, 7,2},
				                              { 6,10,2},                                                                      {22,10,2},
				//	第4層
				                    { 4, 6,3},{ 6, 6,3},{ 8, 6,3},                                                  {20, 6,3},{22, 6,3},{24, 6,3},
				                    { 4, 8,3},{ 6, 8,3},{ 8, 8,3},{10, 7,3},                              {18, 7,3},{20, 8,3},{22, 8,3},{24, 8,3},
				//	第5層
				                         { 5, 7,4},{ 7, 7,4},                                                            {21, 7,4},{23, 7,4}
			}
		};
		//	UINT8					aui8iarrange[144]
		//		「0～143」の「配置番号」を混ぜた状態で保持します。
		//		混ぜるのは解のバリエーションを持たせるためです。
		UINT8					aui8iarrange[stcui8nTile];
		UINT8					aui8itile[stcui8nTile];
		//	UINT8					ui8itile
		//		次に設置する「牌番号」を保持します。
		//		配置進捗と見なせます。
		UINT8					ui8itile;
		CAUTO&					cfp_searchone=[&](UINT8& ui8ilocal,UINT8& ui8ix,UINT8& ui8iy,UINT8& ui8ilayer,UINT8& ui8ndistance)noexcept{
			for(;ui8ilocal<stcui8nTile;++ui8ilocal){
				CAUTO					cui8iarrange=aui8iarrange[ui8ilocal];

				if(cui8iarrange!=stcui8iTileUndefined){
					CAUTO&					acui8iposition=stpcacui8iPositionCurrent[cui8iarrange];

					//	配置番号は「済」ではなかった
					ui8ix=acui8iposition[0];
					ui8iy=acui8iposition[1];
					ui8ilayer=acui8iposition[2];
					if(steArrange_IsSettable(ui8ix,ui8iy,ui8ilayer,ui8ndistance))break;
				}
			}
			return;
		};
		CAUTO&					cfp_searchpair=[&](UINT8& ui8ilocal0,UINT8& ui8ix0,UINT8& ui8iy0,UINT8& ui8ilayer0,UINT8& ui8ilocal1,UINT8& ui8ix1,UINT8& ui8iy1,UINT8& ui8ilayer1,UINT8& ui8ndistance)noexcept{
			UINT8					ui8ndistance1;

			cfp_searchone(ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0,ui8ndistance);
			if(ui8ilocal0<stcui8nTile){
				for(ui8ilocal1=ui8ilocal0+1;ui8ilocal1<stcui8nTile;++ui8ilocal1){
					cfp_searchone(ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance1);
					if(ui8ilocal1<stcui8nTile){
						//	牌2つ目も「配置可能」であった。
						//	ただし、「同じ高さで離れている」ような状況なら配置してはならないので、
						//	牌1つ目を「仮配置」して再チェックする。
						stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(0x0001),TRUE);
						{
							CAUTO			cesettable=steArrange_IsSettable(ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance1);

							stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(stcui8iTileUndefined),TRUE);
							if(cesettable){
								ui8ndistance=STD::stxGetMinimum(ui8ndistance,ui8ndistance1);
								return;
							}
						}
					}
				}
			}
			ui8ilocal1=stcui8nTile;
			return;
		};

		stpcacui8iPositionCurrent=staaacui8iposition[cui8ilayout];
		OS::LFSR_stSetSeed(cui32cseed);
		stClear();
		for(UINT8 ui8iarrange=0;ui8iarrange<stcui8nTile;++ui8iarrange)aui8itile[ui8iarrange]=ui8iarrange+1;
		//	季節牌混ぜ
		COMMON::stShuffle<4>(aui8itile+stcui8nTile-8);
		//	花牌混ぜ
		COMMON::stShuffle<4>(aui8itile+stcui8nTile-4);
		//	牌4つセット混ぜ(難易度無関係)
		COMMON::stShuffle<stcui8nTile/4>(PUINT32(aui8itile));
		//	牌2つセット混ぜ(難易度左右する)
		COMMON::stShuffle<stcui8nTile/2>(PUINT16(aui8itile),cui8ndifficulty);
		//	牌4つセット混ぜ(難易度無関係)
		//	再度実行しているのは、「牌2つセット混ぜ」が前半「cui8ndifficulty」ヶ分だけだから。
		COMMON::stShuffle<stcui8nTile/4>(PUINT32(aui8itile));
		do{
			//	実は「追加配置不可」の状況に陥る場合があるため、
			//	やり直し想定でループにしておきます。
			for(UINT8 ui8iarrange=0;ui8iarrange<stcui8nTile;++ui8iarrange){
				CAUTO&					acui8iposition=stpcacui8iPositionCurrent[ui8iarrange];

				//	左右方向への走査を行えるよう、
				//	「GAME_stcui16cTileTemporaryMask」付きで「田の字」属性を設定。
				stWriteTile4(
					acui8iposition[0],		//	cui8ix
					acui8iposition[1],		//	cui8iy
					acui8iposition[2],		//	cui8ilayer
					UINT16(stcui8iTileUndefined),	//	cui16ctile
					TRUE					//	cepart
				);
				//	ついでに配置番号を「整列状態」で設定
				aui8iarrange[ui8iarrange]=ui8iarrange;
			}
			//	混ぜる事で「0～143」出現順をランダムに
			COMMON::stShuffle<stcui8nTile>(aui8iarrange);
			//	配置情報に従って置き場所を決め、
			//	「設置して良いかどうか」を、左右の空き、下層の牌有無で判定。
			//	2牌1組で置き場所を決めるのがミソ。
			//	「処理が進まないと配置出来ない」位置もあるため、
			//	配置ループは数度回る事が前提。
			ui8itile=0;
			while(ui8itile<stcui8nTile){
				//	UINT8					cui8itile_start
				//		配置ループ開始前の「牌番号」を保持します。
				//		「進捗有無」判定に使います。
				CAUTO					cui8itile_start=ui8itile;

				for(UINT8 ui8ilocal=0;ui8ilocal<stcui8nTile;++ui8ilocal){
					UINT8					ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0;
					UINT8					ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1;
					UINT8					ui8ndistance;

					//	ここから実配置開始。
					//	恐らく、ループは一度で完了しない。
					//	とりあえず「配置可能」の候補2つをゲットする。
					//	「左右空きが大きい」方から埋めていく事で「追加配置不可」の状況を起きにくくする。
					ui8ilocal0=ui8ilocal;
					cfp_searchpair(ui8ilocal0,ui8ix0,ui8iy0,ui8ilayer0,ui8ilocal1,ui8ix1,ui8iy1,ui8ilayer1,ui8ndistance);
					if(ui8ilocal1<stcui8nTile){
						{
							UINT8					ui8ilocal0d,ui8ix0d,ui8iy0d,ui8ilayer0d;
							UINT8					ui8ilocal1d,ui8ix1d,ui8iy1d,ui8ilayer1d;
							UINT8					ui8ndistanced;

							ui8ilocal0d=ui8ilocal1+1;
							cfp_searchpair(ui8ilocal0d,ui8ix0d,ui8iy0d,ui8ilayer0d,ui8ilocal1d,ui8ix1d,ui8iy1d,ui8ilayer1d,ui8ndistanced);
							if(ui8ilocal1d<stcui8nTile){
								CAUTO					cui8nlayersum=ui8ilayer0+ui8ilayer1;
								CAUTO					cui8nlayersumd=ui8ilayer0d+ui8ilayer1d;

								if(
									(cui8nlayersum==cui8nlayersumd)?(
										//	高さが同じなら配置で詰みにくい選択を。
										ui8ndistance<ui8ndistanced
									):(
										//	さもなければ難易度に応じて高層からの積みを選択
										(COMMON::stui8Random<(stcui8nTile>>1)>()<cui8ndifficulty)?(
											cui8nlayersum<cui8nlayersumd
										):(
											cui8nlayersumd<cui8nlayersum
										)
									)
								){
									ui8ilocal0=		ui8ilocal0d;
									ui8ix0=			ui8ix0d;
									ui8iy0=			ui8iy0d;
									ui8ilayer0=		ui8ilayer0d;
									ui8ilocal1=		ui8ilocal1d;
									ui8ix1=			ui8ix1d;
									ui8iy1=			ui8iy1d;
									ui8ilayer1=		ui8ilayer1d;
									ui8ndistance=	ui8ndistanced;
								}
							}
						}
						//	無事牌2つ目も「配置可能」で確定できたので、処理済みにマーク
						aui8iarrange[ui8ilocal0]=stcui8iTileUndefined;
						aui8iarrange[ui8ilocal1]=stcui8iTileUndefined;
#ifdef SHOWARRANGEPROGRESS
						GAME_stWriteTile(ui8ix0,ui8iy0,ui8ilayer0,aui8itile[ui8itile],TRUE);++ui8itile;
						GAME_stWriteTile(ui8ix1,ui8iy1,ui8ilayer1,aui8itile[ui8itile],TRUE);++ui8itile;
#else
						stWriteTile4(ui8ix0,ui8iy0,ui8ilayer0,UINT16(aui8itile[ui8itile]),TRUE);++ui8itile;
						stWriteTile4(ui8ix1,ui8iy1,ui8ilayer1,UINT16(aui8itile[ui8itile]),TRUE);++ui8itile;
#endif
						ui8ilocal=ui8ilocal1;
					}
				}
				if(ui8itile==cui8itile_start){
					//	ここに至ったという事は進捗ゼロであったという事。
					//	不幸にも「追加配置不可」の状況に陥った。
#ifdef SHOWARRANGEPROGRESS
					SCREEN_stClear(FALSE);
#endif
					break;
				}
			}
		}while(ui8itile<stcui8nTile);
		stui8nTileRest=stcui8nTile;
		steProgressive=TRUE;
		return;
	}
	static VOID				stAdjustPosition(UINT8& ui8ix,UINT8& ui8iy,UINT16& ui16ctile)noexcept{
		switch(ui16ctile&stcui16cTilePartMask){
		case stcui16cTilePartLU:
			break;
		case stcui16cTilePartRU:
			--ui8ix;
			break;
		case stcui16cTilePartLD:
			--ui8iy;
			break;
		case stcui16cTilePartRD:
			--ui8ix;
			--ui8iy;
			break;
		}
		ui16ctile&=~stcui16cTilePartMask;
		return;
	}
	static _INLINE_ VOID	stWriteTile4(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT16 cui16ctile,COFWBOOL cepart)noexcept{
		staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+0]=cui16ctile|(cepart?stcui16cTilePartLU:0x0000);
		staaaui16cTile[cui8ilayer][cui8iy+0][cui8ix+1]=cui16ctile|(cepart?stcui16cTilePartRU:0x0000);
		staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+0]=cui16ctile|(cepart?stcui16cTilePartLD:0x0000);
		staaaui16cTile[cui8ilayer][cui8iy+1][cui8ix+1]=cui16ctile|(cepart?stcui16cTilePartRD:0x0000);
		return;
	}
	//	OFWBOOL					steArrange_IsSettable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,UINT8& ui8ndistance)
	//		位置「(cui8ix,cui8iy,cui8ilayer)」に配置可能であるかどうかを返します。
	//		下記条件に合致すると「配置可能」と判定します。
	//		・牌が存在しない事
	//		・下層が存在する事
	//		・下記条件を満たす事
	//		  ・左右延長線上に牌が存在しない
	//		  ・左延長線上に牌が存在せず、右に牌が隣接している
	//		  ・右延長線上に牌が存在せず、左に牌が隣接している
	static OFWBOOL			steArrange_IsSettable(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,UINT8& ui8ndistance)noexcept{
		CAUTO					cui16ctile=staaaui16cTile[cui8ilayer][cui8iy][cui8ix];
		OFWBOOL					eneighbour;

		if(steArrange_IsThisExists(cui8ix,cui8iy,cui8ilayer))return FALSE;
		if(!steArrange_IsFootExists(cui8ix,cui8iy,cui8ilayer))return FALSE;
		ui8ndistance=0;
		if(steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,TRUE,eneighbour,ui8ndistance)){
			if(eneighbour){
				UINT8					ui8ndistancer=0;

				if(steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,FALSE,eneighbour,ui8ndistancer)){
					ui8ndistance=STD::stxGetMaximum(ui8ndistance,ui8ndistancer);
					return !eneighbour;
				}else{
					return FALSE;
				}
			}else{
				return steArrange_IsSettable_Side(cui8ix,cui8iy,cui8ilayer,FALSE,eneighbour,ui8ndistance);
			}
		}
		return FALSE;
	}
	static OFWBOOL			steArrange_IsSettable_Side(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL cel,OFWBOOL& eneighbour,UINT8& ui8ndistance)noexcept{
		//	この時点で、位置「(cui8ix,cui8iy,cui8ilayer)」に牌が存在しない事が前提。
		//	下層は存在しない場合もあり得るが、
		//	後に下層が置かれた結果「延長線上にある」状態となる可能性があるため、
		//	延長線上チェックは下層有無関係無く実施する必要あり。
		++ui8ndistance;
		if(cel?(2<=cui8ix):(cui8ix<stcui8nWidth-2)){
			AUTO					ui8ixh=cel?UINT8(cui8ix-2):UINT8(cui8ix+2);
			AUTO					ui16ctile=staaaui16cTile[cui8ilayer][cui8iy][ui8ixh];

			if(ui16ctile){
				AUTO					ui8iyh=cui8iy;

				//	「空き(端)」ではない。
				stAdjustPosition(ui8ixh,ui8iyh,ui16ctile);
				if(ui8iyh==cui8iy){
					//	「半分ずらし」ではない
					if(steArrange_IsExists(ui16ctile)){
						//	実在なので「隣接あり設置可能」で確定
						eneighbour=TRUE;
						return TRUE;
					}else{
						//	ひとまず隣は空いているが、延長線上がどうかは分からない。
						if(steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance)){
							//	ここで「eneighbour」が「TRUE」だと、
							//	「1つ離れて存在」という事になるので設置してはならない。
							//	返すべきは「eneighbour」の否定。
							return !eneighbour;
						}else{
							//	延長線上にあるか何かした。
							return FALSE;
						}
					}
				}else{
					//	「半分ずらし」になっている
					if(steArrange_IsExists(ui16ctile)){
						//	下隣の状態チェック
						if(
							CAUTO					cui16ctileh=staaaui16cTile[cui8ilayer][ui8iyh+2][ui8ixh];
							cui16ctileh
						){
							//	下隣は「空き(端)」ではない。
							if(steArrange_IsExists(cui16ctileh)){
								//	下隣にも存在するので、「隣接あり設置可能」で良し
								eneighbour=TRUE;
								return TRUE;
							}else if(steArrange_IsSettable_Side(ui8ixh,ui8iyh+2,cui8ilayer,cel,eneighbour,ui8ndistance)){
								//	ここで「eneighbour」が「TRUE」だと、
								//	「1つ離れて存在」という事になるので設置してはならない。
								//	返すべきは「eneighbour」の否定。
								if(eneighbour){
									return FALSE;
								}else{
									eneighbour=TRUE;
									return TRUE;
								}
							}else{
								//	延長線上にあるか何かした。
								return FALSE;
							}
						}else{
							//	下隣は「空き(端)」であった。
							eneighbour=TRUE;
							return TRUE;
						}
					}else{
						AUTO					ui8ndistanced=ui8ndistance;

						//	ひとまず上隣は空いているが、延長線上がどうかは分からない。
						if(steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance)){
							//	ここで「eneighbour」が「TRUE」だと、
							//	「1つおきで存在」という事になるので設置してはならない。
							if(eneighbour){
								return FALSE;
							}else{
								//	上隣は純然たる空き(端ではない)である。
								if(
									CAUTO					cui16ctileh=staaaui16cTile[cui8ilayer][ui8iyh+2][ui8ixh];
									cui16ctileh
								){
									//	下隣は「空き(端)」ではない。
									if(steArrange_IsExists(cui16ctileh)){
										//	下隣に存在するので、「隣接あり設置可能」で良し。
										eneighbour=TRUE;
										return TRUE;
									}else{
										if(steArrange_IsSettable_Side(ui8ixh,ui8iyh+2,cui8ilayer,cel,eneighbour,ui8ndistanced)){
											ui8ndistance=STD::stxGetMaximum(ui8ndistance,ui8ndistanced);
											//	ここで「eneighbour」が「TRUE」だと、
											//	「1つ離れて存在」という事になるので設置してはならない。
											//	返すべきは「eneighbour」の否定。
											return !eneighbour;
										}else{
											return FALSE;
										}
									}
								}else{
									//	下隣も「空き(端)」であった。
								}
							}
						}else{
							return FALSE;
						}
					}
				}
			}else{
				AUTO					ui8iyh=UINT8(cui8iy+1);

				//	「空き(端)」であった。
				ui16ctile=staaaui16cTile[cui8ilayer][ui8iyh][ui8ixh];
				if(ui16ctile){
					//	「半分ずらし」になっている
					if(steArrange_IsExists(ui16ctile)){
						//	実在なので「隣接あり設置可能」で確定
						eneighbour=TRUE;
						return TRUE;
					}else{
						if(steArrange_IsSettable_Side(ui8ixh,ui8iyh,cui8ilayer,cel,eneighbour,ui8ndistance)){
							//	ここで「eneighbour」が「TRUE」だと、
							//	「1つ離れて存在」という事になるので設置してはならない。
							//	返すべきは「eneighbour」の否定。
							return !eneighbour;
						}else{
							//	延長線上にあるか何かした。
							return FALSE;
						}
					}
				}
			}
		}
		eneighbour=FALSE;
		return TRUE;
	}
	static _INLINE_ OFWBOOL	steArrange_IsFootExists(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		CAUTO					celayern=OFWBOOL(0<cui8ilayer);
		CAUTO					cefootlu=celayern?steArrange_IsThisExists(cui8ix+0,cui8iy+0,cui8ilayer-1):TRUE;
		CAUTO					cefootru=celayern?steArrange_IsThisExists(cui8ix+1,cui8iy+0,cui8ilayer-1):TRUE;
		CAUTO					cefootld=celayern?steArrange_IsThisExists(cui8ix+0,cui8iy+1,cui8ilayer-1):TRUE;
		CAUTO					cefootrd=celayern?steArrange_IsThisExists(cui8ix+1,cui8iy+1,cui8ilayer-1):TRUE;

		return (cefootlu&&cefootru&&cefootld&&cefootrd);
	}
	static _INLINE_ OFWBOOL	steArrange_IsThisExists(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		return steArrange_IsExists(staaaui16cTile[cui8ilayer][cui8iy][cui8ix]);
	}
	static constexpr OFWBOOL	steArrange_IsExists(CUINT16 cui16ctile)noexcept{
		CAUTO					cui8itile=UINT8(cui16ctile&0xff);

		return OFWBOOL((cui8itile!=0x00)&&(cui8itile!=stcui8iTileUndefined));
	}
	static VOID				VBLANK_stCallback(const PVOID cpobject)noexcept{
		CAUTO					cstatmouse=OS::DEVICE_MOUSE_ststatRead();

		MOUSE_ststatState.v2iCursor+=cstatmouse.v2dRelative;
		MOUSE_ststatState.v2iCursor.i16iX()=STD::stxClamp(MOUSE_ststatState.v2iCursor.i16iX(),INT16(0),INT16(639));
		MOUSE_ststatState.v2iCursor.i16iY()=STD::stxClamp(MOUSE_ststatState.v2iCursor.i16iY(),INT16(0),INT16(479));
		if(MOUSE_ststatState.eBusy)GRAPHIC::SPRITE_stWrite16(0,MOUSE_ststatState.v2iCursor-VECTOR2(8,8),0x04,0x0);
		else GRAPHIC::SPRITE_stWrite16(0,MOUSE_ststatState.v2iCursor,0x00,0x0);
		MOUSE_ststatState.ui16cButtonSingle=cstatmouse.ui16cButton&~MOUSE_ststatState.ui16cButtonCurrent;
		MOUSE_ststatState.ui16cButtonCurrent=cstatmouse.ui16cButton;
		return;
	}
	//	VOID					SCREEN_stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		高さ「cui8ilayer」での、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		「cui8ilayer」は画面表示上の位置を決めるためのもので、
	//		内部描画処理はトップ「GAME_stcui8nLayer-1」からの開始になります。
	static VOID				SCREEN_stDraw_Layered(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,COFWBOOL ceupdateforced=FALSE)noexcept{
		OFF_stDraw_Begin(cui8ix,cui8iy,cui8ilayer);
		if(ceupdateforced)OFF_stDraw_MarkUpdate();
		for(UINT8 ui8ilayer_drawing=0;ui8ilayer_drawing<stcui8nLayer;++ui8ilayer_drawing)OFF_stDraw_Layer(cui8ix,cui8iy,cui8ilayer,ui8ilayer_drawing);
		if(OFF_steUpdated)GRAPHIC::stCopy(OFF_stcvsOne,SCREEN_stv2iOne);
		return;
	}
	static VOID				OFF_stDraw_Begin(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		OFF_steUpdated=FALSE;
		SCREEN_stv2iOne={
			INT16(((cui8ix*2+SCREEN_stcui8iXBasis)<<3)-(cui8ilayer<<2)),
			INT16(((cui8iy*3+SCREEN_stcui8iYBasis)<<3)-(cui8ilayer<<3))
		};
		return;
	}
	static _INLINE_ VOID	OFF_stDraw_MarkUpdate(VOID)noexcept{
		if(!OFF_steUpdated)OFF_stDraw_MarkUpdate_Body();
		return;
	}
	static VOID				OFF_stDraw_MarkUpdate_Body(VOID)noexcept{
		OFF_steUpdated=TRUE;
#ifdef SHOWBACKBITMAP
		OFF_stcvsOne.CopyRect(IMAGE_stccvsBack,{SCREEN_stv2iOne,OFF_stcvsOne.stcv2nSize},VECTOR2::stv2ImmediateZero());
#else
		OFF_stcvsOne.Fill(stcui16cColorBack);
#endif
		return;
	}
	static VOID				OFF_stDraw_Layer(CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer,CUINT8 cui8ilayer_drawing)noexcept{
		CAUTO					cui8doffset=cui8ilayer-cui8ilayer_drawing;
		//	VECTOR2					cv2idestination_minimum
		//		最下段時、位置「(4,8)」ずらしで床面影描画を行うので、
		//		表示対象に入るよう、下限値をマイナスにする。
		CAUTO					cv2idestination_minimum=(cui8ilayer_drawing==0)?VECTOR2(-INT16(IMAGE_stcui8nPerspectiveWidth),-INT16(IMAGE_stcui8nPerspectiveHeight)):VECTOR2::stv2ImmediateZero();
		AUTO					v2idestination=VECTOR2(
			INT16(cui8doffset*IMAGE_stcui8nPerspectiveWidth),
			INT16(cui8doffset*IMAGE_stcui8nPerspectiveHeight)
		);
		AUTO					ui8ix=cui8ix;
		AUTO					ui8iy=cui8iy;

		//	下面描画のため「左上遡り」をするが、
		//	横「-16」以下、「+16」以上は表示対象から外れるので、
		//	最小限遡っておく。
		while((cv2idestination_minimum.i16iX()<v2idestination.i16iX())&&(0<ui8ix)){
			v2idestination.i16iX()-=INT16(IMAGE_stcui8nUnitWidth);
			--ui8ix;
		}
		//	縦は24ドット基準。
		while((cv2idestination_minimum.i16iY()<v2idestination.i16iY())&&(0<ui8iy)){
			v2idestination.i16iY()-=INT16(IMAGE_stcui8nUnitHeight);
			--ui8iy;
		}
		{
			CAUTO					ci16idestinationx_origin=v2idestination.i16iX();

			for(;v2idestination.i16iY()<INT16(IMAGE_stcui8nUnitHeight);v2idestination.i16iY()+=INT16(IMAGE_stcui8nUnitHeight)){
				AUTO					ui8ix_current=ui8ix;

				for(v2idestination.i16iX()=ci16idestinationx_origin;v2idestination.i16iX()<INT16(IMAGE_stcui8nUnitWidth);v2idestination.i16iX()+=INT16(IMAGE_stcui8nUnitWidth)){
					OFF_stDraw_Layer_Positioned(v2idestination,ui8ix_current,ui8iy,cui8ilayer_drawing);
					++ui8ix_current;
				}
				++ui8iy;
			}
		}
		return;
	}
	//	VOID					OFF_stDraw_Layer_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)
	//		表示位置「cv2idestination」への、高さ「cui8ilayer」、位置「(cui8ix,cui8iy)」右下方向「1x1」単位(1/2牌分)領域の表示更新を行います。
	//		牌の表面以外、表示範囲に含まれる側面、床面、影の描画も行います。
	//		床面への影描画はオフセット「(+4,+8)」があるため、横「-19」、縦「-31」までは描画がありえます。
	static VOID				OFF_stDraw_Layer_Positioned(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer)noexcept{
		CAUTO					cerange=OFWBOOL((cui8ix<stcui8nWidth)&&(cui8iy<stcui8nHeight));
		CAUTO					ceup1=(cerange&&(cui8ilayer<stcui8nLayer-1))?(stui16cGetTile(cui8ix,cui8iy,cui8ilayer+1)!=0):FALSE;
		CAUTO					ceup2=(cerange&&(cui8ilayer<stcui8nLayer-2))?(stui16cGetTile(cui8ix,cui8iy,cui8ilayer+2)!=0):FALSE;

		if(!ceup2){
			CAUTO					cex0=OFWBOOL(cui8ix<stcui8nWidth);
			CAUTO					cex1=OFWBOOL((1<=cui8ix)&&(cui8ix<stcui8nWidth+1));
			CAUTO					cey0=OFWBOOL(cui8iy<stcui8nHeight);
			CAUTO					cey1=OFWBOOL((1<=cui8iy)&&(cui8iy<stcui8nHeight+1));
			CAUTO					cex0y0=OFWBOOL(cex0&&cey0);
			CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
			CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
			CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
			CAUTO					cui16cx0y1=cex0y1?stui16cGetTile(cui8ix+0,cui8iy-1,cui8ilayer):UINT16(0x0000);
			CAUTO					cui16cx1y1=cex1y1?stui16cGetTile(cui8ix-1,cui8iy-1,cui8ilayer):UINT16(0x0000);
			CAUTO					cui16cx1y0=cex1y0?stui16cGetTile(cui8ix-1,cui8iy+0,cui8ilayer):UINT16(0x0000);

			//	側壁
			if(cui16cx1y1){
				OFF_stDraw_MarkUpdate();
				switch(cui16cx1y1&stcui16cTilePartMask){
				case stcui16cTilePartLU:
					//	状況的にあり得ない
					break;
				case stcui16cTilePartRU:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						{
							IMAGE_stcv2iSideR.i16iX(),
							IMAGE_stcv2iSideR.i16iY()+INT16(IMAGE_stcui8nUnitHeight)
						},{
							INT16(IMAGE_stcui8nPerspectiveWidth),
							INT16(IMAGE_stcui8nUnitHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						//	+-----------+--   + //
						//	|     |X1Y1 |X0Y1   //
						//	|           |       //
						//	|           |       //
						//	|           |       //
						//	|LU    RU   |LD   | //
						//	|--   +   --|------ //
						//	|           |\X0Y0  //	6	d
						//	|           | +---- //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|LD   |RD   | |     //	b	0
						//	+-----------+ |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideD,{
								INT16(IMAGE_stcui8nUnitWidth),
								INT16(IMAGE_stcui8nPerspectiveHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+-----------+X0Y1   //
						//	|     |X1Y1 |\      //
						//	|           | +     //
						//	|           | |     //
						//	|           | |     //
						//	|LU    RU   | |     //
						//	|--   +   --| |     //
						//	|           | |X0Y0 //	a	0
						//	|           | |     //
						//	|           | |     //	a	0
						//	|           | |     //
						//	|LD   |RD   | |     //	b	0
						//	+-----------+ |     //
					}
					break;
				case stcui16cTilePartLD:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						{
							IMAGE_stcv2iSideD.i16iX()+INT16(IMAGE_stcui8nUnitWidth),
							IMAGE_stcv2iSideD.i16iY()
						},{
							INT16(IMAGE_stcui8nUnitWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |LD   |RD   | //
						//	------+-----------+ //
						//	|     |X1Y0 |\X0Y0  //	4	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	+   --|--   +   --| //
						//	      |X1Y1       | //
						//	      |           | //
						//	      |           | //
						//	      |           | //
						//	|     |LD   |RD   | //
						//	------+-----------+ //
						//	       \X1Y0  X0Y0  //	d	e
						//	--------+---------- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
					break;
				case stcui16cTilePartRD:
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						IMAGE_stcv2iSideRD,{
							INT16(IMAGE_stcui8nPerspectiveWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx0y1){
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideD,{
								INT16(IMAGE_stcui8nUnitWidth),
								INT16(IMAGE_stcui8nPerspectiveHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						if(cui16cx1y0){
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|LD   |RD   |LD   | //
							//	+-----------+------ //
							//	|     |X1Y0 |\X0Y0  //	2	d
							//	|           | +---- //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|LU    RU   | |     //	a	0
							//	|--   +   --| |     //
							OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
								IMAGE_stcv2iSideR,{
									INT16(IMAGE_stcui8nPerspectiveWidth),
									INT16(IMAGE_stcui8nUnitHeight)
								}
							},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --|--   + //
							//	|           |X0Y1   //
							//	|           |       //
							//	|           |       //
							//	|           |       //
							//	|LD   |RD   |LD   | //
							//	+-----------+------ //
							//	 \     X1Y0  \X0Y0  //	5	d
							//	  +-----------+---- //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}else{
						if(cui16cx1y0){
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|LD   |RD   | |     //
							//	+-----------+ |     //
							//	|     |X1Y0 |\|X0Y0 //	3	0
							//	|           | +     //
							//	|           | |     //	9	0
							//	|           | |     //
							//	|LU    RU   | |     //	a	0
							//	|--   +   --| |     //
							OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
								IMAGE_stcv2iSideR,{
									INT16(IMAGE_stcui8nPerspectiveWidth),
									INT16(IMAGE_stcui8nUnitHeight)
								}
							},cv2idestination,IDBLEND::BackNega_SourceAlpha);
						}else{
							//	|--   +   --| |X0Y1 //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|           | |     //
							//	|LD   |RD   | |     //
							//	+-----------+ |     //
							//	 \           \|X0Y0 //	f	0
							//	  +-----------+     //
							//	                    //	0	0
							//	                    //
							//	                    //	0	0
							//	                    //
						}
					}
					break;
				}
			}else{
				if(cui16cx0y1){
					OFF_stDraw_MarkUpdate();
					OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
						IMAGE_stcv2iSideD,{
							INT16(IMAGE_stcui8nUnitWidth),
							INT16(IMAGE_stcui8nPerspectiveHeight)
						}
					},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					if(cui16cx1y0){
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |LD   | //
						//	+-----------+------ //
						//	|     |X1Y0 |\X0Y0  //	2	d
						//	|           | +---- //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	            +--   + //
						//	            |X0Y1   //
						//	            |       //
						//	            |       //
						//	            |       //
						//	            |LD   | //
						//	            +------ //
						//	        X1Y0 \X0Y0  //	c	d
						//	              +---- //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}else{
					if(cui16cx1y0){
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	+-----------+       //
						//	|     |X1Y0 |\X0Y0  //	8	0
						//	|           | +     //
						//	|           | |     //	9	0
						//	|           | |     //
						//	|LU    RU   | |     //	a	0
						//	|--   +   --| |     //	
						OFF_stDraw_MarkUpdate();
						OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
							IMAGE_stcv2iSideR,{
								INT16(IMAGE_stcui8nPerspectiveWidth),
								INT16(IMAGE_stcui8nUnitHeight)
							}
						},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					}else{
						//	             X0Y1   //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	                    //
						//	        X1Y0 X0Y0   //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
						//	                    //	0	0
						//	                    //
					}
				}
			}
		}
		if(!ceup1){
			if(
				CAUTO					cui16ctile=cerange?stui16cGetTile(cui8ix,cui8iy,cui8ilayer):UINT16(0x0000);
				cui16ctile
			){
				constexpr AUTO			cv2iselectedrd=IMAGE_stcv2iSelected+IMAGE_stcv2nUnit;
				CAUTO&					acui8ipattern=staacui8iPattern[(cui16ctile&0xff)-1];
				CAUTO					cv2isource=VECTOR2(INT16(acui8ipattern[0]),INT16(acui8ipattern[1]));
				CAUTO					cv2isourcerd=cv2isource+IMAGE_stcv2nUnit;
				CAUTO					ceselected=OFWBOOL(cui16ctile&stcui16cTileSelectedMask);

				//	表面
				switch(cui16ctile&stcui16cTilePartMask){
				case stcui16cTilePartLU:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isource.i16iX(),		cv2isource.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						IMAGE_stcv2iSelected.i16iX(),	IMAGE_stcv2iSelected.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case stcui16cTilePartRU:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isourcerd.i16iX(),	cv2isource.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						cv2iselectedrd.i16iX(),	IMAGE_stcv2iSelected.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case stcui16cTilePartLD:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isource.i16iX(),		cv2isourcerd.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						IMAGE_stcv2iSelected.i16iX(),	cv2iselectedrd.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				case stcui16cTilePartRD:
					OFF_stDraw_Layer_Positioned_Face(cv2idestination,{
						cv2isourcerd.i16iX(),	cv2isourcerd.i16iY()
					});
					OFF_stDraw_Layer_Positioned_Shadow(cv2idestination,cui8ix,cui8iy,cui8ilayer+1);
					if(ceselected)OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{{
						cv2iselectedrd.i16iX(),	cv2iselectedrd.i16iY()
					},IMAGE_stcv2nUnit},cv2idestination,IDBLEND::BackNega_SourceAlpha);
					break;
				}
			}else{
				//	最下段時、床面への影表示を行います。
				if(cui8ilayer==0)OFF_stDraw_Layer_Positioned_Shadow({
					INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nPerspectiveWidth)),
					INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nPerspectiveHeight))
				},cui8ix,cui8iy,0);
			}
		}
		return;
	}
	static VOID				OFF_stDraw_Layer_Positioned_Face(CVECTOR2& cv2idestination,CVECTOR2& cv2isource)noexcept{
		OFF_stDraw_MarkUpdate();
		if constexpr(FALSE){
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				cv2isource,IMAGE_stcv2nUnit
			},cv2idestination,IDBLEND::BackNega_SourceAlpha);
		}else{
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					cv2isource.i16iX(),
					cv2isource.i16iY()
				},{
					INT16(IMAGE_stcui8nUnitWidth),
					INT16(IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				cv2idestination.i16iX(),
				cv2idestination.i16iY()
			},IDBLEND::BackNega_SourceAlpha);
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					cv2isource.i16iX(),
					INT16(cv2isource.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
				},{
					INT16(IMAGE_stcui8nFaceAlphaWidth),
					INT16(IMAGE_stcui8nUnitHeight-IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				cv2idestination.i16iX(),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
			},IDBLEND::BackNega_SourceAlpha);
			OFF_stcvsOne.CopyRect(IMAGE_stccvsTile,{
				{
					INT16(cv2isource.i16iX()+INT16(IMAGE_stcui8nFaceAlphaWidth)),
					INT16(cv2isource.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
				},{
					INT16(IMAGE_stcui8nUnitWidth-IMAGE_stcui8nFaceAlphaWidth),
					INT16(IMAGE_stcui8nUnitHeight-IMAGE_stcui8nFaceAlphaHeight)
				}
			},{
				INT16(cv2idestination.i16iX()+INT16(IMAGE_stcui8nFaceAlphaWidth)),
				INT16(cv2idestination.i16iY()+INT16(IMAGE_stcui8nFaceAlphaHeight))
			});
		}
		return;
	}
	static VOID				OFF_stDraw_Layer_Positioned_Shadow(CVECTOR2& cv2idestination,CUINT8 cui8ix,CUINT8 cui8iy,CUINT8 cui8ilayer1)noexcept{
		//	<影>
		//	+--------0H-------1H
		//	|＼    0A|＼    1A|
		//	|  0C    |  1C    |
		//	|    ＼ 0D    ＼ 1D
		//	|0B    ＼|1B    ＼|
		//	0G---0E--0F---1E--1F
		//	|＼    2A|＼    3A|
		//	|  2C    |  3C    |
		//	|    ＼ 2D    ＼ 3D
		//	|2B    ＼|3B    ＼|
		//	2G---2E--2F---3E--3F
		//	|＼    4A|＼    5A|
		//	|  4C    |  5C    |
		//	|    ＼ 4D    ＼ 5D
		//	|4B    ＼|5B    ＼|
		//	4G---4E--4F---5E--5F
		//	処理単位は16x24ドット6分割の8ドット四方で、さらに直角三角形2分割して「斜め線の影」を表現する。
		//	「A～G」は「TRUE/FALSE」2値を取り、この組み合わせで表示すべき影形状を決定する。
		//	・A
		//		影を落とす「上方向」の牌有無で決定。
		//		ただし「上方向」の牌が単独の場合「FALSE」とし、BとCだけ「TRUE」とする。
		//		この扱いにより、「右上角が少し欠けている影」の判別が出来る。
		//	・B
		//		影を落とす「左方向」の牌有無で決定。
		//		ただし「左方向」の牌が単独の場合「FALSE」とし、AとCだけ「TRUE」とする。
		//		この扱いにより、「左下角が少し欠けている影」の判別が出来る。
		//	・C
		//		影を落とす「左上方向」の牌有無で決定。
		//	・D/E
		//		影を落とす「2段以上上」の牌有無で決定。
		//		「1段上」だけであれば縦/横輪郭は「ぼかし」になり、「2段以上上」にあれば塗りつぶしになる。
		//	・F/G/H
		//		牌のつなぎ目に発生する「微妙な影のへこみ」表現で使用。
		//		影を落とす牌の対応する頂点が「田の字」で言う隅以外、つまり「直線状の影」になるようであれば「TRUE」とする。
		//		「直線状の影」が「TRUE」なのは、OR結合で「直線状の影」が優先されるようにするため。
		CAUTO					cui8ix0=UINT8(cui8ix);
		CAUTO					cui8ix1=UINT8(cui8ix-1);
		CAUTO					cui8ix2=UINT8(cui8ix-2);
		CAUTO					cui8ix3=UINT8(cui8ix-3);
		CAUTO					cui8iy0=UINT8(cui8iy);
		CAUTO					cui8iy1=UINT8(cui8iy-1);
		CAUTO					cui8iy2=UINT8(cui8iy-2);
		CAUTO					cui8ilayer2=cui8ilayer1+1;
		CAUTO					cui8ilayer3=cui8ilayer1+2;
		CAUTO					cui8ilayer4=cui8ilayer1+3;
		CAUTO					cui8ilayer5=cui8ilayer1+4;
		CAUTO					cex0=OFWBOOL(cui8ix0<stcui8nWidth);
		CAUTO					cex1=OFWBOOL(cui8ix1<stcui8nWidth);
		CAUTO					cex2=OFWBOOL(cui8ix2<stcui8nWidth);
		CAUTO					cex3=OFWBOOL(cui8ix3<stcui8nWidth);
		CAUTO					cey0=OFWBOOL(cui8iy0<stcui8nHeight);
		CAUTO					cey1=OFWBOOL(cui8iy1<stcui8nHeight);
		CAUTO					cey2=OFWBOOL(cui8iy2<stcui8nHeight);
		CAUTO					cex1y0=OFWBOOL(cex1&&cey0);
		CAUTO					cex2y0=OFWBOOL(cex2&&cey0);
		CAUTO					cex0y1=OFWBOOL(cex0&&cey1);
		CAUTO					cex1y1=OFWBOOL(cex1&&cey1);
		CAUTO					cex2y1=OFWBOOL(cex2&&cey1);
		CAUTO					cex3y1=OFWBOOL(cex3&&cey1);
		CAUTO					cex1y2=OFWBOOL(cex1&&cey2);
		CAUTO					cex2y2=OFWBOOL(cex2&&cey2);
		CAUTO					cex3y2=OFWBOOL(cex3&&cey2);
		CAUTO					cel1=OFWBOOL(cui8ilayer1<stcui8nLayer);
		CAUTO					cel2=OFWBOOL(cui8ilayer2<stcui8nLayer);
		CAUTO					cel3=OFWBOOL(cui8ilayer3<stcui8nLayer);
		CAUTO					cel4=OFWBOOL(cui8ilayer4<stcui8nLayer);
		CAUTO					cel5=OFWBOOL(cui8ilayer5<stcui8nLayer);
		//	<X1Y0>    |  |  +               //
		//	|         |  |  |\              //
		//	|         |  |  | \             //
		//	+---------+  |  |  +----*----*  //
		//	 \         \ |  |  | * ** * **  //
		//	  \3        \|  |  |1 ＼|* ＼|  //
		//	   +---------+  |  1--1-1--*-*  //
		//	    \         \ |  | 1 #2 * **  //
		//	     \2        \|  |1 ＼|2 ＼|  //
		//	      +---------+  1--1-1--2-2  //
		//	       \         \ | 1 12 2 #3  //
		//	        \1        \|1 ＼|2 ＼|  //
		//	         +---------1--1-1--2-2  //
		CAUTO					cui16cx1y0l1=(cex1y0&&cel1)?stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer1):UINT16(0x0000);
		CAUTO					cui16cx1y0l2=(cex1y0&&cel2)?stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx1y0l3=(cex1y0&&cel3)?stui16cGetTile(cui8ix1,cui8iy0,cui8ilayer3):UINT16(0x0000);
		constexpr AUTO			cex1y0_0a=OFWBOOL(FALSE);
		CAUTO					cex1y0_0b=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_0c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_0d=OFWBOOL(FALSE);
		CAUTO					cex1y0_0e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_0f=OFWBOOL((cui16cx1y0l1&&((cui16cx1y0l1&stcui16cTilePartMask)!=stcui16cTilePartRU))||cui16cx1y0l2);
		CAUTO					cex1y0_0g=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_0h=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1a=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1b=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1d=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1e=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1f=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_1h=OFWBOOL(FALSE);
		CAUTO					cex1y0_2a=OFWBOOL(cui16cx1y0l1&&((cui16cx1y0l1&stcui16cTilePartMask)!=stcui16cTilePartRU));
		CAUTO					cex1y0_2b=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2c=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2d=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_2e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2f=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_2g=OFWBOOL(cui16cx1y0l1);
		constexpr AUTO			cex1y0_3a=OFWBOOL(FALSE);
		CAUTO					cex1y0_3b=OFWBOOL(cui16cx1y0l2);
		constexpr AUTO			cex1y0_3c=OFWBOOL(FALSE);
		constexpr AUTO			cex1y0_3d=OFWBOOL(FALSE);
		CAUTO					cex1y0_3e=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_3f=OFWBOOL((cui16cx1y0l2&&((cui16cx1y0l2&stcui16cTilePartMask)!=stcui16cTilePartRU))||cui16cx1y0l3);
		CAUTO					cex1y0_4a=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4b=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4c=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4d=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_4e=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4f=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_4g=OFWBOOL(cui16cx1y0l1);
		CAUTO					cex1y0_5a=OFWBOOL(cui16cx1y0l2&&((cui16cx1y0l2&stcui16cTilePartMask)!=stcui16cTilePartRU));
		CAUTO					cex1y0_5b=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5c=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5d=OFWBOOL(cui16cx1y0l3);
		CAUTO					cex1y0_5e=OFWBOOL(cui16cx1y0l2);
		CAUTO					cex1y0_5f=OFWBOOL(cui16cx1y0l2);
		//	<X2Y0>    |  |  +                           //
		//	|         |  |  |\                          //
		//	|         |  |  | \                         //
		//	+---------+  |  |  +         +----*----*    //
		//	 \         \ |  |  |＼       | * ** * **    //
		//	  \3        \|  |  |  ＼     |* ＼|* ＼|    //
		//	   +---------+  |  |    \    *--*-*--*-*    //
		//	    \         \ |  |    |＼  | * ** * **    //
		//	     \2        \|  |    |  ＼|* ＼|* ＼|    //
		//	      +---------+  |    |    3--*-*--*-*    //
		//	       \         \ |    |    | * ** * **    //
		//	        \1        \|    |    |3 ＼|* ＼|    //
		//	         +---------+(1)-|(2)-3--3-3--*-*    //
		CAUTO					cui16cx2y0l2=(cex2y0&&cel2)?stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx2y0l3=(cex2y0&&cel3)?stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer3):UINT16(0x0000);
		CAUTO					cui16cx2y0l4=(cex2y0&&cel4)?stui16cGetTile(cui8ix2,cui8iy0,cui8ilayer4):UINT16(0x0000);
		constexpr AUTO			cex2y0_0a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0g=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_0h=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_1h=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_2f=OFWBOOL(FALSE);
		CAUTO					cex2y0_2g=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_3a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_3f=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_4a=OFWBOOL(FALSE);
		CAUTO					cex2y0_4b=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_4c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_4d=OFWBOOL(FALSE);
		CAUTO					cex2y0_4e=OFWBOOL(cui16cx2y0l3);
		CAUTO					cex2y0_4f=OFWBOOL((cui16cx2y0l3&&((cui16cx2y0l3&stcui16cTilePartMask)!=stcui16cTilePartRU))||cui16cx2y0l4);
		CAUTO					cex2y0_4g=OFWBOOL(cui16cx2y0l3);
		constexpr AUTO			cex2y0_5a=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5b=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5c=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5d=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5e=OFWBOOL(FALSE);
		constexpr AUTO			cex2y0_5f=OFWBOOL(FALSE);
		//	<X0Y1>    |  |  +   //
		//	|         |  |  |   //
		//	|         |  |  |   //
		//	+---------+  |  |   //
		//	 \         \ |  |   //
		//	  \2        \|  |   //
		//	   +---------+  |   //
		//	    \         \ |   //
		//	     \1        \|   //
		//	      +----1----1   //
		//	      | * 11 1 11   //
		//	      |* ＼|# ＼|   //
		//	      *--*-1--2-1   //
		//	      | * ** * 22   //
		//	      |* ＼|* ＼|   //
		//	      *--*-*--*-2   //
		//	      | * ** * **   //
		//	      |* ＼|* ＼|   //
		//	      *--*-*--*-*   //
		CAUTO					cui16cx0y1l1=(cex0y1&&cel1)?stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer1):UINT16(0x0000);
		CAUTO					cui16cx0y1l2=(cex0y1&&cel2)?stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer2):UINT16(0x0000);
		CAUTO					cui16cx0y1l3=(cex0y1&&cel3)?stui16cGetTile(cui8ix0,cui8iy1,cui8ilayer3):UINT16(0x0000);
		CAUTO					cex0y1_0a=OFWBOOL(cui16cx0y1l1);
		constexpr AUTO			cex0y1_0b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_0c=OFWBOOL(FALSE);
		CAUTO					cex0y1_0d=OFWBOOL(cui16cx0y1l1);
		constexpr AUTO			cex0y1_0e=OFWBOOL(FALSE);
		CAUTO					cex0y1_0f=OFWBOOL((cui16cx0y1l1&&((cui16cx0y1l1&stcui16cTilePartMask)!=stcui16cTilePartLD))||cui16cx0y1l2);
		constexpr AUTO			cex0y1_0g=OFWBOOL(FALSE);
		CAUTO					cex0y1_0h=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1a=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1b=OFWBOOL(cui16cx0y1l1&&((cui16cx0y1l1&stcui16cTilePartMask)!=stcui16cTilePartLD));
		CAUTO					cex0y1_1c=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1d=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1e=OFWBOOL(cui16cx0y1l2);
		CAUTO					cex0y1_1f=OFWBOOL(cui16cx0y1l1);
		CAUTO					cex0y1_1h=OFWBOOL(cui16cx0y1l1);
		constexpr AUTO			cex0y1_2a=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2c=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2d=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2e=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2f=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_2g=OFWBOOL(FALSE);
		CAUTO					cex0y1_3a=OFWBOOL(cui16cx0y1l2);
		constexpr AUTO			cex0y1_3b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_3c=OFWBOOL(FALSE);
		CAUTO					cex0y1_3d=OFWBOOL(cui16cx0y1l2);
		constexpr AUTO			cex0y1_3e=OFWBOOL(FALSE);
		CAUTO					cex0y1_3f=OFWBOOL((cui16cx0y1l2&&((cui16cx0y1l2&stcui16cTilePartMask)!=stcui16cTilePartLD))||cui16cx0y1l3);
		constexpr AUTO			cex0y1_4a=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4c=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4d=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4e=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4f=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_4g=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5a=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5b=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5c=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5d=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5e=OFWBOOL(FALSE);
		constexpr AUTO			cex0y1_5f=OFWBOOL(FALSE);
		//	<X1Y1>-+  |  |  +           //
		//	        \ |  |  |＼         //
		//	3        \|  |  |  ＼       //
		//	+---------+  |  |    \      //
		//	 \         \ |  |    |＼    //
		//	  \2        \|  |    |  ＼  //
		//	   +---------+  |    |    \ //
		//	    \         \ |    |    | //
		//	     \1        \|(1) |(2) | //
		//	      +---------+----1----2 //
		//	       ＼       | 1 12 2 23 //
		//	         ＼(1)  |1 ＼|2 ＼| //
		//	           \----1--2-1--2-2 //
		//	            ＼  | 2 22 2 23 //
		//	              ＼|# ＼|2 ＼| //
		//	                2--3-2--3-2 //
		//	                | * 33 3 33 //
