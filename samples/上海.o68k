			DEBUG::stWrite(ce1b?"B":"_");
			DEBUG::stWrite(ce1c?"C":"_");
			DEBUG::stWrite(ce1d?"D":"_");
			DEBUG::stWrite(ce1e?"E":"_");
			DEBUG::stWrite(ce1f?"F":"_");
			DEBUG::stWrite(ce0f?"G":"_");
			DEBUG::stWrite(ce1h?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d1>>3));
			DEBUG::stWrite(" 2:");
			DEBUG::stWrite(ce2a?"A":"_");
			DEBUG::stWrite(ce2b?"B":"_");
			DEBUG::stWrite(ce2c?"C":"_");
			DEBUG::stWrite(ce2d?"D":"_");
			DEBUG::stWrite(ce2e?"E":"_");
			DEBUG::stWrite(ce2f?"F":"_");
			DEBUG::stWrite(ce2g?"G":"_");
			DEBUG::stWrite(ce0f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d2>>3));
			DEBUG::stWrite(" 3:");
			DEBUG::stWrite(ce3a?"A":"_");
			DEBUG::stWrite(ce3b?"B":"_");
			DEBUG::stWrite(ce3c?"C":"_");
			DEBUG::stWrite(ce3d?"D":"_");
			DEBUG::stWrite(ce3e?"E":"_");
			DEBUG::stWrite(ce3f?"F":"_");
			DEBUG::stWrite(ce2f?"G":"_");
			DEBUG::stWrite(ce1f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d3>>3));
			DEBUG::stWrite(" 4:");
			DEBUG::stWrite(ce4a?"A":"_");
			DEBUG::stWrite(ce4b?"B":"_");
			DEBUG::stWrite(ce4c?"C":"_");
			DEBUG::stWrite(ce4d?"D":"_");
			DEBUG::stWrite(ce4e?"E":"_");
			DEBUG::stWrite(ce4f?"F":"_");
			DEBUG::stWrite(ce4g?"G":"_");
			DEBUG::stWrite(ce2f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHex(UINT8(cui8d4>>3));
			DEBUG::stWrite(" 5:");
			DEBUG::stWrite(ce5a?"A":"_");
			DEBUG::stWrite(ce5b?"B":"_");
			DEBUG::stWrite(ce5c?"C":"_");
			DEBUG::stWrite(ce5d?"D":"_");
			DEBUG::stWrite(ce5e?"E":"_");
			DEBUG::stWrite(ce5f?"F":"_");
			DEBUG::stWrite(ce4f?"G":"_");
			DEBUG::stWrite(ce3f?"H":"_");
			DEBUG::stWrite("=");DEBUG::stWriteHexLine(UINT8(cui8d5>>3));
#endif
		}
		return;
	}
	static constexpr UINT8	OFF_stui8dDraw_Layer_Positioned_Shadow_GetOffset(COFWBOOL cea,COFWBOOL ceb,COFWBOOL cec,COFWBOOL ced,COFWBOOL cee,COFWBOOL cef,COFWBOOL ceg,COFWBOOL ceh)noexcept{
		//	A～H場所
		//	+--------H
		//	|＼     A|
		//	|  C     | 
		//	|    ＼  D 
		//	|B     ＼|
		//	G----E---F
		//	パーツ割
		//	     x0   x1   x2   x3
		//	    +----+----+----+----+
		//	  0x|    |■■|■■|■■|
		//	    |    |＼■|＼__|____|
		//	    +----+----+----+----+
		//	  1x|■＼|  ＼|  ＼|■ ||
		//	    |■■|＼  |    |■ /|
		//	    +----+----+----+----+
		//	  2x|■＼|    |■■|■ \|
		//	    |■ ||＼  |■■|■ ||
		//	    +----+----+----+----+
		//	  3x|■ ||■■|■■|■ ||
		//	    |■ ||___/|\___|__／|
		//	    +----+----+----+----+
		//	  4x|■■|    |    |    |
		//	    |■／|    |    |    |
		//	    +----+----+----+----+
		constexpr UINT8			acui8idoffset[]={
		//	ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH ABCDEFGH
		//	<表示対象無し>
		//	________ _______H ______G_ ______GH _____F__ _____F_H _____FG_ _____FGH ____E___ ____E__H ____E_G_ ____E_GH ____EF__ ____EF_H ____EFG_ ____EFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	___D____ ___D___H ___D__G_ ___D__GH ___D_F__ ___D_F_H ___D_FG_ ___D_FGH ___DE___ ___DE__H ___DE_G_ ___DE_GH ___DEF__ ___DEF_H ___DEFG_ ___DEFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	__C_____ __C____H __C___G_ __C___GH __C__F__ __C__F_H __C__FG_ __C__FGH __C_E___ __C_E__H __C_E_G_ __C_E_GH __C_EF__ __C_EF_H __C_EFG_ __C_EFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	<表示対象無し>
		//	__CD____ __CD___H __CD__G_ __CD__GH __CD_F__ __CD_F_H __CD_FG_ __CD_FGH __CDE___ __CDE__H __CDE_G_ __CDE_GH __CDEF__ __CDEF_H __CDEFG_ __CDEFGH
			0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3, 0x00<<3,
		//	_B______ _B_____H _B____G_ _B____GH _B___F__ _B___F_H _B___FG_ _B___FGH _B__E___ _B__E__H _B__E_G_ _B__E_GH _B__EF__ _B__EF_H _B__EFG_ _B__EFGH
			0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3,
		//	_B_D____ _B_D___H _B_D__G_ _B_D__GH _B_D_F__ _B_D_F_H _B_D_FG_ _B_D_FGH _B_DE___ _B_DE__H _B_DE_G_ _B_DE_GH _B_DEF__ _B_DEF_H _B_DEFG_ _B_DEFGH
			0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3, 0x09<<3,
		//	_BC_____ _BC____H _BC___G_ _BC___GH _BC__F__ _BC__F_H _BC__FG_ _BC__FGH _BC_E___ _BC_E__H _BC_E_G_ _BC_E_GH _BC_EF__ _BC_EF_H _BC_EFG_ _BC_EFGH
			0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3, 0x08<<3,
		//	_BCD____ _BCD___H _BCD__G_ _BCD__GH _BCD_F__ _BCD_F_H _BCD_FG_ _BCD_FGH _BCDE___ _BCDE__H _BCDE_G_ _BCDE_GH _BCDEF__ _BCDEF_H _BCDEFG_ _BCDEFGH
			0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3, 0x04<<3,
		//	A_______ A______H A_____G_ A_____GH A____F__ A____F_H A____FG_ A____FGH A___E___ A___E__H A___E_G_ A___E_GH A___EF__ A___EF_H A___EFG_ A___EFGH
			0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3,
		//	A__D____ A__D___H A__D__G_ A__D__GH A__D_F__ A__D_F_H A__D_FG_ A__D_FGH A__DE___ A__DE__H A__DE_G_ A__DE_GH A__DEF__ A__DEF_H A__DEFG_ A__DEFGH
			0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3, 0x06<<3,
		//	A_C_____ A_C____H A_C___G_ A_C___GH A_C__F__ A_C__F_H A_C__FG_ A_C__FGH A_C_E___ A_C_E__H A_C_E_G_ A_C_E_GH A_C_EF__ A_C_EF_H A_C_EFG_ A_C_EFGH
			0x02<<3, 0x02<<3, 0x03<<3, 0x03<<3, 0x02<<3, 0x02<<3, 0x03<<3, 0x03<<3, 0x0c<<3, 0x07<<3, 0x0c<<3, 0x07<<3, 0x0b<<3, 0x0b<<3, 0x0b<<3, 0x0c<<3,
		//	A_CD____ A_CD___H A_CD__G_ A_CD__GH A_CD_F__ A_CD_F_H A_CD_FG_ A_CD_FGH A_CDE___ A_CDE__H A_CDE_G_ A_CDE_GH A_CDEF__ A_CDEF_H A_CDEFG_ A_CDEFGH
			0x02<<3, 0x02<<3, 0x0d<<3, 0x0d<<3, 0x0e<<3, 0x0e<<3, 0x03<<3, 0x03<<3, 0x01<<3, 0x01<<3, 0x0a<<3, 0x0a<<3, 0x01<<3, 0x01<<3, 0x01<<3, 0x01<<3,
		//	AB______ AB_____H AB____G_ AB____GH AB___F__ AB___F_H AB___FG_ AB___FGH AB__E___ AB__E__H AB__E_G_ AB__E_GH AB__EF__ AB__EF_H AB__EFG_ AB__EFGH
			0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3,
		//	AB_D____ AB_D___H AB_D__G_ AB_D__GH AB_D_F__ AB_D_F_H AB_D_FG_ AB_D_FGH AB_DE___ AB_DE__H AB_DE_G_ AB_DE_GH AB_DEF__ AB_DEF_H AB_DEFG_ AB_DEFGH
			0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3, 0x05<<3,
		//	ABC_____ ABC____H ABC___G_ ABC___GH ABC__F__ ABC__F_H ABC__FG_ ABC__FGH ABC_E___ ABC_E__H ABC_E_G_ ABC_E_GH ABC_EF__ ABC_EF_H ABC_EFG_ ABC_EFGH
			0x0f<<3, 0x07<<3, 0x0d<<3, 0x0f<<3, 0x0f<<3, 0x0c<<3, 0x03<<3, 0x0c<<3, 0x0c<<3, 0x07<<3, 0x0c<<3, 0x07<<3, 0x0b<<3, 0x0c<<3, 0x0b<<3, 0x0c<<3,
		//	ABCD____ ABCD___H ABCD__G_ ABCD__GH ABCD_F__ ABCD_F_H ABCD_FG_ ABCD_FGH ABCDE___ ABCDE__H ABCDE_G_ ABCDE_GH ABCDEF__ ABCDEF_H ABCDEFG_ ABCDEFGH
			0x03<<3, 0x03<<3, 0x0d<<3, 0x0d<<3, 0x0e<<3, 0x0e<<3, 0x03<<3, 0x03<<3, 0x10<<3, 0x10<<3, 0x10<<3, 0x10<<3, 0x0a<<3, 0x0a<<3, 0x0a<<3, 0x0a<<3
		};

		return acui8idoffset[
			+(cea?0x80:0x00)
			+(ceb?0x40:0x00)
			+(cec?0x20:0x00)
			+(ced?0x10:0x00)
			+(cee?0x08:0x00)
			+(cef?0x04:0x00)
			+(ceg?0x02:0x00)
			+(ceh?0x01:0x00)
		];
	}
};

//
//		クラス:MENU
//

class MENU{
public:

	//
	//		定数
	//

	class _IDTYPE{
	public:
		enum BODY:UINT8{
			Disabled=0,
			Normal,
			NormalSelected,
			Caution,
			CautionSelected,
			stcui8nThis
		};
	};
	using					IDTYPE=_IDTYPE::BODY;
	static constexpr AUTO	TYPE_stcui8nThis=UINT8(IDTYPE::stcui8nThis);
	class _IDCOLOR{
	public:
		enum BODY:UINT8{
			Face=0,
			Edge,
			Text,
			stcui8nThis
		};
	};
	using					IDCOLOR=_IDCOLOR::BODY;
	static constexpr AUTO	COLOR_stcui8nThis=UINT8(IDCOLOR::stcui8nThis);
	static constexpr UINT16	staacui16cColor[UINT8(IDTYPE::stcui8nThis)][UINT8(IDCOLOR::stcui8nThis)]={
		//	Face	Edge	Text
		{	0xf222,	0xf666,	0xf888},	//	IDTYPE::Disabled
		{	0xf644,	0xffee,	0xffff},	//	IDTYPE::Normal
		{	0xf200,	0xf644,	0xf866},	//	IDTYPE::NormalSelected
		{	0xf446,	0xfeef,	0xffff},	//	IDTYPE::Caution
		{	0xf002,	0xf446,	0xf668}		//	IDTYPE::CautionSelected
	};
	class _IDCOMMAND{
	public:
		enum BODY:UINT8{
			None=0,
			Retry,
			LayoutDec,
			LayoutInc,
			NumberDec,
			NumberInc,
			DifficultyDec,
			DifficultyInc
		};
	};
	using					IDCOMMAND=_IDCOMMAND::BODY;
	static constexpr UINT8	stcui8nScreenBit=4;
	static constexpr AUTO	stcv2nArea=VECTOR2(
		GRAPHIC::stcv2nScreen.i16nWidth()>>stcui8nScreenBit,
		4
	);
	static constexpr AUTO	stcv2nOne=VECTOR2(8,1);
	static constexpr AUTO	stcv2nOne_Screen=stcv2nOne<<stcui8nScreenBit;
	static constexpr AUTO	stcv2iRetry=VECTOR2(32,1);
	static constexpr AUTO	stcv2iLayout=VECTOR2(0,1);
	static constexpr AUTO	stcv2iNumber=VECTOR2(8,1);
	static constexpr AUTO	stcv2iDifficulty=VECTOR2(16,1);
	static constexpr AUTO	stcv2iRest=VECTOR2(32,0);
	static constexpr UINT8	stcui8iLayoutMaximum=GAME::stcui8nLayout-1;
	static constexpr UINT16	stcui16iNumberMaximum=999;
	static constexpr UINT8	stcui8nDifficultyMaximum=9;
	static constexpr AUTO	SCREEN_stcv2nArea=stcv2nArea<<stcui8nScreenBit;
	static constexpr AUTO	SCREEN_stcshpGame=GRAPHIC::SHAPE(
		{
			0,SCREEN_stcv2nArea.i16nHeight()
		},{
			GRAPHIC::stcv2nScreen.i16nWidth(),
			GRAPHIC::stcv2nScreen.i16nHeight()-SCREEN_stcv2nArea.i16nHeight()
		}
	);

	//
	//		型
	//

	//	CANVAS_MENU
	using					CANVAS_MENU=CANVAS_RGB_RAM<UINT16(stcv2nOne_Screen.i16nWidth()),UINT16(stcv2nOne_Screen.i16nHeight())>;
	using					CCANVAS_MENU=const CANVAS_MENU;
	using					PCANVAS_MENU=CANVAS_MENU*;
	using					PCCANVAS_MENU=CCANVAS_MENU*;

	//
	//		定義本体:MENU
	//

private:
	static inline UINT8		stui8iLayout;
	static inline UINT16	stui16iNumber;
	static inline UINT8		stui8nDifficulty;
	static inline IDCOMMAND	COMMAND_staidCommand[stcv2nArea.i16nWidth()*stcv2nArea.i16nHeight()];
	static inline CANVAS_MENU	OFF_stcvsRetry,OFF_stcvsRetrySelected;
	static inline CANVAS_MENU	OFF_stcvsLayout,OFF_stcvsLayoutSelected;
	static inline CANVAS_MENU	OFF_stcvsNumber,OFF_stcvsNumberSelected;
	static inline CANVAS_MENU	OFF_stcvsDifficulty,OFF_stcvsDifficultySelected;
	static inline CANVAS_MENU	OFF_stcvsRest;
public:
	static VOID				stNew(VOID)noexcept{
		stui8iLayout=0;
		stui16iNumber=0;
		stui8nDifficulty=0;
		for(AUTO& idcommand:COMMAND_staidCommand)idcommand=IDCOMMAND::None;
		COMMAND_stSet(IDCOMMAND::Retry,stcv2iRetry);
		COMMAND_stSet(IDCOMMAND::LayoutDec,stcv2iLayout,TRUE);
		COMMAND_stSet(IDCOMMAND::NumberDec,stcv2iNumber,TRUE);
		COMMAND_stSet(IDCOMMAND::DifficultyDec,stcv2iDifficulty,TRUE);
		return;
	}
	static VOID				stDelete(VOID)noexcept{
		return;
	}
	static IDCOMMAND		COMMAND_stidGetCommandbyScreenPosition(VECTOR2& v2iposition,CVECTOR2& cv2iposition_screen)noexcept{
		v2iposition=cv2iposition_screen>>stcui8nScreenBit;
		if(
			CAUTO					cui8iposition=COMMAND_stui8iGetPosition(v2iposition);
			cui8iposition<SIZEOF(COMMAND_staidCommand)
		)if(
			CAUTO					cidcommand=COMMAND_staidCommand[cui8iposition];
			cidcommand!=IDCOMMAND::None
		){
			v2iposition.i16iX()&=~7;
			return cidcommand;
		}
		return IDCOMMAND::None;
	}
	static VOID				COMMAND_stExecute(const IDCOMMAND cidcommand)noexcept{
		GAME::MOUSE_stSetBusy(TRUE);
		switch(cidcommand){
		case IDCOMMAND::Retry:
			SCREEN_stDrawOne(OFF_stcvsRetrySelected,stcv2iRetry);
			GAME::SCREEN_stClear({
				{
					0,
					SCREEN_stcv2nArea.i16nHeight()
				},GRAPHIC::stcv2nScreen
			});
			GAME::SCREEN_stClear({stcv2iRest<<stcui8nScreenBit,stcv2nOne_Screen});
			GAME::stInitialize(
				stui8iLayout,			//	cui8ilayout
				UINT32(0x01234567+(UINT32(stui16iNumber)<<16)+(UINT32(stui8iLayout)<<8)),	//	cui32cseed
				stui8nDifficulty*8		//	cui8ndifficulty
			);
			SCREEN_stDrawOne_Retry();
			SCREEN_stDrawOne_Rest();
			break;
		case IDCOMMAND::LayoutDec:
			SCREEN_stDrawOne(OFF_stcvsLayoutSelected,stcv2iLayout);
			if(0<stui8iLayout)--stui8iLayout;
			SCREEN_stDrawOne_Layout();
			break;
		case IDCOMMAND::LayoutInc:
			SCREEN_stDrawOne(OFF_stcvsLayoutSelected,stcv2iLayout);
			if(stui8iLayout<stcui8iLayoutMaximum)++stui8iLayout;
			SCREEN_stDrawOne_Layout();
			break;
		case IDCOMMAND::NumberDec:
			SCREEN_stDrawOne(OFF_stcvsNumberSelected,stcv2iNumber);
			if(0<stui16iNumber)--stui16iNumber;
			SCREEN_stDrawOne_Number();
			break;
		case IDCOMMAND::NumberInc:
			SCREEN_stDrawOne(OFF_stcvsNumberSelected,stcv2iNumber);
			if(stui16iNumber<stcui16iNumberMaximum)++stui16iNumber;
			SCREEN_stDrawOne_Number();
			break;
		case IDCOMMAND::DifficultyDec:
			SCREEN_stDrawOne(OFF_stcvsDifficultySelected,stcv2iDifficulty);
			if(0<stui8nDifficulty)--stui8nDifficulty;
			SCREEN_stDrawOne_Difficulty();
			break;
		case IDCOMMAND::DifficultyInc:
			SCREEN_stDrawOne(OFF_stcvsDifficultySelected,stcv2iDifficulty);
			if(stui8nDifficulty<stcui8nDifficultyMaximum)++stui8nDifficulty;
			SCREEN_stDrawOne_Difficulty();
			break;
		default:
			break;
		}
		GAME::MOUSE_stSetBusy(FALSE);
		return;
	}
	static VOID				SCREEN_stDraw(VOID)noexcept{
		SCREEN_stDrawString("配置型",{stcv2iLayout.i16iX(),0},0xffff);
		SCREEN_stDrawString("配置番号",{stcv2iNumber.i16iX(),0},0xffff);
		SCREEN_stDrawString("難易度",{stcv2iDifficulty.i16iX(),0},0xffff);
		SCREEN_stDrawOne_Retry(TRUE);
		SCREEN_stDrawOne_Layout();
		SCREEN_stDrawOne_Number();
		SCREEN_stDrawOne_Difficulty();
		SCREEN_stDrawOne_Rest();
		return;
	}
	static VOID				SCREEN_stDrawOne_Rest(VOID)noexcept{
		OFF_stDrawOne_Rest();
		SCREEN_stDrawOne(OFF_stcvsRest,stcv2iRest);
		return;
	}
private:
	static constexpr UINT8	COMMAND_stui8iGetPosition(CVECTOR2& cv2iposition)noexcept{
		return (cv2iposition.i16iY()<SIZEOF(COMMAND_staidCommand)/stcv2nArea.i16nWidth())?(
			UINT8(cv2iposition.i16iY()*stcv2nArea.i16nWidth()+cv2iposition.i16iX())
		):(
			SIZEOF(COMMAND_staidCommand)
		);
	}
	static VOID				COMMAND_stSet(const IDCOMMAND cidcommand,CVECTOR2& cv2iposition,COFWBOOL ceupdown=FALSE)noexcept{
		CAUTO					cui8iposition=COMMAND_stui8iGetPosition(cv2iposition);
		CAUTO					cidcommand_right=ceupdown?IDCOMMAND(UINT8(cidcommand)+1):cidcommand;

		COMMAND_staidCommand[cui8iposition+0]=cidcommand;
		COMMAND_staidCommand[cui8iposition+1]=cidcommand;
		COMMAND_staidCommand[cui8iposition+2]=cidcommand;
		COMMAND_staidCommand[cui8iposition+3]=cidcommand;
		COMMAND_staidCommand[cui8iposition+4]=cidcommand_right;
		COMMAND_staidCommand[cui8iposition+5]=cidcommand_right;
		COMMAND_staidCommand[cui8iposition+6]=cidcommand_right;
		COMMAND_staidCommand[cui8iposition+7]=cidcommand_right;
		return;
	}
	static _INLINE_ VOID	SCREEN_stDrawOne(CCANVAS_MENU& ccvsthis,CVECTOR2& cv2iposition)noexcept{
		GRAPHIC::stCopy(ccvsthis,cv2iposition<<stcui8nScreenBit);
		return;
	}
	static VOID				SCREEN_stDrawString(const PCUSTR cpcustrtext,CVECTOR2& cv2iposition,CUINT16 cui16ccolor)noexcept{
		CAUTO					ci16nlength_screen=INT16(COMMON::stui8nGetLength(cpcustrtext)<<3);
		CAUTO					ci16ioffset=INT16((stcv2nOne_Screen.i16nWidth()-ci16nlength_screen)>>1);
		CAUTO					cv2iposition_screen=cv2iposition<<stcui8nScreenBit;

		GRAPHIC::stDrawString(cpcustrtext,cui16ccolor,{INT16(cv2iposition_screen.i16iX()+ci16ioffset),cv2iposition_screen.i16iY()});
		return;
	}
	static VOID				SCREEN_stDrawOne_Retry(COFWBOOL cefirst=FALSE)noexcept{
		OFF_stDrawOne_Retry(cefirst);
		SCREEN_stDrawOne(OFF_stcvsRetry,stcv2iRetry);
		return;
	}
	static VOID				SCREEN_stDrawOne_Layout(VOID)noexcept{
		OFF_stDrawOne_Layout();
		SCREEN_stDrawOne(OFF_stcvsLayout,stcv2iLayout);
		return;
	}
	static VOID				SCREEN_stDrawOne_Number(VOID)noexcept{
		OFF_stDrawOne_Number();
		SCREEN_stDrawOne(OFF_stcvsNumber,stcv2iNumber);
		return;
	}
	static VOID				SCREEN_stDrawOne_Difficulty(VOID)noexcept{
		OFF_stDrawOne_Difficulty();
		SCREEN_stDrawOne(OFF_stcvsDifficulty,stcv2iDifficulty);
		return;
	}
	static VOID				OFF_stDrawOne(CANVAS_MENU& cvsthis,const IDTYPE cidtype,const PCUSTR cpcustrtext,COFWBOOL ceup,COFWBOOL cedown)noexcept{
		CAUTO&					acui16ccolor=staacui16cColor[UINT8(cidtype)];

		cvsthis.FillRect(acui16ccolor[UINT8(IDCOLOR::Edge)],{VECTOR2::stv2ImmediateZero(),stcv2nOne_Screen});
		cvsthis.FillRect(acui16ccolor[UINT8(IDCOLOR::Face)],{VECTOR2(1,1),stcv2nOne_Screen+VECTOR2(-2,-2)});
		OFF_stDrawString(cvsthis,cpcustrtext,acui16ccolor[UINT8(IDCOLOR::Text)]);
		if(ceup)cvsthis.DrawString("＋",acui16ccolor[UINT8(IDCOLOR::Text)],{stcv2nOne_Screen.i16nWidth()-16,0});
		if(cedown)cvsthis.DrawString("－",acui16ccolor[UINT8(IDCOLOR::Text)],VECTOR2::stv2ImmediateZero());
		return;
	}
	static VOID				OFF_stDrawString(CANVAS_MENU& cvsthis,const PCUSTR cpcustrtext,CUINT16 cui16ccolor)noexcept{
		CAUTO					ci16nlength_screen=INT16(COMMON::stui8nGetLength(cpcustrtext)<<3);
		CAUTO					ci16ioffset=INT16((stcv2nOne_Screen.i16nWidth()-ci16nlength_screen)>>1);

		cvsthis.DrawString(cpcustrtext,cui16ccolor,{ci16ioffset,0});
		return;
	}
	static VOID				OFF_stDrawOne_Retry(COFWBOOL cefirst)noexcept{
		if(cefirst){
			OFF_stDrawOne(OFF_stcvsRetry,IDTYPE::Normal,"開始",FALSE,FALSE);
			OFF_stDrawOne(OFF_stcvsRetrySelected,IDTYPE::NormalSelected,"開始",FALSE,FALSE);
		}else{
			OFF_stDrawOne(OFF_stcvsRetry,IDTYPE::Caution,"やり直し",FALSE,FALSE);
			OFF_stDrawOne(OFF_stcvsRetrySelected,IDTYPE::CautionSelected,"やり直し",FALSE,FALSE);
		}
		return;
	}
	static VOID				OFF_stDrawOne_Layout(VOID)noexcept{
		static constexpr PCUSTR	stapcustrname[GAME::stcui8nLayout]={
			"龍",
			"虎",
			"サソリ",
			"猿",
			"蛇",
			"豹"
		};
		CAUTO					ceup=OFWBOOL(stui8iLayout<stcui8iLayoutMaximum);
		CAUTO					cedown=OFWBOOL(0<stui8iLayout);

		OFF_stDrawOne(OFF_stcvsLayout,IDTYPE::Normal,stapcustrname[stui8iLayout],ceup,cedown);
		OFF_stDrawOne(OFF_stcvsLayoutSelected,IDTYPE::NormalSelected,stapcustrname[stui8iLayout],ceup,cedown);
		return;
	}
	static VOID				OFF_stDrawOne_Number(VOID)noexcept{
		USTR					austrthis[4];
		CAUTO					ceup=OFWBOOL(stui16iNumber<stcui16iNumberMaximum);
		CAUTO					cedown=OFWBOOL(0<stui16iNumber);

		COMMON::stWrite(austrthis,stui16iNumber);
		OFF_stDrawOne(OFF_stcvsNumber,IDTYPE::Normal,austrthis,ceup,cedown);
		OFF_stDrawOne(OFF_stcvsNumberSelected,IDTYPE::NormalSelected,austrthis,ceup,cedown);
		return;
	}
	static VOID				OFF_stDrawOne_Difficulty(VOID)noexcept{
		USTR					austrthis[2];
		CAUTO					ceup=OFWBOOL(stui8nDifficulty<stcui8nDifficultyMaximum);
		CAUTO					cedown=OFWBOOL(0<stui8nDifficulty);

		COMMON::stWrite(austrthis,UINT16(stui8nDifficulty));
		OFF_stDrawOne(OFF_stcvsDifficulty,IDTYPE::Normal,austrthis,ceup,cedown);
		OFF_stDrawOne(OFF_stcvsDifficultySelected,IDTYPE::NormalSelected,austrthis,ceup,cedown);
		return;
	}
	static VOID				OFF_stDrawOne_Rest(VOID)noexcept{
		USTR					austrthis[]="残り牌:   ";

		COMMON::stWrite(austrthis+7,UINT16(GAME::stui8nTileRest));
		GAME::OFF_stDrawBack(OFF_stcvsRest,stcv2iRest<<stcui8nScreenBit);
		OFF_stDrawString(OFF_stcvsRest,austrthis,0xffff);
		return;
	}
};

//
//		user
//

VOID					MARK_Erase(VOID)noexcept{
	GRAPHIC::SPRITE_stErase(1);
	GRAPHIC::SPRITE_stErase(2);
	GRAPHIC::SPRITE_stErase(3);
	GRAPHIC::SPRITE_stErase(4);
	return;
}

VOID					USER_New(VOID)noexcept{
	GAME::stNew();
	MENU::stNew();
	GAME::SCREEN_stClear();
	MENU::SCREEN_stDraw();
	GRAPHIC::stDrawString("上海",0xffff,{304,232});
	GRAPHIC::stDrawString("配置、難易度を選択して「開始」してください。",0xffff,{144,264});
	GRAPHIC::stDrawString("2026 Programmed by 整数71",0xffff,{220,280});
	GAME::MOUSE_stSetBusy(FALSE);
	return;
}

VOID					USER_Delete(VOID)noexcept{
	MENU::stDelete();
	GAME::stDelete();
	return;
}

VOID					USER_Main(VOID)noexcept{
	CAUTO					cstatmouse=GAME::MOUSE_ststatGetState();
	UINT8					ui8ix,ui8iy,ui8ilayer;

	if(
		CAUTO					cui8itile=UINT8(GAME::stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,cstatmouse.v2iCursor)&0xff);
		cui8itile
	){
		if(GAME::steIsProgressive()){
			CAUTO					cui8ix=ui8ix,cui8iy=ui8iy,cui8ilayer=ui8ilayer;
			CAUTO					ceselectable=GAME::steIsSelectable(cui8ix,cui8iy,cui8ilayer);

			//	カーソルは何らかの「牌」の上にある
			if(cstatmouse.ui16cButtonSingle&OS::MOUSE_stcui8cMaskButtonLeft){
				//	マウスボタン押下
				if(ceselectable){
					//	ゲット可能な牌を指している
					if(GAME::SELECT_eSelected){
						//	既に1つ選択している
						if(GAME::stui8iGetTileGroup(cui8itile)==GAME::stui8iGetTileGroup(GAME::SELECT_ui8iTile)){
							//	同一種の牌であった
							GAME::MOUSE_stSetBusy(TRUE);
							MARK_Erase();
							if(cui8itile!=GAME::SELECT_ui8iTile){
								//	かつ別牌であったので既存もろとも消し去る
								GAME::stSelectTile(cui8ix,cui8iy,cui8ilayer,TRUE);
								GAME::stWriteTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,0x00,TRUE);
								GAME::stWriteTile(cui8ix,cui8iy,cui8ilayer,0x00,TRUE);
								GAME::stui8nTileRest-=2;
								MENU::SCREEN_stDrawOne_Rest();
								if(GAME::stui8nTileRest){
									GAME::stCheckProgressive();
									if(!GAME::steIsProgressive()){
										constexpr AUTO			cv2nback=VECTOR2(160,120);
										constexpr AUTO			cv2nfore=VECTOR2(14*8,16);

										//	ゲームオーバー
										GRAPHIC::stFillRect(
											0xc000,{
												MENU::SCREEN_stcshpGame.v2iPosition+(MENU::SCREEN_stcshpGame.v2nSize-cv2nback)>>1,
												cv2nback
											},
											GRAPHIC::IDBLEND::BackNega_SourceAlpha
										);
										GRAPHIC::stDrawString(
											"ゲームオーバー",0xffff,{
												MENU::SCREEN_stcshpGame.v2iPosition+(MENU::SCREEN_stcshpGame.v2nSize-cv2nfore)>>1,
											}
										);
									}
								}else{
									//	天晴
#ifdef SHOWENDING
									GRAPHIC::stCopy(
										GAME::IMAGE_stccvsEnd,
										MENU::SCREEN_stcshpGame.v2iPosition+((MENU::SCREEN_stcshpGame.v2nSize-GAME::IMAGE_stccvsEnd.stcv2nSize)>>1),
										GRAPHIC::IDBLEND::BackNega_SourceAlpha
									);
#endif
								}
							}else{
								//	同一牌であったのでフリップフロップ的に選択解除
								GAME::stSelectTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,FALSE);
							}
							GAME::SELECT_eSelected=FALSE;
							GAME::MOUSE_stSetBusy(FALSE);
							return;
						}else{
							//	違う牌であったので選択し直す
							GAME::MOUSE_stSetBusy(TRUE);
							MARK_Erase();
							GAME::stSelectTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,FALSE);
							GAME::SELECT_ui8iTile=cui8itile;
							GAME::SELECT_ui8iX=cui8ix;
							GAME::SELECT_ui8iY=cui8iy;
							GAME::SELECT_ui8iLayer=cui8ilayer;
							GAME::stSelectTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,TRUE);
							GAME::MOUSE_stSetBusy(FALSE);
							return;
						}
					}else{
						//	1つ目の選択
						GAME::MOUSE_stSetBusy(TRUE);
						MARK_Erase();
						GAME::SELECT_eSelected=TRUE;
						GAME::SELECT_ui8iTile=cui8itile;
						GAME::SELECT_ui8iX=cui8ix;
						GAME::SELECT_ui8iY=cui8iy;
						GAME::SELECT_ui8iLayer=cui8ilayer;
						GAME::stSelectTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,TRUE);
						GAME::MOUSE_stSetBusy(FALSE);
						return;
					}
				}else{
					//	ゲット可能な牌ではない
					if(GAME::SELECT_eSelected){
						//	既に1つ目が選択されていたならキャンセル扱い
						GAME::MOUSE_stSetBusy(TRUE);
						MARK_Erase();
						GAME::SELECT_eSelected=FALSE;
						GAME::stSelectTile(GAME::SELECT_ui8iX,GAME::SELECT_ui8iY,GAME::SELECT_ui8iLayer,FALSE);
						GAME::MOUSE_stSetBusy(FALSE);
						return;
					}
				}
			}
			//	マーク表示
			{
				CAUTO					cv2iposition=GAME::SCREEN_stv2iGetPosition(ui8ix,ui8iy,ui8ilayer);
				CAUTO					cv2ipositionRD=cv2iposition+VECTOR2(
					GAME::IMAGE_stcui8nUnitWidth*2-1,
					GAME::IMAGE_stcui8nUnitHeight*2-1
				);
				CAUTO					cv2isprite=cv2iposition;
				CAUTO					cv2ispriteRD=VECTOR2(
					cv2ipositionRD.i16iX()-7,
					cv2ipositionRD.i16iY()-7
				);
				//	UINT8					cui8ipattern
				//		選択可能な牌を指しているかどうかで、マーク形状を変えてやります。
				CAUTO					cui8ipattern=ceselectable?UINT8(0x08):UINT8(0x09);

				if(GAME::stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
					cv2iposition.i16iX(),	cv2iposition.i16iY()
				})==cui8itile)GRAPHIC::SPRITE_stWrite8(1,{
					cv2iposition.i16iX(),	cv2iposition.i16iY()
				},cui8ipattern,0x1,FALSE,FALSE);
				else GRAPHIC::SPRITE_stErase(1);
				if(GAME::stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
					cv2ipositionRD.i16iX(),	cv2iposition.i16iY()
				})==cui8itile)GRAPHIC::SPRITE_stWrite8(2,{
					cv2ispriteRD.i16iX(),	cv2isprite.i16iY()
				},cui8ipattern,0x1,TRUE,FALSE);
				else GRAPHIC::SPRITE_stErase(2);
				if(GAME::stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
					cv2iposition.i16iX(),	cv2ipositionRD.i16iY()
				})==cui8itile)GRAPHIC::SPRITE_stWrite8(3,{
					cv2isprite.i16iX(),		cv2ispriteRD.i16iY()
				},cui8ipattern,0x1,FALSE,TRUE);
				else GRAPHIC::SPRITE_stErase(3);
				if(GAME::stui16cGetTilebyScreenPosition(ui8ix,ui8iy,ui8ilayer,{
					cv2ipositionRD.i16iX(),	cv2ipositionRD.i16iY()
				})==cui8itile)GRAPHIC::SPRITE_stWrite8(4,{
					cv2ispriteRD.i16iX(),	cv2ispriteRD.i16iY()
				},cui8ipattern,0x1,TRUE,TRUE);
				else GRAPHIC::SPRITE_stErase(4);
				return;
			}
		}
	}else{
		VECTOR2					v2icommand;

		//	カーソルは「牌」の上にはない
		if(
			CAUTO					cidcommand=MENU::COMMAND_stidGetCommandbyScreenPosition(v2icommand,cstatmouse.v2iCursor);
			cidcommand!=MENU::IDCOMMAND::None
		){
			//	カーソルはメニューの上にある
			if(cstatmouse.ui16cButtonSingle&OS::MOUSE_stcui8cMaskButtonLeft){
				//	マウスボタン押下
				MENU::COMMAND_stExecute(cidcommand);
			}else{
				CAUTO					cv2iposition=v2icommand<<MENU::stcui8nScreenBit;
				CAUTO					cv2ipositionRD=cv2iposition+MENU::stcv2nOne_Screen;
				CAUTO					cv2isprite=cv2iposition;
				CAUTO					cv2ispriteRD=VECTOR2(
					cv2ipositionRD.i16iX()-8,
					cv2ipositionRD.i16iY()-8
				);
				CAUTO					cui8ipattern=UINT8(0x08);

				GRAPHIC::SPRITE_stWrite8(1,{
					cv2iposition.i16iX(),	cv2iposition.i16iY()
				},cui8ipattern,0x1,FALSE,FALSE);
				GRAPHIC::SPRITE_stWrite8(2,{
					cv2ispriteRD.i16iX(),	cv2isprite.i16iY()
				},cui8ipattern,0x1,TRUE,FALSE);
				GRAPHIC::SPRITE_stWrite8(3,{
					cv2isprite.i16iX(),		cv2ispriteRD.i16iY()
				},cui8ipattern,0x1,FALSE,TRUE);
				GRAPHIC::SPRITE_stWrite8(4,{
					cv2ispriteRD.i16iX(),	cv2ispriteRD.i16iY()
				},cui8ipattern,0x1,TRUE,TRUE);
				return;
			}
		}
	}
	MARK_Erase();
	return;
}
